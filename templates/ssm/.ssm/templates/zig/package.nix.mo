{{! THIS WAS WRITTEN BY A CLANKER }}
{ lib, stdenvNoCC, callPackage, removeReferencesTo, zig_0_17, ... }: let
    zig = zig_0_17;
    # generated by ./do lock
    deps = callPackage ./build.zig.zon.nix {};
in stdenvNoCC.mkDerivation {
    pname = "{{subproject_name}}";
    version = "{{subproject_version}}";

    # local builds would clash
    src = lib.cleanSourceWith {
        src = ./.;
        filter = path: _: !(lib.elem (baseNameOf path) [ ".build" ".zig-cache" "zig-pkg" ]);
    };

    nativeBuildInputs = [
        zig.hook
        removeReferencesTo
    ];

    postConfigure = ''
        ln -s ${deps} "$ZIG_GLOBAL_CACHE_DIR/p"
    '';

    preBuild = ''
    '';

    buildPhase = ''
        runHook preBuild
        bash ./do build-release -Dcpu=baseline
        runHook postBuild
    '';

    installPhase = ''
        runHook preInstall
        mkdir -p "$out"
        cp -a .build/release/. "$out"
        runHook postInstall
    '';

    # debug info points into zig
    postFixup = ''
        find "$out" -type f -exec remove-references-to -t ${zig} {} +
    '';

    meta = {
        description = "";
        mainProgram = "{{subproject_name}}";
        platforms = lib.platforms.linux;
    };
}
