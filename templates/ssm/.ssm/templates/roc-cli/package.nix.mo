{{! THIS WAS WRITTEN BY A CLANKER }}
{ lib, stdenvNoCC, fetchurl, runCommand, rocpkgs, ... }: let
    roc = rocpkgs.nightly;
    # generated by ./do lock
    packages = map (dep: let
        name = lib.removeSuffix ".tar.zst" (baseNameOf dep.url);
    in {
        inherit (dep) url;
        root = runCommand "roc-package-${name}" { nativeBuildInputs = [ roc ]; } ''
            mkdir unbundled && cd unbundled
            ln -s ${fetchurl dep} ${name}.tar.zst
            roc unbundle ${name}.tar.zst
            mv ${name} $out
        '';
    }) (lib.importJSON ./roc.lock.json);
    # the sandbox has no network
    replaceDeps = lib.concatMap (package: [ "--replace-dep" package.url "${package.root}/main.roc" ]) packages;
in stdenvNoCC.mkDerivation {
    pname = "{{subproject_name}}";
    version = "{{subproject_version}}";

    # local builds would clash
    src = lib.cleanSourceWith {
        src = ./.;
        filter = path: _: baseNameOf path != ".build";
    };

    nativeBuildInputs = [
        roc
    ];

    # roc caches into $HOME
    preBuild = ''
        export ROC_CACHE_DIR="$TMPDIR/roc"
    '';

    buildPhase = ''
        runHook preBuild
        bash ./do build-release ${lib.escapeShellArgs replaceDeps}
        runHook postBuild
    '';

    installPhase = ''
        runHook preInstall
        install -Dm755 -t "$out/bin" .build/release/{{subproject_name}}
        runHook postInstall
    '';

    meta = {
        description = "";
        mainProgram = "{{subproject_name}}";
        platforms = lib.platforms.linux;
    };
}
