#!/usr/bin/env bash

# TODO: this should just generate a "config" file and then use that config file to generate the template
# that also gives the ability to save a preconfigured template

set -o pipefail

ssm_dir="$(realpath -- "$(dirname -- "${BASH_SOURCE[0]}")")"
ssm_root="$(dirname -- "$ssm_dir")"
# CLANKER ASSISTED: the generated run script replaces the bootstrap `init`, the stage is created per run.
# .ssm may be tracked or read only so everything temporary goes into the (ignored) .ssm-stage in the
# project root, which also keeps the final moves on the same filesystem
ssm_run_name="init"
ssm_subproject_version="0.1.0"
ssm_stage_dir="$ssm_root/.ssm-stage"
ssm_stage=

printErr() {
    printf '\033[37m[\033[91merr\033[37m]\033[0m %s\n' "$1" >&2
}

printWarn() {
    printf '\033[37m[\033[93mwarn\033[37m]\033[0m %s\n' "$1" >&2
}

printLog() {
    printf '\033[37m[log]\033[0m %s\n' "$1" >&2
}

die() {
    printErr "$1"
    exit 1
}

modeOf_help() {
    echo \
"--------------------------------------------------------------------------------
ssm <mode>
--------------------------------------------------------------------------------
<mode>:
    init
        initialize the project. the files are rendered and the remaining
        setup (git, sbx-shell, flake lock, sandbox steps) is written into
        ./init, run it to finish the setup. it removes itself once done.
    add [<name> [<type>]]
        add more sub projects to an initialized project. without a name the
        subprojects are picked in the tui, otherwise <name> is created from
        the <type> template (default: base). the remaining setup is
        written into ./init like \`init\` does.
    sync
        ! todo !
        re-render missing _meta files, re-pick the zellij panes and re-apply
        the sandbox mounts/covers.
    pin
        ! todo !
        pin the flake's nixpkgs to the host's nixpkgs revision.
    update
        ! todo !
        check for the latest template from the nyx repo
    help
        show this message.
--------------------------------------------------------------------------------"
}

# Resolves the host's pinned nixpkgs as a flake ref so `nixpkgs#...` doesn't
# fall through to the global registry (nixpkgs-unstable, refetched per tarball-ttl).
# Prints nothing if no host pin could be found.
hostNixpkgsRef() {
    local entry rev path

    # system/user registry pin (e.g. nix.registry.nixpkgs.flake = inputs.nixpkgs)
    entry="$(nix registry list 2>/dev/null | awk '$1 != "global" && $2 == "flake:nixpkgs" { print $3; exit }')"
    if [[ -n "$entry" ]]; then
        printf '%s\n' "$entry"
        return
    fi

    # revision the running NixOS system was built from
    if command -v nixos-version &> /dev/null; then
        rev="$(nixos-version --revision 2>/dev/null)"
        if [[ "$rev" =~ ^[0-9a-f]{40}$ ]]; then
            printf 'github:NixOS/nixpkgs/%s\n' "$rev"
            return
        fi
    fi

    # legacy channel / NIX_PATH
    path="$(nix-instantiate --find-file nixpkgs 2>/dev/null)"
    if [[ -n "$path" ]]; then
        printf 'path:%s\n' "$(realpath -- "$path")"
        return
    fi
}

main() {

    # Checks if the required programs are provided and if not
    # loads the aggregated nix packages and reruns itself inside
    # this shell.

    # pairs of 2 <program name> <nix packages>
    local -a required_programs=( \
        nix nixpkgs#nix          \
        git nixpkgs#git          \
        mo  nixpkgs#mo           \
        gum nixpkgs#gum          \
        jq  nixpkgs#jq           \
        awk nixpkgs#gawk         \
    );

    if [[ -z "${NYX_NIXPKGS:-}" ]] && command -v nix &> /dev/null; then
        NYX_NIXPKGS="$(hostNixpkgsRef)";
    fi
    export NYX_NIXPKGS;

    local -a packages=();
    local missing=0;
    local i;
    for (( i = 0; i < ${#required_programs[@]}; i += 2 )); do
        packages+=("${required_programs[i + 1]}");
        command -v "${required_programs[i]}" > /dev/null || missing=1;
    done

    if (( missing )); then
        if [[ -n "${NYX_INIT_IN_SHELL:-}" ]]; then
            echo "init: required programs still missing inside nix shell" >&2;
            exit 1;
        fi
        if ! command -v nix &> /dev/null; then
            echo "init: nix is required to fetch missing programs" >&2;
            exit 1;
        fi
        local -a override=();
        if [[ -n "$NYX_NIXPKGS" ]]; then
            override=(--override-flake nixpkgs "$NYX_NIXPKGS");
        else
            printWarn "couldn't find the host's pinned nixpkgs, falling back to the registry's nixpkgs."
        fi
        NYX_INIT_IN_SHELL=1 exec nix shell "${override[@]}" "${packages[@]}" --command bash "$ssm_dir/ssm" "$@";
    fi

    if ! command -v "sbx-shell" &> /dev/null; then
        printWarn "sbx-shell is unavailable. setting up sbx-shell project files will be available but constructing the sandbox itself will not."
    fi

    cd -- "$ssm_root" || die "couldn't enter $ssm_root"

    # sourced so mo can see arrays and non exported variables
    # shellcheck disable=SC1090
    source "$(command -v mo)" || die "failed to load mo"

    local -A palette=(
        [text]="#cdd6f4" [overlay0]="#6c7086" [surface0]="#313244" [base]="#1e1e2e"
        [mauve]="#cba6f7" [pink]="#f5c2e7" [lavender]="#b4befe" [green]="#a6e3a1"
    )

    local -a theme=(
        GUM_INPUT_HEADER_FOREGROUND mauve
        GUM_INPUT_PROMPT_FOREGROUND pink
        GUM_INPUT_CURSOR_FOREGROUND pink
        GUM_INPUT_PLACEHOLDER_FOREGROUND overlay0
        GUM_CHOOSE_HEADER_FOREGROUND mauve
        GUM_CHOOSE_CURSOR_FOREGROUND pink
        GUM_CHOOSE_ITEM_FOREGROUND text
        GUM_CHOOSE_SELECTED_FOREGROUND green
        GUM_CONFIRM_PROMPT_FOREGROUND lavender
        GUM_CONFIRM_SELECTED_FOREGROUND base
        GUM_CONFIRM_SELECTED_BACKGROUND mauve
        GUM_CONFIRM_UNSELECTED_FOREGROUND text
        GUM_CONFIRM_UNSELECTED_BACKGROUND surface0
    )
    local i
    for (( i = 0; i < ${#theme[@]}; i += 2 )); do
        [[ -n "${!theme[i]:-}" ]] || export "${theme[i]}=${palette[${theme[i + 1]}]}"
    done

    case "${1:-help}" in
        init) modeOf_init ;;
        add) modeOf_add "${@:2}" ;;
        #sync) modeOf_sync ;;
        #pin) modeOf_pin ;;
        help|-h|--help) modeOf_help ;;
        *) printErr "unknown mode: $1"; modeOf_help; exit 1 ;;
    esac
}

# "<key> :: <value> <meta>", every listing of the options goes through here
optLine() {
    local key="$1"
    local value=
    case "$key" in
        flake_systems) value="${flake_systems[*]}" ;;
        flake_devshell_frags) value="${flake_devshell_frags[*]}" ;;
        subprojects)
            local sub
            for sub in "${subprojects[@]}"; do
                value+="${value:+", "}$(subprojectLabel "$sub")"
            done
            ;;
        *) value="${d["$key"]}" ;;
    esac
    printf '%-20s :: %s%s\n' "$key" "$value" "${d_meta["$key"]:+" ${d_meta["$key"]}"}"
}

optLines() {
    local key
    for key in "${d_opts[@]}"; do
        optLine "$key"
    done
}

drawTuiSearch() {
    local searched=
    if ! searched=$(optLines | gum filter --limit 1 --height 12); then
        return 1
    fi
    printf '%s' "$searched"
}

drawTuiMainMenu() {
    local -a lines=()
    mapfile -t lines < <(optLines)

    local selected=
    if ! selected=$(gum choose --limit 1 --height $(( ${#lines[@]} + 3 )) --header "SSM Options" \
        "<search>" \
        "<cancel>" \
        "<confirm>" \
        "${lines[@]}" \
    ); then
        return 1
    fi
    printf '%s' "$selected"
}

# empty input falls back to $2 (default "<nil>")
drawTuiInput() {
    local key="$1"
    local fallback="${2:-"<nil>"}"
    local value="${d["$key"]}"
    [[ "$value" == "<nil>" ]] && value=

    if ! value=$(gum input --header "$key" --value "$value"); then
        return 1
    fi
    d["$key"]="${value:-"$fallback"}"
    d_meta["$key"]=""
}

drawTuiSystems() {
    local -a systems=("x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin")
    local current=
    current="$(IFS=,; printf '%s' "${flake_systems[*]}")"

    local selected=
    if ! selected=$(gum choose --no-limit --header "flake_systems" --selected "$current" "${systems[@]}"); then
        return 1
    fi
    if [[ -z "$selected" ]]; then
        printErr "pick at least one flake system"
        return 1
    fi
    mapfile -t flake_systems <<< "$selected"
}

drawTuiFragsAdd() {
    local frag=
    if ! frag=$(gum input --header "new devshell frag" --placeholder "eg. minimal"); then
        return 1
    fi
    [[ -z "$frag" ]] && return 0

    if [[ ! "$frag" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]]; then
        printErr "invalid frag name: '$frag'"
        return 1
    fi

    local existing
    for existing in "${flake_devshell_frags[@]}"; do
        if [[ "$existing" == "$frag" ]]; then
            printErr "frag already exists: '$frag'"
            return 1
        fi
    done
    flake_devshell_frags+=("$frag")
}

drawTuiFragsRemove() {
    if (( ${#flake_devshell_frags[@]} <= 1 )); then
        printErr "keep at least one devshell frag"
        return 1
    fi

    local -a kept=()
    local frag
    for frag in "${flake_devshell_frags[@]}"; do
        [[ "$frag" == "$1" ]] || kept+=("$frag")
    done
    flake_devshell_frags=("${kept[@]}")
}

drawTuiFrags() {
    while true; do
        local selected=
        if ! selected=$(gum choose --limit 1 --height 12 --header "flake_devshell_frags (select to remove)" \
            "<back>" \
            "<add>" \
            "${flake_devshell_frags[@]}" \
        ); then
            return 1
        fi

        if [[ "$selected" == "<back>" ]]; then
            return 0
        elif [[ "$selected" == "<add>" ]]; then
            drawTuiFragsAdd
        else
            drawTuiFragsRemove "$selected"
        fi
    done
}

# shared by `init` and `add`, the functions work on these variables from the caller's scope:
#   subproject_template_types  every available template type (see loadSubprojectTemplateTypes)
#   subprojects                names to create, in order
#   subproject_types           maps each name in subprojects to its template type
#   subprojects_existing       names already in the project, only checked against (optional)
#   subprojects_min            least amount of subprojects that has to be kept (default 1)
#   subprojects_exit           set by drawTuiSubprojects to the exit entry that was picked

# every directory in .ssm/templates is a subproject template type
loadSubprojectTemplateTypes() {
    subproject_template_types=()
    local tpl
    for tpl in "$ssm_dir"/templates/*/; do
        [[ -d "$tpl" ]] && subproject_template_types+=("$(basename -- "$tpl")")
    done
    (( ${#subproject_template_types[@]} ))
}

hasSubprojectTemplateType() {
    local type
    for type in "${subproject_template_types[@]}"; do
        [[ "$type" == "$1" ]] && return 0
    done
    return 1
}

subprojectLabel() {
    printf '%s (%s)' "$1" "${subproject_types["$1"]}"
}

hasSubproject() {
    local sub
    for sub in "${subprojects[@]}" "${subprojects_existing[@]}"; do
        [[ "$sub" == "$1" ]] && return 0
    done
    return 1
}

# the name doubles as the sub project's directory and its flake attribute
validateNewSubprojectName() {
    if [[ ! "$1" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]]; then
        printErr "invalid subproject name: '$1'"
        return 1
    fi
    if hasSubproject "$1"; then
        printErr "subproject already exists: '$1'"
        return 1
    fi
    if [[ -e "$ssm_root/$1" ]]; then
        printErr "'$1' already exists in the project root"
        return 1
    fi
}

# $1 header, $2 currently selected type
drawTuiSubprojectType() {
    gum choose --limit 1 --header "$1" --selected "${2:-}" "${subproject_template_types[@]}"
}

# CLANKER EDITED: the template type is picked before the name
drawTuiSubprojectsAdd() {
    local type=
    if ! type=$(drawTuiSubprojectType "new subproject template type"); then
        return 1
    fi

    local name=
    if ! name=$(gum input --header "new $type subproject name" --placeholder "eg. web"); then
        return 1
    fi
    [[ -z "$name" ]] && return 0
    validateNewSubprojectName "$name" || return 1

    subprojects+=("$name")
    subproject_types["$name"]="$type"
}

drawTuiSubprojectsRename() {
    local old="$1"
    local new=
    if ! new=$(gum input --header "rename subproject '$old'" --value "$old"); then
        return 1
    fi
    [[ -z "$new" || "$new" == "$old" ]] && return 0
    validateNewSubprojectName "$new" || return 1

    local i
    for i in "${!subprojects[@]}"; do
        [[ "${subprojects[i]}" == "$old" ]] && subprojects[i]="$new"
    done
    subproject_types["$new"]="${subproject_types["$old"]}"
    unset 'subproject_types[$old]'
}

drawTuiSubprojectsRemove() {
    local min="${subprojects_min:-1}"
    if (( ${#subprojects[@]} <= min )); then
        printErr "keep at least $min subproject(s)"
        return 1
    fi

    local -a kept=()
    local sub
    for sub in "${subprojects[@]}"; do
        [[ "$sub" == "$1" ]] || kept+=("$sub")
    done
    subprojects=("${kept[@]}")
    unset 'subproject_types[$1]'
}

drawTuiSubprojectsEdit() {
    local name="$1"
    local selected=
    if ! selected=$(gum choose --limit 1 --header "subproject: $(subprojectLabel "$name")" \
        "<back>" \
        "<rename>" \
        "<template>" \
        "<remove>" \
    ); then
        return 1
    fi

    case "$selected" in
        "<rename>") drawTuiSubprojectsRename "$name" ;;
        "<template>")
            local type=
            if ! type=$(drawTuiSubprojectType "$name template type" "${subproject_types["$name"]}"); then
                return 1
            fi
            subproject_types["$name"]="$type"
            ;;
        "<remove>") drawTuiSubprojectsRemove "$name" ;;
    esac
}

# the arguments are the exit entries listed above <add> (default "<back>"),
# the picked one is stored in subprojects_exit
drawTuiSubprojects() {
    local -a exits=("$@")
    (( ${#exits[@]} )) || exits=("<back>")

    while true; do
        local -a labels=()
        local sub
        for sub in "${subprojects[@]}"; do
            labels+=("$(subprojectLabel "$sub")")
        done

        local header="subprojects"
        (( ${#subprojects_existing[@]} )) && header+=" (existing: ${subprojects_existing[*]})"

        local selected=
        if ! selected=$(gum choose --limit 1 --height 12 --header "$header" \
            "${exits[@]}" \
            "<add>" \
            "${labels[@]}" \
        ); then
            return 1
        fi

        local exit_entry
        for exit_entry in "${exits[@]}"; do
            if [[ "$selected" == "$exit_entry" ]]; then
                subprojects_exit="$selected"
                return 0
            fi
        done

        if [[ "$selected" == "<add>" ]]; then
            drawTuiSubprojectsAdd
        else
            drawTuiSubprojectsEdit "${selected%% *}"
        fi
    done
}

# CLANKER EDITED: renders into "$render_root" (the stage) instead of "$ssm_root", returns
# failures and leaves the ignores to the template if it ships its own `.gitignore.mo`
# renders "$ssm_dir/templates/<type>" into "$render_root/<name>", every directory gets
# a generated inverse ignore unless the template provides a `.gitignore.mo`
renderSubproject() {
    local name="$1"
    local type="$2"
    local tpl_dir="$ssm_dir/templates/$type"
    local base="${render_root:-"$ssm_root"}"
    if [[ ! -d "$tpl_dir" ]]; then
        printErr "unknown subproject template type: '$type'"
        return 1
    fi

    printLog "creating subproject '$name' ($type)"
    mkdir -p -- "$base/$name" || { printErr "failed to create subproject directory '$name'"; return 1; }

    # shellcheck disable=SC2034 # used by the mo templates
    local subproject_name="$name" subproject_version="$ssm_subproject_version"
    renderTree "$tpl_dir" "$name" || return 1

    [[ -f "$tpl_dir/.gitignore.mo" ]] && return 0
    local dir rel
    while IFS= read -r -d '' dir; do
        rel="${dir#"$tpl_dir"}"
        rel="${rel#/}"
        writeInverseIgnore "$dir" "$base/$name${rel:+"/$rel"}" "$name${rel:+"/$rel"}" || return 1
    done < <(find "$tpl_dir" -type d -print0)
}

# CLANKER START template_hooks: per template `_ssm.sh` hooks
# sources "$ssm_dir/templates/<type>/_ssm.sh" (if any) once per type and collects
# its declarations into these variables from the caller's scope:
#   tpl_loaded[<type>]     set once the type was loaded
#   tpl_covers[<type>]     newline separated sbx-shell cover paths, relative to the subproject
#   tpl_hooks[<type>]      space separated hooks it defines (scaffold stage finalize)
#   run_functions          the hooks renamed to `tpl_<type>__<hook>` for the run script
#   flake_inputs flake_overlays flake_substituters flake_trusted_keys (deduplicated)
loadTemplateHook() {
    local type="$1"
    local hook_file="$ssm_dir/templates/$type/_ssm.sh"
    [[ -n "${tpl_loaded["$type"]:-}" ]] && return 0
    tpl_loaded["$type"]=1
    tpl_covers["$type"]=
    tpl_hooks["$type"]=
    [[ -f "$hook_file" ]] || return 0

    local -a ssm_tpl_covers=() ssm_tpl_flake_inputs=() ssm_tpl_flake_overlays=()
    local -a ssm_tpl_flake_substituters=() ssm_tpl_flake_trusted_keys=()
    local -a hooks=(scaffold stage finalize)
    local hook fn
    for hook in "${hooks[@]}"; do unset -f "ssm_tpl_$hook"; done

    # shellcheck disable=SC1090
    if ! source "$hook_file"; then
        printErr "failed to load the '$type' template hooks"
        return 1
    fi

    for hook in "${hooks[@]}"; do
        declare -F "ssm_tpl_$hook" > /dev/null || continue
        fn="$(declare -f "ssm_tpl_$hook")"
        run_functions+=("tpl_${type}__${hook} ${fn#"ssm_tpl_$hook "}")
        tpl_hooks["$type"]+="${tpl_hooks["$type"]:+" "}$hook"
        unset -f "ssm_tpl_$hook"
    done
    (( ${#ssm_tpl_covers[@]} )) && tpl_covers["$type"]="$(printf '%s\n' "${ssm_tpl_covers[@]}")"

    appendUnique flake_inputs "${ssm_tpl_flake_inputs[@]}"
    appendUnique flake_overlays "${ssm_tpl_flake_overlays[@]}"
    appendUnique flake_substituters "${ssm_tpl_flake_substituters[@]}"
    appendUnique flake_trusted_keys "${ssm_tpl_flake_trusted_keys[@]}"
}

# appendUnique <array name> <value>...
appendUnique() {
    local -n __au_arr="$1"
    shift
    local value existing
    for value in "$@"; do
        for existing in "${__au_arr[@]}"; do
            [[ "$existing" == "$value" ]] && continue 2
        done
        __au_arr+=("$value")
    done
}

hasTemplateHook() {
    [[ " ${tpl_hooks["$1"]} " == *" $2 "* ]]
}

# the run script's steps are pairs of <id> <command>, stored pre-quoted for the mo template
# addStep <array name> <id> <command>
addStep() {
    local -n __as_arr="$1"
    __as_arr+=("${2@Q} ${3@Q}")
}

# adds the cover and sandbox steps of the subprojects to `host_steps` and `sandbox_steps`
# addSubprojectSteps <has sbx> <name>...
addSubprojectSteps() {
    local has_sbx="$1"
    shift
    local sub type cover
    local -a covers
    for sub in "$@"; do
        type="${subproject_types["$sub"]}"
        covers=()
        [[ -n "${tpl_covers["$type"]}" ]] && mapfile -t covers <<< "${tpl_covers["$type"]}"
        if (( has_sbx )); then
            for cover in "${covers[@]}"; do
                addStep host_steps "sbx-cover:$sub/$cover" "sbx-shell mcover . ${sub@Q}/${cover@Q}"
            done
        fi
        if hasTemplateHook "$type" scaffold || hasTemplateHook "$type" stage; then
            addStep sandbox_steps "sandbox:$sub:stage" \
                "sandboxSubproject ${sub@Q} ${type@Q} ${ssm_subproject_version@Q}${covers[*]:+" ${covers[*]@Q}"}"
        fi
        if hasTemplateHook "$type" finalize; then
            addStep sandbox_steps "sandbox:$sub:finalize" "finalizeSubproject ${sub@Q} ${type@Q} ${ssm_subproject_version@Q}"
        fi
    done
}

# refuses to replace a run script that didn't finish yet
assertNoPendingRunScript() {
    local file="$ssm_root/$ssm_run_name"
    if [[ -f "$file" ]] && grep -qxF '# ssm-run-script' "$file"; then
        die "./$ssm_run_name from a previous ssm run is still pending, run or delete it (and .ssm-stage/) first"
    fi
}

# renders the run script from `host_steps`, `sandbox_steps`, `run_functions` and
# `run_done_hints` into "$ssm_root/$ssm_run_name"
# writeRunScript <mode> <expect sbx>
writeRunScript() {
    local tmp="$ssm_stage_dir/$ssm_run_name.tmp"
    # shellcheck disable=SC2034 # used by the mo template
    local run_mode="$1" run_expect_sbx="${2#0}" run_name="$ssm_run_name"
    # shellcheck disable=SC2034
    local -a run_host_steps=("${host_steps[@]}") run_sandbox_steps=("${sandbox_steps[@]}")
    mkdir -p -- "$ssm_stage_dir" || { printErr "failed to create .ssm-stage"; return 1; }
    rm -f -- "$ssm_stage_dir/$ssm_run_name.done"
    if ! mo "$ssm_dir/run.sh.mo" > "$tmp" || ! chmod +x -- "$tmp" || ! mv -f -- "$tmp" "$ssm_root/$ssm_run_name"; then
        rm -f -- "$tmp"
        rmdir -- "$ssm_stage_dir" 2> /dev/null
        printErr "failed to create ./$ssm_run_name"
        return 1
    fi
    rmdir -- "$ssm_stage_dir" 2> /dev/null
    printLog "created ./$ssm_run_name"
}

# shows the generated steps and offers to run them right away
offerRunScript() {
    # shellcheck disable=SC2016
    gum format -- "" "## ./$ssm_run_name will run the following step(s):" \
        "$(bash "$ssm_root/$ssm_run_name" --list | sed 's/^\[.\] *\([^ ]*\) *\(.*\)$/- **\1** `\2`/')"
    if gum confirm "run ./$ssm_run_name now?"; then
        cleanupStage
        cd -- "$ssm_root" || die "couldn't enter $ssm_root"
        exec bash "./$ssm_run_name"
    fi
    printLog "review and run ./$ssm_run_name when you're ready"
}

# a stage inside the project root keeps the final moves on the same filesystem
createStage() {
    mkdir -p -- "$ssm_stage_dir" || die "failed to create .ssm-stage"
    ssm_stage="$(mktemp -d "$ssm_stage_dir/stage.XXXXXX")" || die "failed to create a stage"
    trap cleanupStage EXIT
}

cleanupStage() {
    [[ -n "${ssm_stage:-}" ]] && rm -rf -- "$ssm_stage"
    ssm_stage=
    # only goes away once nothing else (eg. a pending run's progress) uses it
    [[ -d "$ssm_stage_dir" ]] && rmdir -- "$ssm_stage_dir" 2> /dev/null
    return 0
}

# moves everything in the stage into "$ssm_root". new entries are moved as a whole,
# existing directories are merged and existing files are kept unless they're listed in <force>
# commitStage <force>...
commitStage() {
    local -A force=()
    local entry
    for entry in "$@"; do force["$entry"]=1; done

    local rc=0 name
    for entry in "$ssm_stage"/* "$ssm_stage"/.*; do
        name="${entry##*/}"
        [[ "$name" == . || "$name" == .. ]] && continue
        [[ -e "$entry" || -L "$entry" ]] || continue
        if [[ -n "${force["$name"]:-}" ]]; then
            mv -fT -- "$entry" "$ssm_root/$name" || { printErr "failed to move $name into place"; rc=1; }
        else
            commitStageEntry "$entry" "$ssm_root/$name" "$name" || rc=1
        fi
    done
    return "$rc"
}

# commitStageEntry <src> <dst> <display path>
commitStageEntry() {
    local src="$1" dst="$2"
    if [[ ! -e "$dst" && ! -L "$dst" ]]; then
        mv -T -- "$src" "$dst" || { printErr "failed to move $3 into place"; return 1; }
        return 0
    fi
    if [[ ! -d "$src" || -L "$src" || ! -d "$dst" || -L "$dst" ]]; then
        printWarn "$3 already exists, skipping"
        return 0
    fi

    local rc=0 entry name
    for entry in "$src"/* "$src"/.*; do
        name="${entry##*/}"
        [[ "$name" == . || "$name" == .. ]] && continue
        [[ -e "$entry" || -L "$entry" ]] || continue
        commitStageEntry "$entry" "$dst/$name" "$3/$name" || rc=1
    done
    return "$rc"
}
# CLANKER END template_hooks

# prints the names listed in the `subprojects = [ ./<name> ... ];` block(s) of <flake>
readProjectSubprojects() {
    awk '
        /^[[:space:]]*subprojects[[:space:]]*=[[:space:]]*\[[[:space:]]*$/ { inblock = 1; next }
        inblock && /^[[:space:]]*\];/ { inblock = 0; next }
        inblock && /^[[:space:]]*\.\// {
            name = $0
            sub(/^[[:space:]]*\.\//, "", name)
            sub(/[[:space:]].*$/, "", name)
            if (name != "" && !(name in seen)) { seen[name] = 1; print name }
        }
    ' "$1"
}

# CLANKER START flake_list_add: generalized the `subprojects` awk to any list/attrset block
# adds <line>... to every `<block> = [` / `<block> = {` block of <file> whose opener is on its
# own line, lines that are already in the block (ignoring the indentation) are left alone.
# returns 2 if there's no such block
# flakeListAdd <file> <block> <line>...
flakeListAdd() {
    local file="$1" block="$2"
    shift 2
    (( $# )) || return 0
    local tmp rc=0
    tmp="$(mktemp)" || { printErr "failed to create a temporary file"; return 1; }
    awk -v block="$block" -v lines="$(printf '%s\n' "$@")" '
        function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
        BEGIN {
            n = split(lines, add, "\n")
            opener = "^[[:space:]]*" block "[[:space:]]*=[[:space:]]*[[{][[:space:]]*$"
        }
        !inblock && $0 ~ opener {
            inblock = 1; indent = ""; split("", seen)
            match($0, /^[[:space:]]*/); outer = substr($0, 1, RLENGTH)
            closer = "^" outer "(\\]|\\});?[[:space:]]*$"
            print; next
        }
        inblock && $0 ~ closer {
            if (indent == "") indent = outer "    "
            for (i = 1; i <= n; i++) {
                if (add[i] == "" || (trim(add[i]) in seen)) continue
                print indent add[i]; seen[trim(add[i])] = 1
            }
            inblock = 0; found = 1; print; next
        }
        inblock && trim($0) != "" {
            seen[trim($0)] = 1
            if (indent == "") { match($0, /^[[:space:]]*/); indent = substr($0, 1, RLENGTH) }
        }
        { print }
        END { exit found ? 0 : 2 }
    ' "$file" > "$tmp"
    rc=$?
    # written through instead of moved to keep the file mode
    if (( rc == 0 )) && ! cat -- "$tmp" > "$file"; then
        printErr "failed to update $file"
        rc=1
    fi
    rm -f -- "$tmp"
    return "$rc"
}
# inserts the empty nixConfig lists `ssm init` renders before the top level `outputs`
# if the flake has no `nixConfig` yet
# flakeEnsureNixConfig <file>
flakeEnsureNixConfig() {
    local file="$1" tmp
    grep -q '^[[:space:]]*nixConfig[[:space:]]*=' "$file" && return 0
    tmp="$(mktemp)" || { printErr "failed to create a temporary file"; return 1; }
    if awk '
        !done && /^[[:space:]]*outputs[[:space:]]*=/ {
            match($0, /^[[:space:]]*/); i = substr($0, 1, RLENGTH)
            print i "nixConfig = {"
            print i "    extra-substituters = ["
            print i "    ];"
            print i "    extra-trusted-public-keys = ["
            print i "    ];"
            print i "};"
            print ""
            done = 1
        }
        { print }
        END { exit !done }
    ' "$file" > "$tmp"; then
        cat -- "$tmp" > "$file" || printErr "failed to update $file"
    fi
    rm -f -- "$tmp"
}
# CLANKER END flake_list_add

# CLANKER EDITED: works on the staged flake.nix/.gitignore ("$render_root"), the flake list
# editing moved into flakeListAdd
# adds <name>... to the `subprojects` block(s) of the root flake.nix and un-ignores them in
# the root .gitignore, names that are already listed are left alone
# registerSubprojects <name>...
registerSubprojects() {
    (( $# )) || return 0
    local base="${render_root:-"$ssm_root"}"
    local flake="$base/flake.nix"
    local ignore="$base/.gitignore"
    local rc=0

    printLog "adding $* to flake.nix"
    local -a lines=()
    local name
    for name in "$@"; do lines+=("./$name"); done
    if ! flakeListAdd "$flake" subprojects "${lines[@]}"; then
        printErr "couldn't add to the \`subprojects = [ ... ];\` list in flake.nix, add the subproject(s) manually"
        rc=1
    fi

    if [[ ! -f "$ignore" ]]; then
        printWarn "no root .gitignore, skipping"
        return "$rc"
    fi
    printLog "adding $* to .gitignore"
    [[ -s "$ignore" && -n "$(tail -c 1 -- "$ignore")" ]] && printf '\n' >> "$ignore"
    local name
    for name in "$@"; do
        grep -qxF -- "!$name/" "$ignore" && continue
        printf '!%s/\n' "$name" >> "$ignore" || { printErr "failed to update .gitignore"; rc=1; }
    done
    return "$rc"
}

# writes an explicit inverse ignore into <dst dir> listing the entries of <template dir>,
# `.mo` entries are listed without the extension
# writeInverseIgnore <template dir> <dst dir> <display path>
writeInverseIgnore() {
    local tpl_dir="$1"
    local dst_dir="$2"
    local file="$dst_dir/.gitignore"
    if [[ -e "$file" ]]; then
        printWarn "$3/.gitignore already exists, skipping"
        return 0
    fi
    mkdir -p -- "$dst_dir" || { printErr "failed to create $3"; return 1; }

    local -a files=() dirs=()
    local path entry
    for path in "$tpl_dir"/* "$tpl_dir"/.*; do
        entry="${path##*/}"
        [[ -e "$path" ]] || continue
        [[ "$entry" == . || "$entry" == .. || "$entry" == .gitignore ]] && continue
        # CLANKER ASSISTED: the template hooks aren't rendered
        [[ "$entry" == _ssm.sh && "$(dirname -- "$tpl_dir")" == "$ssm_dir/templates" ]] && continue
        if [[ -d "$path" ]]; then
            dirs+=("!$entry/")
        else
            files+=("!${entry%.mo}")
        fi
    done

    if ! {
        printf '%s\n' '**' '.*' '!.gitignore'
        (( ${#files[@]} )) && printf '%s\n' "${files[@]}" | sort
        (( ${#dirs[@]} )) && printf '%s\n' "${dirs[@]}" | sort
        true
    } > "$file";
    then
        printErr "failed to create $3/.gitignore"
        return 1
    fi
}

# CLANKER EDITED: renders into "$render_root" (the stage), skips the template root's `_ssm.sh`
# hooks, warns about plain `.gitignore` files instead of silently skipping them and returns 1
# if anything failed instead of only logging it
# renders <template dir> into "$render_root/<dst>", `.mo` files are rendered with the variables
# in scope and have the extension dropped, everything else is copied as is. existing files are
# kept. ignores meant for the project are shipped as `.gitignore.mo`, a plain `.gitignore`
# would also apply to the repo the template lives in so those are skipped
# renderTree <template dir> <dst>
renderTree() {
    local tpl_dir="$1"
    local dst_root="$2"
    local base="${render_root:-"$ssm_root"}"
    local rc=0

    local src rel dst
    while IFS= read -r -d '' src; do
        rel="${src#"$tpl_dir/"}"
        [[ "$rel" == _ssm.sh ]] && continue
        if [[ "${rel##*/}" == .gitignore ]]; then
            printWarn "skipping template file $rel, rename it to .gitignore.mo to ship it with the project"
            continue
        fi
        rel="$dst_root/${rel%.mo}"
        dst="$base/$rel"
        if [[ -e "$dst" ]]; then
            printWarn "$rel already exists, skipping"
            continue
        fi
        mkdir -p -- "$(dirname -- "$dst")" || { printErr "failed to create $rel"; rc=1; continue; }

        if [[ "$src" == *.mo ]]; then
            mo "$src" > "$dst" || { printErr "failed to create $rel"; rc=1; }
            # CLANKER ASSISTED: rendered scripts stay executable
            if [[ -x "$src" ]]; then chmod +x -- "$dst" || { printErr "failed to make $rel executable"; rc=1; }; fi
        else
            # CLANKER ASSISTED: the template may be read only (store, try-ssm), the copies have to be editable
            { cp -- "$src" "$dst" && chmod u+w -- "$dst"; } || { printErr "failed to create $rel"; rc=1; }
        fi
    done < <(find "$tpl_dir" -type f -print0)
    return "$rc"
}

# fills git_user/git_signkey from git_mail if they're still <nil>
# or were derived from a previous mail
resolveGitFromMail() {
    local mail="${d["git_mail"]}"

    if [[ "${d["git_user"]}" == "<nil>" || "${d_meta["git_user"]}" == "(from mail)" ]]; then
        local user=
        [[ "$mail" =~ ^([^@]+)@ ]] && user="${BASH_REMATCH[1]}"
        d["git_user"]="${user:-"<nil>"}"
        d_meta["git_user"]="${user:+"(from mail)"}"
    fi

    if [[ "${d["git_signkey"]}" == "<nil>" || "${d_meta["git_signkey"]}" == "(from gpg)" ]]; then
        local key=
        if command -v gpg &> /dev/null; then
            key="$(gpg --list-secret-keys --with-colons "<$mail>" 2> /dev/null | awk -F: '$1 == "fpr" { print $10; exit }')"
        fi
        d["git_signkey"]="${key:-"<nil>"}"
        d_meta["git_signkey"]="${key:+"(from gpg)"}"
    fi
}

drawTuiEdit() {
    local key="$1"
    case "$key" in
        flake_systems) drawTuiSystems ;;
        flake_devshell_frags) drawTuiFrags ;;
        subprojects) drawTuiSubprojects ;;
        git_mail) drawTuiInput "$key" && resolveGitFromMail ;;
        sandbox_id) drawTuiSandboxId ;;
        *) drawTuiInput "$key" ;;
    esac
}

# sbx-shell context ids only allow A-Z, a-z, 0-9, _ and -, or `?` to derive one from the path
drawTuiSandboxId() {
    local previous="${d["sandbox_id"]}"
    local previous_meta="${d_meta["sandbox_id"]}"
    drawTuiInput "sandbox_id" "?" || return 1

    if [[ "${d["sandbox_id"]}" == "?" ]]; then
        d_meta["sandbox_id"]="(auto generate)"
    elif [[ ! "${d["sandbox_id"]}" =~ ^[A-Za-z0-9_-]+$ ]]; then
        printErr "invalid sandbox id: '${d["sandbox_id"]}'"
        d["sandbox_id"]="$previous"
        d_meta["sandbox_id"]="$previous_meta"
        return 1
    fi
}

drawTui() {
    while true; do
        local selected=
        if ! selected=$(drawTuiMainMenu); then
            continue;
        fi

        if [[ "$selected" == "<search>" ]]; then
            if ! selected=$(drawTuiSearch); then
                gum choose --header "invalid search" "ok" 1> /dev/null
                continue
            fi
        elif [[ "$selected" == "<cancel>" ]]; then
            exit 0
        elif [[ "$selected" == "<confirm>" ]]; then
            return 0
        fi

        drawTuiEdit "${selected%% *}"
    done
}

modeOf_init() {
    local -a d_opts=("project_name" "project_description" "sandbox_id" "nixpkgs_pin" "flake_systems" "flake_devshell_frags" "subprojects" "git_mail" "git_user" "git_signkey" "git_ssh_id")
    local -A d
    local -A d_meta # has the same keys as d(ata) but it just contains "messages"

    d["project_name"]="$(basename "$PWD")"
    d["project_description"]="ssm initialized '${d["project_name"]:-"<err>"}' project"
    d["sandbox_id"]="${d["project_name"]//[^A-Za-z0-9_-]/-}"
    d["sandbox_id"]="${d["sandbox_id"]:-"?"}"; [[ "${d["sandbox_id"]}" == "?" ]] && d_meta["sandbox_id"]="(auto generate)";
    d["nixpkgs_pin"]="<latest>"
    local -a flake_systems=("x86_64-linux")
    local -a flake_devshell_frags=("default")
    local -a subproject_template_types=()
    loadSubprojectTemplateTypes || die "no subproject templates found in $ssm_dir/templates"
    # names in order, subproject_types maps each name to its template type
    local -a subprojects=() subprojects_existing=()
    local -A subproject_types=()
    local subprojects_min=1 subprojects_exit=
    local default_subproject="${d["project_name"]//[^A-Za-z0-9_-]/-}"
    [[ "$default_subproject" =~ ^[A-Za-z_] ]] || default_subproject="_$default_subproject"
    subprojects+=("$default_subproject")
    subproject_types["$default_subproject"]="base"
    d["git_user"]="<nil>"
    d["git_mail"]="<nil>"
    d["git_signkey"]="<nil>"
    d["git_ssh_id"]="<nil>"
    
    if command -v "nixos-version" &> /dev/null; then
        if d["nixpkgs_pin"]="$(nixos-version --json | jq -re '.nixpkgsRevision')"; then
            d_meta["nixpkgs_pin"]="(from host)"
        else
            d_meta["nixpkgs_pin"]="(cant resolve)"
            d["nixpkgs_pin"]="<latest>"
        fi
    else
        d_meta["nixpkgs_pin"]="(no nix-version)"
    fi

    if ! drawTui; then
        printErr "an error occured when tui form returned"
        exit 1
    fi

    [[ "${d["nixpkgs_pin"]}" == "<nil>" ]] && d["nixpkgs_pin"]="";

    # CLANKER EDITED: everything is rendered into a stage that is only moved into place once it all
    # succeeded, and the commands are written into the ./init run script (replacing the bootstrap
    # one) instead of being run. templates add their own flake inputs, sbx-shell covers and sandbox
    # steps through their `_ssm.sh` hooks, removed confirmRunCommands
    assertNoPendingRunScript

    local -a flake_inputs=() flake_overlays=() flake_substituters=() flake_trusted_keys=() run_functions=()
    local -A tpl_loaded=() tpl_covers=() tpl_hooks=()
    local sub
    for sub in "${subprojects[@]}"; do
        loadTemplateHook "${subproject_types["$sub"]}" || exit 1
    done

    local -a host_steps=() sandbox_steps=() run_done_hints=()
    [[ ! -d "$ssm_root/.git" ]] && {
        if gum confirm "use branch 'main' instead of 'master'?"; then
            addStep host_steps git-init "git init -b main"
        else
            addStep host_steps git-init "git init"
        fi
    }
    if [[ ! -d "$ssm_root/.jj" ]]; then
        if command -v jj &> /dev/null; then
            addStep host_steps jj-init "jj git init --colocate"
        else
            printWarn "jj is unavailable, skipping jj git init"
        fi
    fi
    local ssh_command="ssh -i ${d["git_ssh_id"]@Q}"
    [[ "${d["git_user"]}" != "<nil>" ]] && addStep host_steps git-user "git config user.name ${d["git_user"]@Q}"
    [[ "${d["git_mail"]}" != "<nil>" ]] && addStep host_steps git-mail "git config user.email ${d["git_mail"]@Q}"
    [[ "${d["git_signkey"]}" != "<nil>" ]] && addStep host_steps git-signkey "git config user.signingKey ${d["git_signkey"]@Q}"
    [[ "${d["git_ssh_id"]}" != "<nil>" ]] && addStep host_steps git-ssh "git config core.sshCommand ${ssh_command@Q}"

    local has_sbx=0
    if command -v sbx-shell &> /dev/null; then
        has_sbx=1
        if [[ -L "$ssm_root/.nyx-sbx/ptr" ]]; then
            printWarn "sandbox context is already linked, skipping sbx-shell init"
        else
            addStep host_steps sbx-init "sbx-shell init ${d["sandbox_id"]@Q}"
        fi
        addStep host_steps sbx-madd "sbx-shell madd . rw ."
    fi
    addSubprojectSteps "$has_sbx" "${subprojects[@]}"
    # CLANKER ASSISTED: trust the rendered .nvim.lua where neovim runs
    addEditorTrustStep

    # `<latest>` only affects the lock command below, it must not end up as a revision in the flake
    local flake_nixpkgs_pin="${d["nixpkgs_pin"]}"
    [[ "$flake_nixpkgs_pin" == "<latest>" ]] && flake_nixpkgs_pin=""

    createStage
    local render_root="$ssm_stage"

    printLog "creating root flake.nix"
    local flake_has_nixconfig=
    # shellcheck disable=SC2034 # used by the mo template
    (( ${#flake_substituters[@]} + ${#flake_trusted_keys[@]} )) && flake_has_nixconfig=1
    if ! use_flakeparts='' nixpkgs_pin="$flake_nixpkgs_pin" flake_description="${d["project_description"]}" \
        mo "$ssm_dir/flake.nix.mo" > "$ssm_stage/flake.nix";
    then
        die "failed to create root flake.nix"
    fi

    printLog "creating root .gitignore"
    mo "$ssm_dir/.gitignore.mo" > "$ssm_stage/.gitignore" || die "failed to create root .gitignore"

    # CLANKER ASSISTED: the agent instructions live in .ssm and are copied as is, an existing one is kept
    if [[ -f "$ssm_dir/AGENTS.md" ]]; then
        printLog "creating AGENTS.md"
        { cp -- "$ssm_dir/AGENTS.md" "$ssm_stage/AGENTS.md" && chmod u+w -- "$ssm_stage/AGENTS.md"; } \
            || die "failed to create AGENTS.md"
    fi

    printLog "creating sandbox config .nyx-sbx"
    renderTree "$ssm_dir/.nyx-sbx" ".nyx-sbx" || die "failed to create .nyx-sbx"

    # CLANKER ASSISTED: the neovim project config (.nvim.lua, .nvim/snippets) goes into the project root
    printLog "creating editor config .nvim.lua, .nvim"
    mo "$ssm_dir/.nvim.lua.mo" > "$ssm_stage/.nvim.lua" || die "failed to create .nvim.lua"
    renderTree "$ssm_dir/.nvim" ".nvim" || die "failed to create .nvim"

    # CLANKER ASSISTED: rg/fd ignores for generated dirs, shipped as .mo so it doesn't apply to the template's own repo
    printLog "creating .ignore"
    mo "$ssm_dir/.ignore.mo" > "$ssm_stage/.ignore" || die "failed to create .ignore"

    for sub in "${subprojects[@]}"; do
        renderSubproject "$sub" "${subproject_types["$sub"]}" || die "failed to create subproject '$sub'"
    done

    # flakes only see files tracked by git
    # CLANKER EDITED: also tracks the editor config and .ignore
    local -a tracked=(".gitignore" ".ignore" "flake.nix" ".nyx-sbx" ".nvim.lua" ".nvim" "${subprojects[@]}")
    # CLANKER ASSISTED: track the copied agent instructions
    [[ -f "$ssm_stage/AGENTS.md" || -f "$ssm_root/AGENTS.md" ]] && tracked+=("AGENTS.md")
    addStep host_steps git-add "git add -- ${tracked[*]@Q}"
    if [[ "${d["nixpkgs_pin"]}" == "<latest>" ]]; then
        addStep host_steps flake-lock "nix flake lock"
    elif [[ "${d["nixpkgs_pin"]}" != "" ]]; then
        addStep host_steps flake-lock "nix flake lock --override-input nixpkgs \"github:NixOS/nixpkgs/${d["nixpkgs_pin"]}\""
    fi
    addSandboxEntryStep "$has_sbx" "${flake_devshell_frags[0]}"
    addStep host_steps git-add-final "git add -- ${subprojects[*]@Q} && { [[ ! -f flake.lock ]] || git add -- flake.lock; }"

    # shellcheck disable=SC2016
    local hint='enter the dev environment with `sbx-shell nix-develop`'
    (( has_sbx )) && run_done_hints+=("${hint@Q}")

    commitStage flake.nix .gitignore || die "failed to move the rendered project into place"
    cleanupStage
    writeRunScript init "$has_sbx" || exit 1
    offerRunScript

    exit 0
}

# CLANKER START nvim_trust: sandbox step that adds the project's .nvim.lua to neovim's trust list
# ('exrc'), so it runs without the prompt. the trust list is per environment, so it's done inside
# the sandbox (or the plain `nix develop` without one). editing .nvim.lua asks again, as it should
addEditorTrustStep() {
    local lua='lua local ok, err = vim.secure.trust({ action = "allow", path = ".nvim.lua" }) if not ok then io.stderr:write(tostring(err) .. "\n") vim.cmd.cquit() end'
    addStep sandbox_steps "sandbox:nvim:trust" \
        "if command -v nvim &> /dev/null; then nvim --headless --clean -c ${lua@Q} -c 'qa!'; else printWarn 'nvim is unavailable, run :trust on .nvim.lua yourself'; fi"
}
# CLANKER END nvim_trust

# CLANKER START sandbox_entry: host step that runs the sandbox steps inside the sandbox
# addSandboxEntryStep <has sbx> <devshell fragment>
addSandboxEntryStep() {
    (( ${#sandbox_steps[@]} )) || return 0
    local inner="bash ./$ssm_run_name --sandbox"
    if (( $1 )); then
        # nix-develop hands the arguments to the sandboxed $SHELL
        addStep host_steps sandbox "sbx-shell nix-develop $2 -- -c ${inner@Q}"
    else
        printWarn "no usable sbx-shell context, the sandbox steps will run in a plain \`nix develop\` on the host"
        addStep host_steps sandbox "nix develop .#$2 --command $inner"
    fi
}
# CLANKER END sandbox_entry

modeOf_add() {
    # shellcheck disable=SC2016
    [[ -f "$ssm_root/flake.nix" ]] || die "no flake.nix in $ssm_root, run \`ssm init\` first"
    # CLANKER ASSISTED: the run script replaces the commands, so a pending one must be done first
    assertNoPendingRunScript

    local -a subproject_template_types=()
    loadSubprojectTemplateTypes || die "no subproject templates found in $ssm_dir/templates"
    local -a subprojects=() subprojects_existing=()
    local -A subproject_types=()
    local subprojects_min=0 subprojects_exit=
    mapfile -t subprojects_existing < <(readProjectSubprojects "$ssm_root/flake.nix")

    if (( $# )); then
        local type="${2:-base}"
        validateNewSubprojectName "$1" || exit 1
        hasSubprojectTemplateType "$type" || die "unknown subproject template type: '$type' (available: ${subproject_template_types[*]})"
        subprojects+=("$1")
        subproject_types["$1"]="$type"
    else
        drawTuiSubprojectsAdd
        if ! drawTuiSubprojects "<confirm>" "<cancel>" || [[ "$subprojects_exit" == "<cancel>" ]]; then
            exit 0
        fi
    fi

    if (( ${#subprojects[@]} == 0 )); then
        printLog "no subprojects to add"
        exit 0
    fi

    # CLANKER EDITED: rendered and registered in a stage that is only moved into place once it all
    # succeeded, the template's flake inputs/overlays/nixConfig are added to the flake and the
    # commands are written into the ./init run script instead of being run
    local -a flake_inputs=() flake_overlays=() flake_substituters=() flake_trusted_keys=() run_functions=()
    local -A tpl_loaded=() tpl_covers=() tpl_hooks=()
    local sub
    for sub in "${subprojects[@]}"; do
        loadTemplateHook "${subproject_types["$sub"]}" || exit 1
    done

    createStage
    local render_root="$ssm_stage"
    for sub in "${subprojects[@]}"; do
        renderSubproject "$sub" "${subproject_types["$sub"]}" || die "failed to create subproject '$sub'"
    done
    cp -p -- "$ssm_root/flake.nix" "$ssm_stage/flake.nix" || die "failed to stage flake.nix"
    local -a force_entries=(flake.nix)
    if [[ -f "$ssm_root/.gitignore" ]]; then
        cp -p -- "$ssm_root/.gitignore" "$ssm_stage/.gitignore" || die "failed to stage .gitignore"
        force_entries+=(.gitignore)
    fi
    registerSubprojects "${subprojects[@]}" || die "failed to register the subprojects"

    flakeListAdd "$ssm_stage/flake.nix" inputs "${flake_inputs[@]}" \
        || die "couldn't add the template inputs to the \`inputs = { ... };\` of flake.nix"
    flakeListAdd "$ssm_stage/flake.nix" overlays "${flake_overlays[@]}" \
        || die "couldn't add the template overlays to the \`overlays = [ ... ];\` of flake.nix"
    local -a quoted_substituters=() quoted_keys=()
    local value
    for value in "${flake_substituters[@]}"; do quoted_substituters+=("\"$value\""); done
    for value in "${flake_trusted_keys[@]}"; do quoted_keys+=("\"$value\""); done
    (( ${#quoted_substituters[@]} + ${#quoted_keys[@]} )) && flakeEnsureNixConfig "$ssm_stage/flake.nix"
    if ! flakeListAdd "$ssm_stage/flake.nix" extra-substituters "${quoted_substituters[@]}" \
        || ! flakeListAdd "$ssm_stage/flake.nix" extra-trusted-public-keys "${quoted_keys[@]}"; then
        printWarn "couldn't find the nixConfig lists in flake.nix, add them yourself if you want the binary cache:"
        printf '    extra-substituters: %s\n' "${flake_substituters[@]}" >&2
        printf '    extra-trusted-public-keys: %s\n' "${flake_trusted_keys[@]}" >&2
    fi

    local -a host_steps=() sandbox_steps=() run_done_hints=()
    local has_sbx=0
    if command -v sbx-shell &> /dev/null && [[ -L "$ssm_root/.nyx-sbx/ptr" ]]; then
        has_sbx=1
    else
        printWarn "no linked sbx-shell context, skipping the sandbox covers"
    fi
    addSubprojectSteps "$has_sbx" "${subprojects[@]}"

    # flakes only see files tracked by git
    local has_git=0
    [[ -d "$ssm_root/.git" ]] && has_git=1
    if (( has_git )); then
        local -a tracked=(".gitignore" "flake.nix" "${subprojects[@]}")
        addStep host_steps git-add "git add -- ${tracked[*]@Q}"
    fi
    (( ${#flake_inputs[@]} )) && addStep host_steps flake-lock "nix flake lock"
    addSandboxEntryStep "$has_sbx" default
    (( has_git )) && addStep host_steps git-add-final "git add -- ${subprojects[*]@Q} && { [[ ! -f flake.lock ]] || git add -- flake.lock; }"

    commitStage "${force_entries[@]}" || die "failed to move the rendered subproject(s) into place"
    cleanupStage
    if (( ${#host_steps[@]} == 0 )); then
        printLog "nothing left to run"
        exit 0
    fi
    writeRunScript add "$has_sbx" || exit 1
    offerRunScript

    exit 0
}

main "$@"
