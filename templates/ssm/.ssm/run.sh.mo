#!/usr/bin/env bash
{{! THIS WAS WRITTEN BY A CLANKER: the run script `ssm init` / `ssm add` generate instead of running the setup themselves }}
# ssm-run-script
# generated by `ssm {{run_mode}}`, review or edit the steps below before running it.
# finished steps are recorded in .ssm-stage/{{run_name}}.done so a rerun after fixing a
# failure resumes where it stopped. once every step passed this script deletes itself.
#
#   ./{{run_name}}            run the host steps, the `sandbox` step runs the sandbox steps
#   ./{{run_name}} --sandbox  run the sandbox steps, meant to be run inside the sandbox
#   ./{{run_name}} --list     list the steps and whether they're done

set -o pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
self="$root/{{run_name}}"
stage_dir="$root/.ssm-stage"
state="$stage_dir/{{run_name}}.done"

printErr() {
    printf '\033[37m[\033[91merr\033[37m]\033[0m %s\n' "$1" >&2
}

printWarn() {
    printf '\033[37m[\033[93mwarn\033[37m]\033[0m %s\n' "$1" >&2
}

printLog() {
    printf '\033[37m[log]\033[0m %s\n' "$1" >&2
}

die() {
    printErr "$1"
    exit 1
}

# pairs of <step id> <command>, every command runs from the project root
host_steps=(
{{#run_host_steps}}
    {{.}}
{{/run_host_steps}}
)

sandbox_steps=(
{{#run_sandbox_steps}}
    {{.}}
{{/run_sandbox_steps}}
)

isDone() {
    [[ -f "$state" ]] && grep -qxF -- "$1" "$state"
}

runSteps() {
    local -a steps=("$@")
    local i id cmd rc
    for (( i = 0; i < ${#steps[@]}; i += 2 )); do
        id="${steps[i]}"
        cmd="${steps[i + 1]}"
        if isDone "$id"; then
            printLog "already done: $id"
            continue
        fi
        printLog "running ($id): $cmd"
        ( cd -- "$root" && eval "$cmd" )
        rc=$?
        if (( rc != 0 )); then
            printErr "step '$id' failed (exit $rc), fix the issue and rerun ./{{run_name}} to resume"
            return 1
        fi
        if ! mkdir -p -- "$stage_dir" || ! printf '%s\n' "$id" >> "$state"; then
            die "failed to record step '$id' in $state"
        fi
    done
}

# gum only lives in ssm's host shell, the sandbox gets it from the project's nixpkgs.
# fails quietly so the progress falls back to plain log lines
ensureGum() {
    command -v gum &> /dev/null && return 0
    command -v nix &> /dev/null || return 1
    local out
    out="$(nix build --no-link --print-out-paths --inputs-from "$root" nixpkgs#gum 2> /dev/null)" || return 1
    [[ -x "$out/bin/gum" ]] || return 1
    PATH="$out/bin:$PATH"
}

# the steps are grouped by the subproject in their id (`sandbox:<name>:<hook>`), the groups
# run in parallel and the steps within a group in order. every group logs into
# .ssm-stage/logs/<group>.log and drops its exit code into <group>.rc once it's done,
# a spinner (or a log line without gum/tty) covers the groups that are still running
runStepsParallel() {
    local -a steps=("$@") groups=()
    local -A group_idx=()
    local i group
    for (( i = 0; i < ${#steps[@]}; i += 2 )); do
        group="${steps[i]#*:}"
        group="${group%%:*}"
        [[ -n "${group_idx["$group"]+x}" ]] || groups+=("$group")
        group_idx["$group"]+="$i "
    done
    if (( ${#groups[@]} <= 1 )); then
        runSteps "${steps[@]}"
        return
    fi

    local logs="$stage_dir/logs"
    mkdir -p -- "$logs" || die "failed to create $logs"
    local spin=0
    [[ -t 1 ]] && ensureGum && spin=1

    local -a pids=() sub=()
    for group in "${groups[@]}"; do
        sub=()
        for i in ${group_idx["$group"]}; do sub+=("${steps[i]}" "${steps[i + 1]}"); done
        rm -f -- "$logs/$group.rc"
        (
            runSteps "${sub[@]}" < /dev/null &> "$logs/$group.log"
            printf '%s\n' "$?" > "$logs/$group.rc.tmp" && mv -f -- "$logs/$group.rc.tmp" "$logs/$group.rc"
        ) &
        pids+=("$!")
    done
    # background jobs ignore SIGINT, take them down with the script
    # shellcheck disable=SC2064 # expanded now on purpose
    trap "kill ${pids[*]} 2> /dev/null" EXIT

    local -a pending=("${groups[@]}") left=() rc_files=()
    local -a poll=(bash -c 'while :; do for f; do [[ -e "$f" ]] && exit 0; done; sleep 0.2; done' _)
    local rc=0 group_rc
    while (( ${#pending[@]} )); do
        rc_files=()
        for group in "${pending[@]}"; do rc_files+=("$logs/$group.rc"); done
        if (( spin )); then
            gum spin --spinner dot --title "setting up ${pending[*]}" -- "${poll[@]}" "${rc_files[@]}" \
                || die "interrupted, rerun ./{{run_name}} to resume"
        else
            printLog "setting up ${pending[*]}"
            "${poll[@]}" "${rc_files[@]}" || die "interrupted, rerun ./{{run_name}} to resume"
        fi

        left=()
        for group in "${pending[@]}"; do
            if [[ ! -e "$logs/$group.rc" ]]; then
                left+=("$group")
                continue
            fi
            group_rc="$(< "$logs/$group.rc")"
            if [[ "$group_rc" == 0 ]]; then
                printLog "set up $group"
            else
                rc=1
                printErr "$group failed (exit $group_rc), the last lines of .ssm-stage/logs/$group.log:"
                tail -n 30 -- "$logs/$group.log" | sed 's/^/    /' >&2
            fi
        done
        pending=("${left[@]}")
    done
    trap - EXIT
    (( rc )) && printErr "fix the failed subproject(s) and rerun ./{{run_name}}, the others are already done"
    return "$rc"
}

listSteps() {
    local -a steps=("$@")
    local i mark
    for (( i = 0; i < ${#steps[@]}; i += 2 )); do
        mark=" "
        isDone "${steps[i]}" && mark="x"
        printf '[%s] %-28s %s\n' "$mark" "${steps[i]}" "${steps[i + 1]}"
    done
}

# merges <src> into <dst>, entries of <src> win. paths relative to the subproject
# listed in <skip> are left alone on both sides (eg. covers)
# mergeTree <copy|move> <src> <dst> <rel> [skip...]
mergeTree() {
    local mode="$1" src="$2" dst="$3" rel="$4"
    shift 4
    local entry name path skip
    for entry in "$src"/* "$src"/.*; do
        name="${entry##*/}"
        [[ "$name" == . || "$name" == .. ]] && continue
        [[ -e "$entry" || -L "$entry" ]] || continue
        path="${rel:+"$rel/"}$name"
        for skip in "$@"; do
            [[ "$path" == "$skip" ]] && continue 2
        done

        local src_dir=0 dst_dir=0
        [[ -d "$entry" && ! -L "$entry" ]] && src_dir=1
        [[ -d "$dst/$name" && ! -L "$dst/$name" ]] && dst_dir=1
        if (( src_dir && dst_dir )); then
            mergeTree "$mode" "$entry" "$dst/$name" "$path" "$@" || return 1
            continue
        fi
        if (( src_dir != dst_dir )) && [[ -e "$dst/$name" || -L "$dst/$name" ]]; then
            rm -rf -- "${dst:?}/$name" || return 1
        fi
        if [[ "$mode" == move ]]; then
            mv -fT -- "$entry" "$dst/$name" || return 1
        else
            cp -afT -- "$entry" "$dst/$name" || return 1
        fi
    done
}

# builds the subproject in a stage and only moves it into place once every hook passed:
# scaffold (stage root) -> the rendered subproject is overlaid -> stage (staged subproject)
# sandboxSubproject <name> <template> <version> [cover...]
sandboxSubproject() {
    local name="$1" tpl="$2" version="$3"
    shift 3
    local dst="$root/$name"
    local stage
    mkdir -p -- "$stage_dir" || die "failed to create .ssm-stage"
    stage="$(mktemp -d "$stage_dir/stage.XXXXXX")" || die "failed to create a stage for '$name'"
    # shellcheck disable=SC2064 # expanded now on purpose
    trap "rm -rf -- '$stage'" EXIT

    if ! (
        cd -- "$stage" || exit 1
        if declare -F "tpl_${tpl}__scaffold" > /dev/null; then
            "tpl_${tpl}__scaffold" "$name" "$version" || exit 1
        fi
        mkdir -p -- "$name" || exit 1
        mergeTree copy "$dst" "$name" "" "$@" || { printErr "failed to overlay the template files of '$name'"; exit 1; }
        cd -- "$name" || exit 1
        if declare -F "tpl_${tpl}__stage" > /dev/null; then
            "tpl_${tpl}__stage" "$name" "$version" || exit 1
        fi
    ); then
        printErr "failed to stage '$name', nothing was moved into place"
        return 1
    fi

    printLog "moving the staged '$name' into place"
    if ! mergeTree move "$stage/$name" "$dst" "" "$@"; then
        printErr "failed to move the staged '$name' into place, it may be partially moved"
        return 1
    fi
}

# finalizeSubproject <name> <template> <version>
finalizeSubproject() {
    cd -- "$root/$1" || return 1
    "tpl_${2}__finalize" "$1" "$3"
}

# subproject template hooks
{{#run_functions}}
{{.}}

{{/run_functions}}
case "${1:-}" in
    "") ;;
    --sandbox)
        {{#run_expect_sbx}}
        [[ -n "${NYX_SBX_ID:-}" ]] || printWarn "NYX_SBX_ID is unset, this doesn't look like the sandbox"
        {{/run_expect_sbx}}
        runStepsParallel "${sandbox_steps[@]}" || exit 1
        exit 0
        ;;
    --list)
        listSteps "${host_steps[@]}"
        listSteps "${sandbox_steps[@]}"
        exit 0
        ;;
    *) die "unknown argument: $1" ;;
esac

runSteps "${host_steps[@]}" || exit 1
rm -rf -- "$stage_dir"
rm -f -- "$self" || printWarn "failed to remove ./{{run_name}}, remove it yourself"
printLog "setup done"
{{#run_done_hints}}
printLog {{.}}
{{/run_done_hints}}
