#!/usr/bin/env bash

# This is mostly an "internal" helper script

printHelp() {
    echo \
"--------------------------------------------------------------------------------
                      nyx [mode] - Internal nix utility for nyx
--------------------------------------------------------------------------------
[mode]:
    !todo! host-assert
        Asserts the current host for correctness. Will:
            * Ensure \`nyx\` host keys are present, validated, and correct.
            * Ensure \`preserve\` (if enabled) is properly configured with a
              valid path and anything necessary is preserved properly (keys).
            * nixosConfigurations entry matches the networking.hostname
    host-keygen
        Generate an Ed25519 OpenSSH host keypair in nyx attr form.
    host-prk-enc
        Extract the hosts private key to be symmetricly encrypted and encoded
        for the purpose of adding it as a \`nyx.nixos.hosts.<hostname>.keys.prv\`
        entry. The result is printed to the stdout. The user will be prompted
        for one.
    host-keys-match-check [hostname]
        Check the current hosts ssh keys against the host entry configured in
        nyx. Remark: might remove this and delegate to \`host-assert\`.
        * hostname [optional] - overrides the detected hostname
    host-nyx-validate-sk [hostname]
        Check that the encrypted nyx private key entry matches the stored
        hash in \`nyx.nixos.hosts.<hostname>.keys.prv\`.
        * hostname [optional] - overrides the detected hostname
    host-apply-keys [path] [hostname]
        Applies the registered nyx host keys to the provided path for a given
        hostname
        * path [optional] - defaults to \`/etc/ssh\`
        * hostname [optional] - overrides the detected hostname
    luks-unlock-keygen
        Generate the shared Ed25519 client key used to authenticate to initrd
        LUKS prompts. Prints a symmetrically encrypted nyx option assignment.
    luks-unlock-host-keygen [path]
        Generate this machine's dedicated initrd SSH host key and print its
        public key as a nyx host option assignment.
        * path [optional] - defaults to nyx.nixos.luksUnlock.hostKeyPath
    remote-luks <hostname> <address>
        Connect to a registered host's initrd and answer its LUKS prompt.
        IPv6 link-local addresses require a client-side scope such as
        \`fe80::1234%enp5s0\`.
    user-make-secret <user>
        Encrypt stdin for every host to which the user is assigned. The
        armored age ciphertext is printed to stdout.
        * user - the registered nyx user whose host keys receive the secret
    help
        Print this." >&2
}

[[ -z "${1:-}" || "$1" == "help" || "$1" == "-h" || "$1" == "--help" ]] && { printHelp; exit 0; } # print help if no param or help mode and exit early


printErr() {
    echo "[err] $1" >&2
}

assertCommands() {
    local command_name
    local has_missing=0

    for command_name in "$@"; do
        if ! command -v "$command_name" &> /dev/null; then
            printErr "command '$command_name' not found."
            has_missing=1
        fi
    done

    [[ "$has_missing" -eq 0 ]] || exit 1
}

assertInNyxCwd() {
    if [[ ! -f "flake.nix" ]]; then
        printErr "assertion failed must be ran within nix root directory"
        exit 1
    fi
}

trimStr() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

modeHostKeygen() {
    # clanker wrote this. temp files are eh. will re-write this to all be done "in memory"
    assertCommands "ssh-keygen" "rage" "sha256sum" "mktemp" "rm"

    local temp_dir key_path public_key age_key private_key_hash
    if ! temp_dir="$(mktemp -d)"; then
        printErr "failed to create temporary directory"
        exit 1
    fi

    trap 'rm -rf -- "$temp_dir"' EXIT
    trap 'exit 1' HUP INT TERM

    key_path="$temp_dir/ssh_host_ed25519_key"
    if ! ssh-keygen -q -t ed25519 -N "" -C "" -f "$key_path" > /dev/null; then
        printErr "failed to generate host key"
        exit 1
    fi

    if [[ ! -r "${key_path}.pub" ]]; then
        printErr "failed to read generated public key"
        exit 1
    fi
    public_key="$(< "${key_path}.pub")"

    if ! age_key="$(rage -p -a -e < "$key_path")"; then
        printErr "failed to encrypt sk"
        exit 1
    fi
    if ! private_key_hash="$(sha256sum -- "$key_path")"; then
        printErr "failed to hash sk"
        exit 1
    fi
    private_key_hash="${private_key_hash%% *}"

    printf "pub = \"%s\"; prv = { age = ''\n%s\n''; sha256 = \"%s\"; };\n" \
        "$public_key" "$age_key" "$private_key_hash"
    exit "$?"
}

modeHostPrkEnc() {
    assertCommands "nix" "rage" "sha256sum"
    local key_path="/etc/ssh/ssh_host_ed25519_key"
    if [[ ! -f "$key_path" ]]; then
        printErr "no host key"
        exit 1
    fi

    local age_key private_key_hash
    if [[ -r "$key_path" ]]; then
        if ! age_key=$(rage -p -a -e < "$key_path"); then
            printErr "failed to encrypt sk"
            exit 1
        fi
        if ! private_key_hash=$(sha256sum -- "$key_path"); then
            printErr "failed to hash sk"
            exit 1
        fi
    else
        if ! age_key=$(sudo sh -c 'rage -p -a -e < "$1"' sh "$key_path"); then
            printErr "failed to encrypt sk"
            exit 1
        fi
        if ! private_key_hash=$(sudo sha256sum -- "$key_path"); then
            printErr "failed to hash sk"
            exit 1
        fi
    fi

    private_key_hash="${private_key_hash%% *}"
    printf "age = ''\n%s\n'';\nsha256 = \"%s\";\n" "$age_key" "$private_key_hash"
    exit 0
}

modeHostKeysMatchCheck() {
    assertCommands "nix" "sha256sum"
    assertInNyxCwd

    local host_name="${1:-}"
    if [[ -z "$host_name" ]]; then
        if [[ -r /etc/hostname ]]; then
            host_name="$(< /etc/hostname)"
        elif [[ -r /proc/sys/kernel/hostname ]]; then
            host_name="$(< /proc/sys/kernel/hostname)"
        fi
    fi

    if [[ -z "$host_name" ]]; then
        printErr "cant resolve hostname"
        exit 1
    fi

    local sk_path="/etc/ssh/ssh_host_ed25519_key"
    local pk_path="${sk_path}.pub"

    local has_err=0
    local nyx_pub nyx_prv_hash host_pub host_prv_hash

    # --- nyx values ---
    if ! nyx_pub="$(nix eval --raw ".#nyx.nixos.hosts.\"$host_name\".keys.pub" 2>/dev/null)"; then
        nyx_pub="<err: no nyx keys.pub entry for '$host_name'>"
        has_err=1
    else
        nyx_pub="$(trimStr "$nyx_pub")"
    fi
    if ! nyx_prv_hash="$(nix eval --raw ".#nyx.nixos.hosts.\"$host_name\".keys.prv.sha256" 2>/dev/null)"; then
        nyx_prv_hash="<err: no nyx keys.prv.sha256 entry for '$host_name'>"
        has_err=1
    else
        nyx_prv_hash="$(trimStr "$nyx_prv_hash")"
    fi

    # --- host values ---
    if [[ ! -f "$pk_path" ]]; then
        host_pub="<err: no host public key at '$pk_path'>"
        has_err=1
    else
        host_pub="$(trimStr "$(< "$pk_path")")"
    fi

    if [[ ! -f "$sk_path" ]]; then
        host_prv_hash="<err: no host private key at '$sk_path'>"
        has_err=1
    elif [[ -r "$sk_path" ]]; then
        host_prv_hash="$(sha256sum -- "$sk_path")"
        host_prv_hash="$(trimStr "${host_prv_hash%% *}")"
    elif ! command -v sudo &> /dev/null; then
        host_prv_hash="<err: key unreadable and sudo not found>"
        has_err=1
    elif ! sudo -v; then
        host_prv_hash="<err: auth failed>"
        has_err=1
    elif ! host_prv_hash="$(sudo -n sha256sum -- "$sk_path" 2>/dev/null)"; then
        host_prv_hash="<err: failed to hash '$sk_path'>"
        has_err=1
    else
        host_prv_hash="$(trimStr "${host_prv_hash%% *}")"
    fi

    # --- compare (public keys by type+body, comments may differ) ---
    local status="match"
    local kt kb _
    local nyx_pub_norm host_pub_norm
    read -r kt kb _ <<< "$nyx_pub"
    nyx_pub_norm="$kt $kb"
    read -r kt kb _ <<< "$host_pub"
    host_pub_norm="$kt $kb"

    [[ "$nyx_pub_norm" == "$host_pub_norm" ]] || status="mismatch"
    [[ "$nyx_prv_hash" == "$host_prv_hash" ]] || status="mismatch"
    [[ "$has_err" -eq 0 ]] || status="mismatch"

    printf 'public.:\n  nyx..: %s\n  host.: %s\nprivate:\n  nyx..: %s\n  host.: %s\nstatus.: %s\n' \
        "$nyx_pub" "$host_pub" "$nyx_prv_hash" "$host_prv_hash" "$status"

    if [[ "$status" == "match" ]]; then
        exit 0
    else
        exit 1
    fi
}

modeHostNyxValidateSk() {
    assertCommands "nix" "sha256sum" "rage"
    assertInNyxCwd

    local host_name="${1:-}"
    if [[ -z "$host_name" ]]; then
        if [[ -r /etc/hostname ]]; then
            host_name="$(< /etc/hostname)"
        elif [[ -r /proc/sys/kernel/hostname ]]; then
            host_name="$(< /proc/sys/kernel/hostname)"
        fi
    fi

    if [[ -z "$host_name" ]]; then
        printErr "cant resolve hostname"
        exit 1
    fi

    local has_err=0
    local nyx_age nyx_stored_hash decrypted_hash

    if ! nyx_age="$(nix eval --raw ".#nyx.nixos.hosts.\"$host_name\".keys.prv.age" 2>/dev/null)"; then
        nyx_age="<err: no nyx keys.prv.age entry for '$host_name'>"
        has_err=1
    fi
    if ! nyx_stored_hash="$(nix eval --raw ".#nyx.nixos.hosts.\"$host_name\".keys.prv.sha256" 2>/dev/null)"; then
        nyx_stored_hash="<err: no nyx keys.prv.sha256 entry for '$host_name'>"
        has_err=1
    else
        nyx_stored_hash="$(trimStr "$nyx_stored_hash")"
    fi

    # rage reads ciphertext from stdin, prompts for the passphrase on the tty
    if [[ "$has_err" -eq 0 ]]; then
        local decrypted
        if ! decrypted="$(printf '%s\n' "$nyx_age" | rage -d)"; then
            decrypted_hash="<err: decrypt failed>"
            has_err=1
        else
            decrypted_hash="$(printf '%s\n' "$decrypted" | sha256sum)"
            decrypted_hash="$(trimStr "${decrypted_hash%% *}")"
        fi
    else
        decrypted_hash="<err: decrypt skipped>"
    fi

    local status="match"
    [[ "$decrypted_hash" == "$nyx_stored_hash" ]] || status="mismatch"
    [[ "$has_err" -eq 0 ]] || status="mismatch"

    printf 'private:\n  nyx.......: %s\n  decrypted.: %s\nstatus: %s\n' \
        "$nyx_stored_hash" "$decrypted_hash" "$status"

    if [[ "$status" == "match" ]]; then
        exit 0
    else
        exit 1
    fi
}

modeHostApplyKeys() {
    assertCommands "nix" "rage"
    assertInNyxCwd

    local path_output="${1:-"/etc/ssh"}"
    if [[ ! -d "$path_output" ]]; then
        printErr "invalid output path"
        exit 1
    fi

    local path_sk="$path_output/ssh_host_ed25519_key"
    local path_pk="${path_sk}.pub"
    local has_err=0

    for kpath in "$path_sk" "$path_pk"; do
        if [[ -f "$kpath" ]]; then
            printErr "$kpath already exists."
            has_err=1
        fi
    done
    [[ "$has_err" -ne 0 ]] && exit 1

    local host_name="${2:-}"
    if [[ -z "$host_name" ]]; then
        if [[ -r /etc/hostname ]]; then
            host_name="$(< /etc/hostname)"
        elif [[ -r /proc/sys/kernel/hostname ]]; then
            host_name="$(< /proc/sys/kernel/hostname)"
        else
            printErr "could not resolve hostname. provide it as a parameter instead"
            exit 1
        fi
    fi

    if ! host_pk="$(nix eval --raw ".#nyx.nixos.hosts.\"$host_name\".keys.pub" 2>/dev/null)"; then
        printErr "cannot retrieve public nyx host key entry for hostname"
        exit 1
    fi

    if ! host_sk_age="$(nix eval --raw ".#nyx.nixos.hosts.\"$host_name\".keys.prv.age" 2>/dev/null)"; then
        printErr "cannot retrieve private nyx host key entry for hostname"
        exit 1
    fi

    if ! host_sk="$(printf '%s\n' "$host_sk_age" | rage -d)"; then
        printErr "failed to decrypt sk age entry"
        exit 1
    fi

    if ! printf "%s" "$host_pk" > "$path_pk"; then
        printErr "failed to write pk"
        exit 1
    fi

    if ! printf "%s" "$host_sk" > "$path_sk"; then
        printErr "failed to write sk"
        exit 1
    fi

    exit 0
}

modeLuksUnlockKeygen() {
    set -euo pipefail
    umask 077
    assertCommands "mktemp" "rage" "rm" "sha256sum" "ssh-keygen"

    local temp_dir key_path public_key encrypted_private private_hash
    temp_dir="$(mktemp -d)"
    trap 'rm -rf -- "$temp_dir"' EXIT
    trap 'exit 1' HUP INT TERM
    key_path="$temp_dir/id_ed25519"

    ssh-keygen -q -t ed25519 -N "" -C "nyx-luks-unlock" -f "$key_path"
    public_key="$(< "${key_path}.pub")"
    encrypted_private="$(rage -p -a -e < "$key_path")"
    private_hash="$(sha256sum -- "$key_path")"
    private_hash="${private_hash%% *}"

    printf "nyx.nixos.luksUnlock.key = {\n    public = \"%s\";\n    private = {\n        age = ''\n%s\n        '';\n        sha256 = \"%s\";\n    };\n};\n" \
        "$public_key" "$encrypted_private" "$private_hash"
}

modeLuksUnlockHostKeygen() {
    set -euo pipefail
    umask 077
    assertCommands "install" "mktemp" "nix" "rm" "ssh-keygen"
    assertInNyxCwd

    local destination="${1:-}"
    if [[ -z "$destination" ]]; then
        destination="$(nix eval --raw '.#nyx.nixos.luksUnlock.hostKeyPath')"
    fi
    if [[ "$destination" != /* || "$destination" == */ ]]; then
        printErr "host key path must be an absolute file path"
        exit 1
    fi

    local destination_parent="${destination%/*}"
    if [[ ! -d "$destination_parent" ]]; then
        printErr "host key parent directory '$destination_parent' does not exist"
        exit 1
    fi

    local -a install_command=(install)
    if [[ -e "$destination" || -e "${destination}.pub" ]]; then
        printErr "host key already exists at '$destination'"
        exit 1
    fi
    if [[ ! -w "$destination_parent" && "$EUID" -ne 0 ]]; then
        assertCommands "sudo"
        install_command=(sudo install)
        if sudo test -e "$destination" || sudo test -e "${destination}.pub"; then
            printErr "host key already exists at '$destination'"
            exit 1
        fi
    fi

    local temp_dir key_path public_key
    temp_dir="$(mktemp -d)"
    trap 'rm -rf -- "$temp_dir"' EXIT
    trap 'exit 1' HUP INT TERM
    key_path="$temp_dir/ssh_host_initrd_ed25519_key"
    ssh-keygen -q -t ed25519 -N "" -C "initrd-luks-unlock" -f "$key_path"
    public_key="$(< "${key_path}.pub")"

    "${install_command[@]}" -m 0600 "$key_path" "$destination"
    "${install_command[@]}" -m 0644 "${key_path}.pub" "${destination}.pub"
    printf 'luksUnlockHostKey = "%s";\n' "$public_key"
}

modeRemoteLuks() {
    set -euo pipefail
    umask 077
    assertCommands "chmod" "mktemp" "nix" "rage" "rm" "sha256sum" "ssh"
    assertInNyxCwd

    local host_name="${1:-}"
    local address="${2:-}"
    if [[ -z "$host_name" || -z "$address" ]]; then
        printErr "usage: nyx remote-luks <hostname> <address>"
        exit 1
    fi
    if [[ ! "$host_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        printErr "invalid hostname '$host_name'"
        exit 1
    fi

    local encrypted_private expected_hash host_public port
    if ! encrypted_private="$(nix eval --raw '.#nyx.nixos.luksUnlock.key.private.age' 2>/dev/null)"; then
        printErr "no shared nyx LUKS unlock key is configured"
        exit 1
    fi
    expected_hash="$(nix eval --raw '.#nyx.nixos.luksUnlock.key.private.sha256')"
    if ! host_public="$(nix eval --raw ".#nyx.nixos.hosts.\"$host_name\".luksUnlockHostKey" 2>/dev/null)"; then
        printErr "host '$host_name' has no initrd LUKS SSH host key"
        exit 1
    fi
    port="$(nix eval --raw '.#nyx.nixos.luksUnlock.port' --apply toString)"

    local temp_dir key_path known_hosts actual_hash host_alias
    temp_dir="$(mktemp -d)"
    trap 'rm -rf -- "$temp_dir"' EXIT
    trap 'exit 1' HUP INT TERM
    key_path="$temp_dir/id_ed25519"
    known_hosts="$temp_dir/known_hosts"
    host_alias="nyx-initrd-$host_name"

    if ! printf '%s\n' "$encrypted_private" | rage -d > "$key_path"; then
        printErr "failed to decrypt the shared LUKS unlock key"
        exit 1
    fi
    chmod 0600 "$key_path"
    actual_hash="$(sha256sum -- "$key_path")"
    actual_hash="${actual_hash%% *}"
    if [[ "$actual_hash" != "$expected_hash" ]]; then
        printErr "decrypted LUKS unlock key failed hash validation"
        exit 1
    fi
    printf '%s %s\n' "$host_alias" "$host_public" > "$known_hosts"

    ssh -F /dev/null -tt \
        -p "$port" \
        -i "$key_path" \
        -o BatchMode=yes \
        -o CheckHostIP=no \
        -o GlobalKnownHostsFile=/dev/null \
        -o HostKeyAlias="$host_alias" \
        -o IdentitiesOnly=yes \
        -o IdentityAgent=none \
        -o StrictHostKeyChecking=yes \
        -o UpdateHostKeys=no \
        -o UserKnownHostsFile="$known_hosts" \
        "root@$address"
}

modeUserMakeSecret() {
    assertCommands "nix" "jq" "rage"
    assertInNyxCwd

    local username="${1:-}"
    if [[ -z "$username" ]]; then
        printErr "missing user"
        exit 1
    fi

    local hosts_json
    if ! hosts_json="$(nix eval --json '.#nyx.nixos.hosts' --apply 'hosts: builtins.mapAttrs (_: host: { users = host.users; pub = host.keys.pub; }) hosts' 2>/dev/null)"; then
        printErr "failed to evaluate nyx host registrations"
        exit 1
    fi

    local -a recipients
    mapfile -t recipients < <(
        jq -r --arg username "$username" '
            to_entries
            | map(select(.value.users | index($username)))
            | .[] | .value.pub
        ' <<< "$hosts_json"
    )
    if [[ "${#recipients[@]}" -eq 0 ]]; then
        printErr "no hosts assigned to user '$username'"
        exit 1
    fi

    local -a rage_args=("-e" "-a")
    local recipient
    for recipient in "${recipients[@]}"; do
        rage_args+=("-r" "$recipient")
    done

    rage "${rage_args[@]}"
}

case "${1:-}" in
    host-keygen) modeHostKeygen "${@:2}";;
    host-prk-enc) modeHostPrkEnc "${@:2}";;
    host-keys-match-check) modeHostKeysMatchCheck "${@:2}";;
    host-nyx-validate-sk) modeHostNyxValidateSk "${@:2}";;
    host-apply-keys) modeHostApplyKeys "${@:2}";;
    luks-unlock-keygen) modeLuksUnlockKeygen "${@:2}";;
    luks-unlock-host-keygen) modeLuksUnlockHostKeygen "${@:2}";;
    remote-luks) modeRemoteLuks "${@:2}";;
    user-make-secret) modeUserMakeSecret "${@:2}";;
    *)
        # help mode is handled early.
        printErr "invalid mode '$1'"
        exit 1
    ;;
esac
