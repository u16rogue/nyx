#!/usr/bin/env bash

set -o pipefail

usage() {
    echo \
"--------------------------------------------------------------------------------
sbx-shell <mode> [...args]
--------------------------------------------------------------------------------
[mode]:
    enter [id; optional] - (default) enter a sandbox
    gc - garbage collect sandbox refs
        Preserves contexts with missing refs directories or inspection errors.
        Returns nonzero if cleanup is incomplete.
    help
        Print this." >&2
}
[[ "${1:-}" == "help" ]] && { usage; exit 0; };

printErr() {
    printf '\033[37m[\033[91merr\033[37m]\033[0m %s\n' "$1" >&2
}

printWarn() {
    printf '\033[37m[\033[93mwarn\033[37m]\033[0m %s\n' "$1" >&2
}

printLog() {
    printf '\033[37m[log]\033[0m %s\n' "$1" >&2
}

mkPwdId() {
    printf '%s\n' "$PWD" | md5sum | cut -d' ' -f1
}

# Check traversal before treating a failed existence check as a missing path.
# Paths passed here must be absolute and normalized.
canInspectPath() {
    local path="$1" parent
    parent="${path%/*}"
    [[ -z "$parent" ]] && parent=/
    if [[ "$parent" != / ]]; then
        canInspectPath "$parent" || return 1
    fi
    if [[ -d "$parent" ]]; then
        [[ -x "$parent" ]]
    else
        [[ ! -e "$parent" && ! -L "$parent" ]]
    fi
}

# Errors that have already been reported and just need the signal to be processed.
# Use for collecting errors.
has_reported_err=0;
assertHasReportedErr() {
    if [[ $has_reported_err == 1 ]]; then
        exit 1
    fi
}

# Assert programs
for prog in realpath mkdir rm bwrap which md5sum cut ln nologin id; do
    if ! command -v "$prog" &> /dev/null; then
        has_reported_err=1
        printErr "missing required program '$prog' is not available."
    fi
done
unset prog

# Assert envs
for name in HOME SHELL PWD; do
    if [[ ! -v "$name" ]]; then
        has_reported_err=1
        printErr "env '$name' is not set"
        continue
    fi

    value="${!name}"
    if [[ -z "$value" ]]; then
        has_reported_err=1
        printErr "env '$name' is set but empty"
        continue
    fi
done
unset name value

assertHasReportedErr

# Initialize - Context source
[[ -z "${NYX_SBX_SHELL_DIR:-}" ]] && printWarn "NYX_SBX_SHELL_DIR is not set. Defaulting to \$HOME/.nyx/sbx-shell"
NYX_SBX_SHELL_DIR="${NYX_SBX_SHELL_DIR:-"$HOME/.nyx/sbx-shell"}"
if ! mkdir -p -- "$NYX_SBX_SHELL_DIR"; then
    printErr "couldn't create directory: $NYX_SBX_SHELL_DIR"
    exit 1
fi
if ! NYX_SBX_SHELL_DIR="$(realpath -e -- "$NYX_SBX_SHELL_DIR")"; then
    printErr "couldn't resolve sandbox store directory"
    exit 1
fi
if [[ "$NYX_SBX_SHELL_DIR" == / ]]; then
    printErr "the sandbox store must not be the filesystem root"
    exit 1
fi

# gc mode
[[ "${1:-}" == "gc" ]] && {
    shopt -s nullglob dotglob
    gc_status=0
    if [[ ! -r "$NYX_SBX_SHELL_DIR" || ! -x "$NYX_SBX_SHELL_DIR" ]]; then
        printErr "cannot inspect sandbox store: $NYX_SBX_SHELL_DIR"
        exit 1
    fi
    for sbx_ctx_path in "$NYX_SBX_SHELL_DIR"/*; do
        if [[ -L "$sbx_ctx_path" || ! -d "$sbx_ctx_path" || ! -x "$sbx_ctx_path" ]]; then
            printWarn "not an inspectable context directory: $sbx_ctx_path; preserving"
            gc_status=1
            continue
        fi

        if [[ -L "$sbx_ctx_path/refs" || ! -d "$sbx_ctx_path/refs" || ! -r "$sbx_ctx_path/refs" || ! -x "$sbx_ctx_path/refs" ]]; then
            printWarn "$sbx_ctx_path has no inspectable, non-symlink refs directory; preserving (remove incomplete contexts manually)"
            gc_status=1
            continue
        fi

        valid_refs=0
        uncertain_refs=0
        for ref_entry in "$sbx_ctx_path/refs"/*; do
            [[ ! -L "$ref_entry" ]] && {
                if ! rm -- "$ref_entry"; then
                    printErr "failed to remove $ref_entry. please remove it as it is not a symlink. skipping."
                    uncertain_refs=1
                    gc_status=1
                    continue;
                fi
                printWarn "non symlink file inside refs was found and removed: $ref_entry"
                continue;
            };

            if ! ref_real_path="$(realpath -m -- "$ref_entry")" || ! canInspectPath "$ref_real_path"; then
                printErr "cannot inspect reference '$ref_entry'; preserving context"
                uncertain_refs=1
                gc_status=1
                continue
            fi

            if [[ ! -e "$ref_real_path" && ! -L "$ref_real_path" ]]; then
                printLog "stale reference (missing project): $ref_entry -> $ref_real_path"
                if ! rm -- "$ref_entry"; then
                    printErr "couldn't remove stale reference: $ref_entry"
                    uncertain_refs=1
                    gc_status=1
                fi
                continue
            fi

            if ! ref_real_path="$(realpath -e -- "$ref_entry")" || [[ ! -d "$ref_real_path" || ! -x "$ref_real_path" ]]; then
                printErr "reference '$ref_entry' is not an inspectable directory; preserving context"
                uncertain_refs=1
                gc_status=1
                continue
            fi

            ctx_ref_path="$ref_real_path/.nyx-sbx"
            if [[ ! -e "$ctx_ref_path" && ! -L "$ctx_ref_path" ]]; then
                printLog "stale reference (no ref): $ref_entry -> $ref_real_path"
                if ! rm -- "$ref_entry"; then
                    printErr "couldnt remove stale reference entry '$ref_entry'. please remove it yourself or try again... skipping..."
                    uncertain_refs=1
                    gc_status=1
                fi
                continue
            fi

            if [[ ! -L "$ctx_ref_path" ]]; then
                printErr "context ref '$ctx_ref_path' is not a symlink; preserving context"
                uncertain_refs=1
                gc_status=1
                continue
            fi

            if ! resolved_ctx_ref_path="$(realpath -m -- "$ctx_ref_path")" || ! canInspectPath "$resolved_ctx_ref_path" || [[ -L "$resolved_ctx_ref_path" ]]; then
                printErr "couldn't inspect backlink '$ctx_ref_path'; preserving context"
                uncertain_refs=1
                gc_status=1
                continue
            fi

            if [[ "$resolved_ctx_ref_path" != "$sbx_ctx_path" ]]; then
                printLog "stale reference (diff ref): $ref_entry -> $ref_real_path ~> $resolved_ctx_ref_path"
                if ! rm -- "$ref_entry"; then
                    printErr "couldnt remove stale reference entry '$ref_entry'. please remove it yourself or try again... skipping..."
                    uncertain_refs=1
                    gc_status=1
                fi
                continue
            fi

            printLog "valid: $ref_entry"
            ((valid_refs += 1))
        done

        printLog "$sbx_ctx_path has $valid_refs valid reference(s)"
        if (( uncertain_refs != 0 )); then
            printWarn "preserving $sbx_ctx_path because its reference count is unreliable"
            continue
        fi
        if (( valid_refs == 0 )); then
            if ! rm -rf -- "$sbx_ctx_path"; then
                printErr "failed to remove stale sandbox context: $sbx_ctx_path"
                gc_status=1
                continue
            fi
        fi
    done 
    exit "$gc_status"
};

# Enter mode
[[ "${1:-enter}" != "enter" ]] && {
    printErr "unknown command: ${1:-}"
    exit 1
};

# Initialize - Sandbox context dir
if ! PWD="$(pwd -P)"; then
    printErr "couldn't resolve working directory"
    exit 1
fi
CURRENT_SBX_DIR=
sbx_id_path="$PWD/.nyx-sbx"
if [[ -L "$sbx_id_path" ]]; then # exists? just resolve
    if ! CURRENT_SBX_DIR="$(realpath "$sbx_id_path")"; then
        printErr "failed to resolve sandbox id"
        exit 1
    fi

    [[ ! -z "${2:-}" ]] && {
        printErr "a sandbox symlink exists but enter id was still set. treated as an error to prevent unintended behavior."
        exit 1
    };
elif [[ -e "$sbx_id_path" ]]; then # exists... but isnt a symlink
    printErr "sandbox id exists in '$sbx_id_path' but is not a symlink"
    exit 1
else
    # No sbx context yet. Create a new one.
    if ! sbx_id="${2:-$(mkPwdId)}"; then # if no id is provided use PWD hash
        printErr "failed to resolve a sandbox id to use"
        exit 1
    fi
    [[ -z "${2:-}" ]] && printWarn "no sandbox id is available nor provided. using generated id: $sbx_id"

    if [[ -z "$sbx_id" || "$sbx_id" == . || "$sbx_id" == .. || "$sbx_id" == */* ]]; then
        printErr "sandbox id must be a single directory name other than '.' or '..'"
        exit 1
    fi

    CURRENT_SBX_DIR="$NYX_SBX_SHELL_DIR/$sbx_id"

    if [[ -L "$CURRENT_SBX_DIR" || ( -e "$CURRENT_SBX_DIR" && ! -d "$CURRENT_SBX_DIR" ) ]]; then
        printErr "resolved sandbox context located at '$CURRENT_SBX_DIR' exists but is not a directory"
        exit 1
    fi

    if ! mkdir -p "$CURRENT_SBX_DIR"; then
        printErr "failed to create sandbox context directory at '$CURRENT_SBX_DIR'"
        exit 1
    fi

    if ! ln -sfnT "$CURRENT_SBX_DIR" "$sbx_id_path"; then
        printErr "failed to create sandbox identifier symlink at '$sbx_id_path'"
        exit 1
    fi
    unset sbx_id
fi
unset sbx_id_path

[[ ! -d "$CURRENT_SBX_DIR" ]] && {
    printErr "invalid sandbox context resolved from id: '$CURRENT_SBX_DIR'"
    exit 1
};

[[ "${CURRENT_SBX_DIR%/*}" != "$NYX_SBX_SHELL_DIR" ]] && {
    printErr "resolved sandbox context ($CURRENT_SBX_DIR) isnt located inside NYX_SBX_SHELL_DIR ($NYX_SBX_SHELL_DIR)"
    exit 1
};

# Initialize - Ref link back context
if [[ -L "$CURRENT_SBX_DIR/refs" || ( -e "$CURRENT_SBX_DIR/refs" && ! -d "$CURRENT_SBX_DIR/refs" ) ]]; then
    printErr "refs must be a non-symlink directory: $CURRENT_SBX_DIR/refs"
    exit 1
fi
if ! pwd_id="$(mkPwdId)"; then
    printErr "cant resolve PWD id"
    exit 1
fi
ref_at="$CURRENT_SBX_DIR/refs/$pwd_id"
if [[ ! -L "$ref_at" ]]; then
    if ! mkdir -p "$CURRENT_SBX_DIR/refs"; then
        printErr "failed to create ref directory for sandbox context"
        exit 1
    fi
    if ! ln -sfnT "$PWD" "$ref_at"; then
        printErr "failed to create a ref entry for the sandbox id"
        exit 1
    fi
    printWarn "sandbox context did not have current context in its refs. added at $ref_at"
else
    # ensure the registered ref points to current
    if ! ref_to="$(realpath "$CURRENT_SBX_DIR/refs/$pwd_id")"; then
        printErr "failed to resolve ref for sandbox context"
        exit 1
    fi
    [[ "$ref_to" != "$PWD" ]] && {
        printErr "the registered ref link in the sandbox context does not match the working directory"
        exit 1;
    };
    unset ref_to
fi
unset ref_at pwd_id

# Initialize - Group and Users
passwd_at="$CURRENT_SBX_DIR/passwd"
if [[ ! -f "$passwd_at" ]]; then
    printWarn "sandbox context does not have a passwd file. generating."
    if ! bin_nologin="$(which nologin)"; then
        printErr "couldnt resolve nologin binary"
        exit 1
    fi

    if ! id_un="$(id -un)"; then
        printErr "failed to resolve user name"
        exit 1
    fi

    if ! id_u="$(id -u)"; then
        printErr "failed to resolve user id"
        exit 1
    fi

    if ! id_g="$(id -g)"; then
        printErr "failed to resolve user group"
        exit 1
    fi

    if ! printf "root:x:0:0:System administrator:/root:%s\n%s:x:%s:%s::%s:%s" "$bin_nologin" "$id_un" "$id_u" "$id_g" "$HOME" "$bin_nologin" > "$passwd_at"; then
        printErr "failed to create passwd file"
        exit 1
    fi
    unset id_g id_u id_un bin_nologin
fi
unset passwd_at

group_at="$CURRENT_SBX_DIR/group"
if [[ ! -f "$group_at" ]]; then
    printWarn "sandbox context does not have a group file. generating."

    if ! id_gn="$(id -gn)"; then
        printErr "failed to resolve user group name"
        exit 1
    fi

    if ! id_g="$(id -g)"; then
        printErr "failed to resolve user group"
        exit 1
    fi

    if ! printf "root:x:0:\n%s:x:%s:" "$id_gn" "$id_g" > "$group_at"; then
        printErr "failed to create group file"
        exit 1
    fi
    unset id_g id_gn
fi
unset group_at

# Initialize - Hostname
# Build - Env
