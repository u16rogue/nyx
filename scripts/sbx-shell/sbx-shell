# * safely mount nix socket

set -o pipefail

prog_name="sbx-shell"
ctxlink_marker_name=".nyx-sbx"

modeOf_help() {
    echo \
"--------------------------------------------------------------------------------
$prog_name [...args] <mode> [...mode args]
--------------------------------------------------------------------------------
<mode>:
    init <id,?>
        initialize the working-directory ctxlink and its backlink, creating
        the context if needed. use '?' (quoted) to generate an id from the
        working-directory path. ids must contain only A-Z, a-z, 0-9, _ and -.
        accepts an existing .nyx-sbx directory containing project config,
        but an existing ptr must be removed manually before initializing again.
    enter [-- shell args...] (default)
        enter the sandbox selected by an existing, valid ctxlink.
        forward args to the shell using \`--\` as a separator.
    madd <id|.> <r,rw,o> <dir>
        adds a <dir> to be mounted when entering the sandbox as either a
        <r> read only, <rw> readwrite, or to use an <o> overlay. sandbox
        id must name an existing context. use '.' to select the context from
        the working-directory ctxlink. e.g. \`$prog_name madd . rw .\`.
    mcover <id|ctxlink> <path>
        covers a directory with an initially empty, persistent directory stored
        in the context. host contents are hidden, not used as an overlay lower.
        selects an existing context by id or ctxlink; use './name' for a linked
        directory whose name could be an id. path is a required sandbox target;
        relative paths use the working directory, regardless of the selector.
        covers are shared across all ctxlinks to that context and do not add refs.
        root, runtime-critical paths and context metadata cannot be covered.
        ex: \`$prog_name mcover . node_modules\`
    nix-develop|nd [fragment] [-- shell args...]
        enter the current ctxlink's sandbox with the local flake's devshell
        (fragment defaults to 'default'). requires flake.nix and the same
        mount setup as enter. pins the realized devshell in the working
        directory's ref, so it is released when that ref is collected.
        load the dev environment inside the sandbox, restore host \$SHELL,
        then source .nyx-sbx/dev-hook.sh if present before starting the shell.
        in every mode, .nyx-sbx/share/ is mounted read-only if present; the
        rest of .nyx-sbx stays hidden.
    gc
        garbage collect stale backlinks and unreferenced contexts. preserves
        contexts with missing backlink directories or inspection errors.
        for live refs, removes nix-develop generations older than the one
        each devshell profile points to; newer ones are preserved.
        returns nonzero if cleanup is incomplete.
        the ctxlink (\$PWD/$ctxlink_marker_name/ptr) is the authoritative reference
        to a context. refs (context/refs/<directory-id>/) hold a backlink ptr
        pointing to the working directory, so gc can discover its ctxlink,
        plus per-directory state such as nix-develop pins. enter
        repairs a missing backlink when the ctxlink still points
        to that context.
    help
        print this." >&2
}
[[ "${1:-}" == "help" ]] && { modeOf_help; exit 0; };

printErr() {
    printf '\033[37m[\033[91merr\033[37m]\033[0m %s\n' "$1" >&2
}

printWarn() {
    printf '\033[37m[\033[93mwarn\033[37m]\033[0m %s\n' "$1" >&2
}

printLog() {
    printf '\033[37m[log]\033[0m %s\n' "$1" >&2
}

mkHash() {
    printf '%s\n' "$1" | md5sum | cut -d' ' -f1
}

mkDirectoryId() {
    mkHash "$PWD"
}

validateContextId() {
    local LC_ALL=C
    if (( $# != 1 )) || [[ ! "$1" =~ ^[A-Za-z0-9_-]+$ ]]; then
        printErr "context id must be nonempty and contain only A-Z, a-z, 0-9, _ and -"
        return 1
    fi
}

# Check traversal before treating a failed existence check as a missing path.
# Paths passed here must be absolute and normalized.
canInspectPath() {
    local path="$1"
    local parent="${path%/*}"
    [[ -z "$parent" ]] && parent=/
    if [[ "$parent" != / ]]; then
        canInspectPath "$parent" || return 1
    fi
    if [[ -d "$parent" ]]; then
        [[ -x "$parent" ]]
    else
        [[ ! -e "$parent" && ! -L "$parent" ]]
    fi
}

assertEnvironment() {
    local has_reported_err=0

    # Assert programs
    local prog
    for prog in realpath mkdir rm bwrap which md5sum cut ln nologin id getent readlink sort; do
        if ! command -v "$prog" &> /dev/null; then
            has_reported_err=1
            printErr "missing required program '$prog' is not available."
        fi
    done

    # Assert envs
    local name
    for name in HOME SHELL PWD USER PATH; do
        if [[ ! -v "$name" ]]; then
            has_reported_err=1
            printErr "env '$name' is not set"
            continue
        fi

        local value="${!name}"
        if [[ -z "$value" ]]; then
            has_reported_err=1
            printErr "env '$name' is set but empty"
            continue
        fi
    done

    (( has_reported_err == 0 ))
}

assertEnvironment || exit 1

# Initialize - Context store
[[ -z "${NYX_SBX_SHELL_DIR:-}" ]] && printWarn "NYX_SBX_SHELL_DIR is not set. Defaulting to \$HOME/.nyx/$prog_name"
NYX_SBX_SHELL_DIR="${NYX_SBX_SHELL_DIR:-"$HOME/.nyx/$prog_name"}"
if ! mkdir -p -- "$NYX_SBX_SHELL_DIR"; then
    printErr "couldn't create directory: $NYX_SBX_SHELL_DIR"
    exit 1
fi
if ! NYX_SBX_SHELL_DIR="$(realpath -e -- "$NYX_SBX_SHELL_DIR")"; then
    printErr "couldn't resolve sandbox store directory"
    exit 1
fi
if [[ "$NYX_SBX_SHELL_DIR" == / ]]; then
    printErr "the sandbox store must not be the filesystem root"
    exit 1
fi

# BEGIN CLANKER: prune superseded nix-develop generations
# Remove a live ref's devshell generations numbered below the one its profile
# points to. Nix numbers a new generation above every existing one and does
# not lock the profile before switching to it, so higher generations may
# belong to a nix-develop still in progress and are always preserved.
pruneDevshellGenerations() {
    local pins_dir="$1/nix-develop" prune_status=0
    [[ ! -e "$pins_dir" && ! -L "$pins_dir" ]] && return 0
    if [[ -L "$pins_dir" || ! -d "$pins_dir" || ! -r "$pins_dir" || ! -x "$pins_dir" ]]; then
        printErr "devshell pins '$pins_dir' are not an inspectable, non-symlink directory; preserving"
        return 1
    fi

    local LC_ALL=C
    local fragment_dir profile current current_number generation
    for fragment_dir in "$pins_dir"/*; do
        if [[ -L "$fragment_dir" || ! -d "$fragment_dir" || ! -r "$fragment_dir" || ! -x "$fragment_dir" ]]; then
            printErr "devshell pins '$fragment_dir' are not an inspectable, non-symlink directory; preserving"
            prune_status=1
            continue
        fi
        profile="$fragment_dir/devshell"
        if [[ ! -L "$profile" ]]; then
            printWarn "devshell profile '$profile' is missing; preserving its generations"
            prune_status=1
            continue
        fi
        if ! current="$(readlink -- "$profile")" || [[ ! "$current" =~ ^devshell-([0-9]+)-link$ ]]; then
            printWarn "devshell profile '$profile' does not point to a generation; preserving its generations"
            prune_status=1
            continue
        fi
        current_number="$((10#${BASH_REMATCH[1]}))"
        if [[ ! -L "$fragment_dir/$current" ]]; then
            printWarn "devshell profile '$profile' points to a missing generation; preserving its generations"
            prune_status=1
            continue
        fi

        for generation in "$fragment_dir"/devshell-*-link; do
            [[ -L "$generation" && "${generation##*/}" =~ ^devshell-([0-9]+)-link$ ]] || continue
            (( 10#${BASH_REMATCH[1]} < current_number )) || continue
            if rm -f -- "$generation"; then
                printLog "pruned superseded devshell generation: $generation"
            else
                printErr "couldn't remove superseded devshell generation: $generation"
                prune_status=1
            fi
        done
    done
    return "$prune_status"
}
# END CLANKER: prune superseded nix-develop generations

# gc mode
modeOf_gc() {
    local gc_status=0
    shopt -s nullglob dotglob
    if [[ ! -r "$NYX_SBX_SHELL_DIR" || ! -x "$NYX_SBX_SHELL_DIR" ]]; then
        printErr "cannot inspect sandbox store: $NYX_SBX_SHELL_DIR"
        exit 1
    fi
    local context_path
    for context_path in "$NYX_SBX_SHELL_DIR"/*; do
        if [[ -L "$context_path" || ! -d "$context_path" || ! -x "$context_path" ]]; then
            printWarn "not an inspectable context directory: $context_path; preserving"
            gc_status=1
            continue
        fi

        local backlinks_dir="$context_path/refs"
        if [[ -L "$backlinks_dir" || ! -d "$backlinks_dir" || ! -r "$backlinks_dir" || ! -x "$backlinks_dir" ]]; then
            printWarn "$context_path has no inspectable, non-symlink backlink directory; preserving (remove incomplete contexts manually)"
            gc_status=1
            continue
        fi

        local live_ctxlink_count=0
        local has_uncertain_backlinks=0
        local backlink_path
        for backlink_path in "$backlinks_dir"/*; do
            if [[ -L "$backlink_path" || ! -d "$backlink_path" || ! -x "$backlink_path" ]]; then
                printErr "backlink '$backlink_path' is not an inspectable, non-symlink directory; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi
            local backlink_ptr="$backlink_path/ptr"
            if [[ ! -L "$backlink_ptr" ]]; then
                printErr "backlink '$backlink_path' has no ptr symlink; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            local directory_path
            if ! directory_path="$(realpath -m -- "$backlink_ptr")" || ! canInspectPath "$directory_path"; then
                printErr "cannot inspect backlink '$backlink_path'; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            if [[ ! -e "$directory_path" && ! -L "$directory_path" ]]; then
                printLog "stale backlink (missing working directory): $backlink_path -> $directory_path"
                if ! rm -rf -- "$backlink_path"; then
                    printErr "couldn't remove stale backlink: $backlink_path"
                    has_uncertain_backlinks=1
                    gc_status=1
                fi
                continue
            fi

            if ! directory_path="$(realpath -e -- "$backlink_ptr")" || [[ ! -d "$directory_path" || ! -x "$directory_path" ]]; then
                printErr "backlink '$backlink_path' does not point to an inspectable working directory; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            local ctxlink_path="$directory_path/$ctxlink_marker_name"
            if [[ ! -e "$ctxlink_path" && ! -L "$ctxlink_path" ]]; then
                printLog "stale backlink (missing ctxlink): $backlink_path -> $directory_path"
                if ! rm -rf -- "$backlink_path"; then
                    printErr "couldn't remove stale backlink '$backlink_path'. please remove it yourself or try again... skipping..."
                    has_uncertain_backlinks=1
                    gc_status=1
                fi
                continue
            fi

            if [[ -L "$ctxlink_path" || ! -d "$ctxlink_path" || ! -x "$ctxlink_path" ]]; then
                printErr "ctxlink '$ctxlink_path' is not an inspectable, non-symlink directory; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi
            local ctxlink_ptr="$ctxlink_path/ptr"
            if [[ ! -e "$ctxlink_ptr" && ! -L "$ctxlink_ptr" ]]; then
                printLog "stale backlink (config-only ctxlink directory): $backlink_path -> $directory_path"
                if ! rm -rf -- "$backlink_path"; then
                    printErr "couldn't remove stale backlink: $backlink_path"
                    has_uncertain_backlinks=1
                    gc_status=1
                fi
                continue
            fi
            if [[ ! -L "$ctxlink_ptr" ]]; then
                printErr "ctxlink '$ctxlink_path' has no ptr symlink; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            local linked_context_path
            if ! linked_context_path="$(realpath -m -- "$ctxlink_ptr")" || ! canInspectPath "$linked_context_path" || [[ -L "$linked_context_path" ]]; then
                printErr "couldn't inspect ctxlink '$ctxlink_path'; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            if [[ "$linked_context_path" != "$context_path" ]]; then
                printLog "stale backlink (ctxlink points to another context): $backlink_path -> $directory_path ~> $linked_context_path"
                if ! rm -rf -- "$backlink_path"; then
                    printErr "couldn't remove stale backlink '$backlink_path'. please remove it yourself or try again... skipping..."
                    has_uncertain_backlinks=1
                    gc_status=1
                fi
                continue
            fi

            printLog "live backlink: $backlink_path"
            ((live_ctxlink_count += 1))
            # Clanker implemented: release devshells superseded by a newer generation
            pruneDevshellGenerations "$backlink_path" || gc_status=1
        done

        printLog "$context_path has $live_ctxlink_count live ctxlink(s)"
        if (( has_uncertain_backlinks != 0 )); then
            printWarn "preserving $context_path because its live ctxlink count is unreliable"
            continue
        fi
        if (( live_ctxlink_count == 0 )); then
            if ! rm -rf -- "$context_path"; then
                printErr "failed to remove unreferenced context: $context_path"
                gc_status=1
                continue
            fi
        fi
    done 
    exit "$gc_status"
};

# Clanker implemented
# Fill the supplied array with account homes as well as HOME. Changing HOME
# must not make the account's real home mountable.
readHomePaths() {
    local -n home_paths_result="$1"
    local accounts home _
    if ! accounts="$(getent passwd)"; then
        printErr "couldn't enumerate account home directories"
        return 1
    fi
    home_paths_result=("$HOME")
    while IFS=: read -r _ _ _ _ _ home _; do
        [[ "$home" == /* ]] && home_paths_result+=("$home")
    done <<< "$accounts"

    local i
    for i in "${!home_paths_result[@]}"; do
        if ! home_paths_result[i]="$(realpath -m -- "${home_paths_result[$i]}")"; then
            printErr "couldn't resolve account home directory"
            return 1
        fi
    done
}

# Clanker implemented
# The first argument is an absolute, normalized path; the rest are protected
# homes. A home may contain projects, but must not be mounted whole.
validateMountPath() {
    local path="$1"
    shift
    if [[ "$path" != /* || "${path%/*}" == "" ]]; then
        printErr "cannot mount the root or a top-level directory: $path"
        return 1
    fi
    if [[ "${path%/*}" == /home ]]; then
        printErr "cannot mount a home directory: $path"
        return 1
    fi
    case "$path/" in
        /bin/*|/sbin/*|/lib/*|/lib32/*|/lib64/*|/libx32/*|/boot/*|/dev/*|/etc/*|/proc/*|/run/*|/sys/*|/usr/*|/nix/*|/var/*)
            printErr "cannot mount a host system directory: $path"
            return 1 ;;
        */"$ctxlink_marker_name"/*)
            printErr "cannot mount ctxlink metadata: $path"
            return 1 ;;
    esac
    if [[ "$path" == "$NYX_SBX_SHELL_DIR" || "$path" == "$NYX_SBX_SHELL_DIR/"* || "$NYX_SBX_SHELL_DIR" == "$path/"* ]]; then
        printErr "cannot mount the sandbox store, its contents, or its parents: $path"
        return 1
    fi
    local home
    for home in "$@"; do
        if [[ "$path" == "$home" || "$home" == "$path/"* ]]; then
            printErr "cannot mount a home directory or its parents: $path"
            return 1
        fi
    done
}

# Clanker implemented
# Check both the requested host path and its symlink target. The remaining
# arguments are protected homes, just like validateMountPath.
resolveMountPath() {
    local path="$1"
    shift
    path="$(realpath -ms -- "$path")" || return 1
    validateMountPath "$path" "$@" || return 1
    path="$(realpath -m -- "$path")" || return 1
    validateMountPath "$path" "$@" || return 1
    printf '%s\n' "$path"
}

# Clanker implemented
# Cover destinations are sandbox paths, not host sources. Keep metadata and
# the runtime needed to enter the sandbox out of their reach.
validateCoverTarget() {
    local path="$1" reserved_path
    if [[ "$path" != /* || "$path" == / ]]; then
        printErr "cover target must be an absolute, non-root sandbox path: $path"
        return 1
    fi
    case "$path/" in
        */"$ctxlink_marker_name"/*)
            printErr "cannot cover ctxlink metadata: $path"
            return 1 ;;
    esac
    for reserved_path in "$NYX_SBX_SHELL_DIR" /dev /proc /sys /nix \
        /etc/passwd /etc/group /etc/resolv.conf /etc/ssl /etc/static/ssl \
        /run/wrappers/bin /run/current-system/sw/bin \
        "$HOME/.nix-profile/bin" "$HOME/.local/state/nix/profile/bin" \
        "/etc/profiles/per-user/$USER/bin"; do
        if [[ "$path" == "$reserved_path" || "$path" == "$reserved_path/"* || "$reserved_path" == "$path/"* ]]; then
            printErr "cover target overlaps a reserved sandbox path '$reserved_path': $path"
            return 1
        fi
    done
}

# Clanker implemented
# Normalize the destination without resolving symlinks in the host filesystem:
# only paths actually mounted in the sandbox affect its destination lookup.
resolveCoverTarget() {
    local path
    path="$(realpath -ms -- "$1")" || return 1
    validateCoverTarget "$path" || return 1
    printf '%s\n' "$path"
}

# Clanker implemented
# Allow missing components, but require every existing component to be a
# searchable, non-symlink directory. The input must be absolute and normalized.
dirPathAssert() {
    local path="$1"
    while [[ "$path" != / ]]; do
        if [[ -L "$path" || ( -e "$path" && ( ! -d "$path" || ! -x "$path" ) ) ]]; then
            printErr "expected a searchable, non-symlink directory: $path"
            return 1
        fi
        path="${path%/*}"
        [[ -z "$path" ]] && path=/
    done
}

# Clanker implemented
dirPathCreate() {
    dirPathAssert "$1" || return 1
    if ! mkdir -p -- "$1"; then
        printErr "couldn't create directory: $1"
        return 1
    fi
}

# madd mode
modeOf_madd() {
    # BEGIN CLANKER EDIT: require an explicit madd directory
    if (( $# != 4 )) || [[ -z "$4" ]]; then
        printErr "usage: $prog_name madd <id|.> <r,rw,o> <dir> (use '.' for the working directory)"
        exit 1
    fi
    # END CLANKER EDIT: require an explicit madd directory
    [[ -z "${2:-}" ]] && { printErr "no id provided"; exit 1; }

    local PWD
    if ! PWD="$(pwd -P)"; then
        printErr "couldn't resolve working directory"
        exit 1
    fi
    local context_id="$2"
    if [[ "$context_id" == . ]]; then
        context_id="$(resolveCtxlink "$PWD/$ctxlink_marker_name")" || exit 1
    fi
    validateContextId "$context_id" || exit 1
    local mount_mode
    case "${3:-}" in
        r|ro) mount_mode="ro" ;;
        rw) mount_mode="rw" ;;
        o) mount_mode="o" ;;
        *) printErr "invalid mount mode provided; expected one of: r, rw, o"; exit 1 ;;
    esac

    # BEGIN CLANKER EDIT: validate madd source
    local -a home_paths=()
    readHomePaths home_paths || exit 1
    local mount_path
    mount_path="$(resolveMountPath "$4" "${home_paths[@]}")" || exit 1
    # END CLANKER EDIT: validate madd source
    if [[ ! -d "$mount_path" ]]; then
        printErr "mount path is not a directory: $mount_path"
        exit 1
    fi

    local context_path="$NYX_SBX_SHELL_DIR/$context_id"
    if [[ -L "$context_path" || ! -d "$context_path" ]]; then
        printErr "context must be an existing non-symlink directory: $context_path"
        exit 1
    fi

    local ctx_mount_final_store_path="$context_path/mount/$mount_mode"
    # BEGIN CLANKER EDIT: validate mount registration directories
    local mode
    for mode in ro rw o; do
        dirPathAssert "$context_path/mount/$mode" || exit 1
    done
    dirPathCreate "$ctx_mount_final_store_path" || exit 1
    # END CLANKER EDIT: validate mount registration directories

    local mount_path_id
    if ! mount_path_id="$(mkHash "$mount_path")"; then
        printErr "couldn't create id for mount path $mount_path"
        exit 1
    fi

    # BEGIN CLANKER EDIT: register and replace mount mode
    if ! ln -sfnT -- "$mount_path" "$ctx_mount_final_store_path/$mount_path_id"; then
        printErr "failed to register mount path '$mount_path' for sandbox context '$context_id'"
        exit 1
    fi

    for mode in ro rw o; do
        [[ "$mode" == "$mount_mode" ]] && continue
        if ! rm -f -- "$context_path/mount/$mode/$mount_path_id"; then
            printErr "couldn't remove previous mount mode for '$mount_path'"
            exit 1
        fi
    done
    # END CLANKER EDIT: register and replace mount mode

    printLog "registered $mount_mode mount '$mount_path' in context '$context_id'"
    exit 0
};

# BEGIN CLANKER: mcover mode
# mcover mode
# Clanker implemented
modeOf_mcover() {
    if (( $# != 3 )) || [[ -z "$2" || -z "$3" ]]; then
        printErr "usage: $prog_name mcover <id|ctxlink> <path>"
        exit 1
    fi

    local context_id
    context_id="$(resolveContextSelector "$2")" || exit 1
    local cover_target
    cover_target="$(resolveCoverTarget "$3")" || exit 1

    local cover_id cover_directory
    cover_id="$(mkHash "$cover_target")" || exit 1
    cover_directory="$NYX_SBX_SHELL_DIR/$context_id/cover/$cover_id"
    dirPathCreate "$cover_directory/upper" || exit 1
    if ! ln -sfnT -- "$cover_target" "$cover_directory/ptr"; then
        printErr "couldn't register cover for '$cover_target'"
        exit 1
    fi
    printLog "registered cover '$cover_target' in context '$context_id'"
    exit 0
};
# END CLANKER: mcover mode

# Print the context id resolved from the supplied ctxlink directory's ptr.
resolveCtxlink() {
    if (( $# != 1 )) || [[ -z "$1" ]]; then
        printErr "resolveCtxlink requires a ctxlink path"
        return 1
    fi
    if [[ -L "$1" || ! -d "$1" || ! -x "$1" ]]; then
        printErr "a non-symlink ctxlink directory is required at '$1'. use init to establish one."
        return 1
    fi
    local ctxlink_path="$1/ptr"
    if [[ ! -L "$ctxlink_path" ]]; then
        printErr "a ctxlink symlink is required at '$ctxlink_path'. use init to establish one."
        return 1
    fi
    local context_path
    if ! context_path="$(realpath -e -- "$ctxlink_path")"; then
        printErr "failed to resolve existing context from ctxlink '$ctxlink_path'"
        return 1
    fi
    if [[ ! -d "$context_path" ]]; then
        printErr "invalid context '$context_path' resolved from ctxlink '$ctxlink_path'"
        return 1
    fi
    if [[ "${context_path%/*}" != "$NYX_SBX_SHELL_DIR" ]]; then
        printErr "resolved context ($context_path) isnt located inside NYX_SBX_SHELL_DIR ($NYX_SBX_SHELL_DIR)"
        return 1
    fi
    local context_id="${context_path##*/}"
    validateContextId "$context_id" || return 1
    printf '%s\n' "$context_id"
}

# Clanker implemented
# Resolve an existing context without creating or repairing any references.
# Bare selectors matching the id charset are ids; use './name' to select a directory.
resolveContextSelector() {
    local selector="$1" context_id context_path ctxlink_path
    local LC_ALL=C
    if [[ -z "$selector" ]]; then
        printErr "a context id or ctxlink is required"
        return 1
    fi
    if [[ "$selector" =~ ^[A-Za-z0-9_-]+$ ]]; then
        context_id="$selector"
    else
        ctxlink_path="$(realpath -ms -- "$selector")" || return 1
        if [[ "${ctxlink_path##*/}" != "$ctxlink_marker_name" ]]; then
            ctxlink_path="$(realpath -e -- "$selector")/$ctxlink_marker_name" || return 1
        fi
        context_id="$(resolveCtxlink "$ctxlink_path")" || return 1
    fi
    validateContextId "$context_id" || return 1
    context_path="$NYX_SBX_SHELL_DIR/$context_id"
    dirPathAssert "$context_path" || return 1
    if [[ ! -d "$context_path" ]]; then
        printErr "context must already exist: $context_path"
        return 1
    fi
    printf '%s\n' "$context_id"
}

# Create a context's backlink to the supplied canonical target path.
createBacklink() {
    if (( $# != 2 )) || [[ -z "$1" || -z "$2" ]]; then
        printErr "createBacklink requires a context id and backlink target"
        return 1
    fi

    local context_id="$1"
    local backlink_target="$2"

    validateContextId "$context_id" || return 1

    local backlinks_dir="$NYX_SBX_SHELL_DIR/$context_id/refs"
    if [[ -L "$backlinks_dir" || ( -e "$backlinks_dir" && ! -d "$backlinks_dir" ) ]]; then
        printErr "backlink directory must be a non-symlink directory: $backlinks_dir"
        return 1
    fi
    if ! mkdir -p "$backlinks_dir"; then
        printErr "failed to create backlink directory for context"
        return 1
    fi

    local backlink_id
    if ! backlink_id="$(mkHash "$backlink_target")"; then
        printErr "can't resolve directory id for backlink target '$backlink_target'"
        return 1
    fi

    local backlink_path="$backlinks_dir/$backlink_id"
    if [[ -L "$backlink_path" || ( -e "$backlink_path" && ! -d "$backlink_path" ) ]]; then
        printErr "backlink must be a non-symlink directory: $backlink_path"
        return 1
    fi
    if ! mkdir -p "$backlink_path"; then
        printErr "failed to create backlink directory: $backlink_path"
        return 1
    fi

    # considering backlink id's are hash based i guess checking if it exists already doesnt matter
    # since collisions are unlikely and a tampered backlink is non of my concern. like why would
    # you set it to point somewhere else and expect not to break things. this should overwrite it
    # regardless
    if ! ln -sfnT "$backlink_target" "$backlink_path/ptr"; then
        printErr "failed to create a backlink for the context"
        return 1
    fi
}

# init mode
modeOf_init() {
    if (( $# != 2 )); then
        printErr "usage: $prog_name init <id,?>"
        exit 1
    fi

    local PWD
    if ! PWD="$(pwd -P)"; then
        printErr "couldn't resolve working directory"
        exit 1
    fi

    local context_id="$2"
    if [[ "$context_id" == '?' ]]; then
        if ! context_id="$(mkDirectoryId)"; then
            printErr "can't resolve working-directory id"
            exit 1
        fi
        printLog "using generated context id: $context_id"
    fi
    validateContextId "$context_id" || exit 1

    local ctxlink_path="$PWD/$ctxlink_marker_name"
    if [[ -L "$ctxlink_path" || ( -e "$ctxlink_path" && ! -d "$ctxlink_path" ) ]]; then
        printErr "ctxlink must be a non-symlink directory: $ctxlink_path"
        exit 1
    fi
    if [[ -e "$ctxlink_path/ptr" || -L "$ctxlink_path/ptr" ]]; then
        printErr "ctxlink ptr already exists at '$ctxlink_path/ptr'; remove it before initializing."
        exit 1
    fi

    local context_path="$NYX_SBX_SHELL_DIR/$context_id"
    if [[ -L "$context_path" || ( -e "$context_path" && ! -d "$context_path" ) ]]; then
        printErr "resolved context located at '$context_path' exists but is not a non-symlink directory"
        exit 1
    fi

    if ! mkdir -p "$context_path"; then
        printErr "failed to create context directory at '$context_path'"
        exit 1
    fi

    if ! mkdir -p -- "$ctxlink_path"; then
        printErr "failed to create ctxlink directory at '$ctxlink_path'"
        exit 1
    fi
    if ! ln -sT "$context_path" "$ctxlink_path/ptr"; then
        printErr "failed to create ctxlink at '$ctxlink_path'"
        exit 1
    fi

    createBacklink "$context_id" "$PWD" || exit 1
    printLog "initialized ctxlink '$PWD/$ctxlink_marker_name' for context '$context_id'"
    exit 0
};

# BEGIN CLANKER: mount loading and entry validation helpers
# Clanker implemented
# List immediate directory entries into the supplied array, including hidden
# entries. Missing directories produce an empty array; inspection errors fail.
dirEntriesRead() {
    local directory_path="$1" entry
    local -n listed_entries="$2"
    listed_entries=()
    dirPathAssert "$directory_path" || return 1
    [[ ! -d "$directory_path" ]] && return 0
    if [[ ! -r "$directory_path" || ! -x "$directory_path" ]]; then
        printErr "cannot read directory: $directory_path"
        return 1
    fi

    # Glob settings change only in the discovery subprocess. The caller reads
    # the resulting entries through its supplied array name.
    # shellcheck disable=SC2034
    mapfile -d '' -t listed_entries < <(
        shopt -u failglob
        unset GLOBIGNORE
        shopt -s nullglob dotglob
        for entry in "$directory_path"/*; do
            printf '%s\0' "$entry"
        done
    )
}

# Clanker implemented
# Read a registration's absolute, normalized target and verify its path id.
# Mount and cover readers apply their respective source/destination policies.
readRegistrationTarget() {
    local ptr="$1" path_id="$2" path resolved_path
    if [[ ! -L "$ptr" ]]; then
        printErr "registration must be a symlink: $ptr"
        return 1
    fi
    path="$(readlink -- "$ptr")" || return 1
    resolved_path="$(realpath -ms -- "$path")" || return 1
    if [[ "$path" != /* || "$path" != "$resolved_path" ]]; then
        printErr "registration target must be absolute and normalized: $ptr"
        return 1
    fi
    local expected_id
    expected_id="$(mkHash "$path")" || return 1
    if [[ "$path_id" != "$expected_id" ]]; then
        printErr "registration has an incorrect path id: $ptr"
        return 1
    fi
    printf '%s\n' "$path"
}

# Clanker implemented
# Read madd registrations into the mode and state arrays supplied by name.
# The home-policy array is also passed by name.
readMountRegistrations() {
    local registry_path="$1" mount_mode="$2" state_store_path="$3"
    local -n registered_modes="$4" registered_states="$5"
    local -n registry_homes="$6"
    local -a entries=()
    dirEntriesRead "$registry_path" entries || return 1
    local entry mount_path resolved_path
    for entry in "${entries[@]}"; do
        mount_path="$(readRegistrationTarget "$entry" "${entry##*/}")" || return 1
        resolved_path="$(resolveMountPath "$mount_path" "${registry_homes[@]}")" || return 1
        if [[ "$mount_path" != "$resolved_path" ]]; then
            printErr "registered mount path has changed; register it again: $mount_path"
            return 1
        fi
        if [[ ! -d "$mount_path" ]]; then
            printErr "registered mount directory is missing: $mount_path"
            return 1
        fi
        if [[ -n "${registered_modes[$mount_path]:-}" ]]; then
            printErr "path has multiple registered mount modes; register it again: $mount_path"
            return 1
        fi
        registered_modes["$mount_path"]="$mount_mode"
        # The caller reads this output through the supplied array name.
        # shellcheck disable=SC2034
        registered_states["$mount_path"]="$state_store_path/${entry##*/}"
    done
}

# Clanker implemented
# Covers belong to the whole context. Map each absolute target to its own upper
# directory; neither the entering ctxlink nor a madd mode determines activation.
readCoverRegistrations() {
    local cover_store_path="$1"
    local -n cover_backings="$2"
    local -a entries=()
    dirEntriesRead "$cover_store_path" entries || return 1
    local entry target_path
    for entry in "${entries[@]}"; do
        dirPathAssert "$entry/upper" || return 1
        if [[ ! -d "$entry/upper" ]]; then
            printErr "cover backing directory is missing: $entry/upper"
            return 1
        fi
        target_path="$(readRegistrationTarget "$entry/ptr" "${entry##*/}")" || return 1
        validateCoverTarget "$target_path" || return 1
        # The caller reads this output through the supplied array name.
        # shellcheck disable=SC2034
        cover_backings["$target_path"]="$entry/upper"
    done
}

# Clanker implemented
# Covers bind their persistent contents directly, without reading host files
# or creating OverlayFS work directories. The output array is passed by name.
appendCoverBwrapArgs() {
    local target_path="$1" backing_path="$2"
    local -n cover_args="$3"
    dirPathAssert "$backing_path" || return 1
    if [[ ! -d "$backing_path" ]]; then
        printErr "cover backing directory is missing: $backing_path"
        return 1
    fi
    cover_args+=(--bind "$backing_path" "$target_path")
}

# Clanker implemented
# Bubblewrap cannot create a missing cover mountpoint inside a read-only bind.
# When needed, create those directories in a temporary overlay, then make the
# parent read-only before binding the covers. No host directories are created.
appendReadonlyMountBwrapArgs() {
    local mount_path="$1" target_path
    local -n readonly_covers="$2" readonly_args="$3"
    local -a missing_cover_paths=()
    for target_path in "${!readonly_covers[@]}"; do
        if [[ "$target_path" == "$mount_path/"* && ! -d "$target_path" ]]; then
            missing_cover_paths+=("$target_path")
        fi
    done

    if (( ${#missing_cover_paths[@]} == 0 )); then
        readonly_args+=(--ro-bind "$mount_path" "$mount_path")
        return 0
    fi

    readonly_args+=(--overlay-src "$mount_path" --tmp-overlay "$mount_path")
    for target_path in "${missing_cover_paths[@]}"; do
        readonly_args+=(--dir "$target_path")
    done
    readonly_args+=(--remount-ro "$mount_path")
}

# Clanker implemented
# A previous sandbox can leave symlinks in its persistent home. Check the
# backing path before placing another mount beneath that home.
validateHomeMountDestination() {
    local context_path="$1" path="$2" candidate
    if [[ "$path" == "$HOME/"* ]]; then
        candidate="$context_path/fs-root/$HOME/${path#"$HOME/"}"
        dirPathAssert "$candidate" || return 1
    fi
}

# Clanker implemented
# Check the nearest mounted parent, whose source determines how the sandbox
# resolves this destination. An overlay also has a host lower layer to check.
validateMountDestination() {
    local context_path="$1" path="$2" parent candidate nearest_parent=
    local -n parent_backings="$3"
    for parent in "${!parent_backings[@]}"; do
        if [[ "$path" == "$parent/"* && ${#parent} -gt ${#nearest_parent} ]]; then
            nearest_parent="$parent"
        fi
    done
    if [[ -z "$nearest_parent" ]]; then
        validateHomeMountDestination "$context_path" "$path" || return 1
        return 0
    fi
    candidate="${parent_backings[$nearest_parent]}/${path#"$nearest_parent/"}"
    dirPathAssert "$candidate" || return 1
    if (( $# > 3 )); then
        local -n parent_lowers="$4"
        if [[ -n "${parent_lowers[$nearest_parent]:-}" ]]; then
            candidate="${parent_lowers[$nearest_parent]}/${path#"$nearest_parent/"}"
            dirPathAssert "$candidate" || return 1
        fi
    fi
}

# Clanker implemented
# Reject paths that contain, are within, or equal the sandbox store.
assertNoStoreOverlap() {
    local path resolved_path
    for path in "$@"; do
        resolved_path="$(realpath -e -- "$path")" || return 1
        if [[ "$resolved_path" == / || "$resolved_path" == "$NYX_SBX_SHELL_DIR" || "$resolved_path" == "$NYX_SBX_SHELL_DIR/"* || "$NYX_SBX_SHELL_DIR" == "$resolved_path/"* ]]; then
            printErr "path overlaps the sandbox store: $path"
            return 1
        fi
    done
}

# BEGIN CLANKER: devshell project mount preflight
assertDevProjectMount() {
    local project_path="$1" flake_path="$1/flake.nix" target nearest_target=
    local -n project_mount_modes="$2" project_covers="$3"
    for target in "${!project_mount_modes[@]}" "${!project_covers[@]}"; do
        if [[ ( "$flake_path" == "$target" || "$flake_path" == "$target/"* ) && ${#target} -gt ${#nearest_target} ]]; then
            nearest_target="$target"
        fi
    done
    if [[ -z "$nearest_target" ]]; then
        printErr "project directory is not mounted in this context: $project_path; register it manually with '$prog_name madd . rw .'"
        return 1
    fi
    if [[ -n "${project_covers[$nearest_target]:-}" ]]; then
        printErr "cover '$nearest_target' hides the project or its flake.nix; adjust the context mounts manually before nix-develop"
        return 1
    fi
}
# END CLANKER: devshell project mount preflight

# Clanker implemented
# Append to the caller's array by name. Keep the policy and temporary mount
# tables local, passing them explicitly to the helpers that need them.
appendContextBwrapArgs() {
    local context_path="$1"
    local -n bwrap_args="$2"
    local -a home_paths=()
    readHomePaths home_paths || return 1
    validateCoverTarget "$PWD" || return 1

    # Read and validate every active registration before appending mounts.
    local -A mount_modes=() mount_states=()
    local -A covers=()
    local -A mounted_backings=()
    local -A mounted_lowers=()
    local -a sorted_target_paths=()
    local mount_mode
    for mount_mode in ro rw o; do
        readMountRegistrations "$context_path/mount/$mount_mode" "$mount_mode" "$context_path/overlay" \
            mount_modes mount_states home_paths || return 1
    done
    readCoverRegistrations "$context_path/cover" covers || return 1

    # BEGIN CLANKER: require a registered project mount for devshell entry
    if [[ -n "${3:-}" ]]; then
        assertDevProjectMount "$3" mount_modes covers || return 1
    fi
    # END CLANKER: require a registered project mount for devshell entry

    # Order mounts and covers together so a parent cannot hide a child.
    # NUL separators preserve spaces and newlines in directory names.
    if (( ${#mount_modes[@]} > 0 || ${#covers[@]} > 0 )); then
        mapfile -d '' -t sorted_target_paths < <(printf '%s\0' "${!mount_modes[@]}" "${!covers[@]}" | LC_ALL=C sort -zu)
    fi
    local target_path overlay_path
    for target_path in "${sorted_target_paths[@]}"; do
        validateMountDestination "$context_path" "$target_path" mounted_backings mounted_lowers || return 1
        # A cover replaces any madd registration at the same absolute path.
        if [[ -n "${covers[$target_path]:-}" ]]; then
            appendCoverBwrapArgs "$target_path" "${covers[$target_path]}" "$2" || return 1
            mounted_backings["$target_path"]="${covers[$target_path]}"
            continue
        fi
        case "${mount_modes[$target_path]}" in
            ro)
                appendReadonlyMountBwrapArgs "$target_path" covers "$2" || return 1
                mounted_backings["$target_path"]="$target_path"
                ;;
            rw)
                bwrap_args+=(--bind "$target_path" "$target_path")
                mounted_backings["$target_path"]="$target_path"
                ;;
            o)
                overlay_path="${mount_states[$target_path]}"
                dirPathCreate "$overlay_path/upper" || return 1
                dirPathCreate "$overlay_path/work" || return 1
                bwrap_args+=(--overlay-src "$target_path" --overlay "$overlay_path/upper" "$overlay_path/work" "$target_path")
                # validateMountDestination reads this array by name.
                # shellcheck disable=SC2034
                mounted_backings["$target_path"]="$overlay_path/upper"
                # validateMountDestination reads this array by name.
                # shellcheck disable=SC2034
                mounted_lowers["$target_path"]="$target_path"
                ;;
        esac
    done

    # The caller masks the ctxlink after these mounts. Validate its destination
    # while the backing-directory table is still in scope.
    validateMountDestination "$context_path" "$PWD/$ctxlink_marker_name" mounted_backings mounted_lowers || return 1
}
# END CLANKER: mount loading and entry validation helpers

# BEGIN CLANKER: devshell environment preparation and GC roots
# Resolve on the host side, where Nix can build and register GC roots. Only
# the generated environment crosses into the sandbox; shellHook runs there.
# Roots live in the project's ref, so removing a stale backlink drops its pins.
prepareDevEnvironment() {
    local context_path="$1" fragment="$2" project_id fragment_id roots
    local -n dev_environment_result="$3"
    command -v nix &>/dev/null || { printErr "nix is required for nix-develop"; return 1; }
    if [[ ! -f "$PWD/flake.nix" ]]; then
        printErr "nix-develop requires $PWD/flake.nix"
        return 1
    fi

    project_id="$(mkDirectoryId)" || return 1
    fragment_id="$(mkHash "$fragment")" || return 1
    roots="$context_path/refs/$project_id/nix-develop/$fragment_id"
    dirPathCreate "$roots" || return 1
    # Output is returned through a nameref.
    # shellcheck disable=SC2034
    if ! dev_environment_result="$(nix --extra-experimental-features 'nix-command flakes' \
        print-dev-env --profile "$roots/devshell" ".#$fragment")"; then
        printErr "failed to load devshell fragment: $fragment"
        return 1
    fi
}
# END CLANKER: devshell environment preparation and GC roots

# enter mode (default)
modeOf_enter() {
    # BEGIN CLANKER: nix-develop mode and fragment selection
    local develop_fragment=
    if [[ "${1:-}" == nix-develop || "${1:-}" == nd ]]; then
        shift
        develop_fragment=default
        if (( $# > 0 )) && [[ "$1" != -- ]]; then
            develop_fragment="${1#\#}"
            shift
            if [[ -z "$develop_fragment" || "$develop_fragment" == -* ]]; then
                printErr "usage: $prog_name nix-develop|nd [fragment] [-- shell args...]"
                exit 1
            fi
        fi
    elif [[ "${1:-}" == enter ]]; then
        shift
    fi
    # END CLANKER: nix-develop mode and fragment selection
    local -a shell_args=()
    if (( $# > 0 )); then
        if [[ "$1" != -- ]]; then
            printErr "enter does not accept an id; use init <id> to establish a ctxlink, and -- before shell args"
            exit 1
        fi
        shift
        shell_args=("$@")
    fi

    local PWD
    if ! PWD="$(pwd -P)"; then
        printErr "couldn't resolve working directory"
        exit 1
    fi

    local context_id
    context_id="$(resolveCtxlink "$PWD/$ctxlink_marker_name")" || exit 1
    local context_path="$NYX_SBX_SHELL_DIR/$context_id"

    # Validate the backlink, repairing a missing one from the authoritative ctxlink.
    local backlinks_dir="$context_path/refs"
    if [[ -L "$backlinks_dir" || ( -e "$backlinks_dir" && ! -d "$backlinks_dir" ) ]]; then
        printErr "backlink directory must be a non-symlink directory: $backlinks_dir"
        exit 1
    fi

    local backlink_id
    if ! backlink_id="$(mkDirectoryId)"; then
        printErr "can't resolve working-directory id"
        exit 1
    fi

    local backlink_path="$backlinks_dir/$backlink_id"
    if [[ -L "$backlink_path" || ( -e "$backlink_path" && ! -d "$backlink_path" ) ]]; then
        printErr "backlink must be a non-symlink directory: $backlink_path"
        exit 1
    fi
    if [[ ! -L "$backlink_path/ptr" ]]; then
        createBacklink "$context_id" "$PWD" || exit 1
        printWarn "context had no backlink to '$PWD'. added at $backlink_path"
    else
        local resolved_backlink_target
        if ! resolved_backlink_target="$(realpath "$backlink_path/ptr")"; then
            printErr "failed to resolve backlink for context"
            exit 1
        fi
        if [[ "$resolved_backlink_target" != "$PWD" ]]; then
            printErr "the context backlink does not point to '$PWD'"
            exit 1
        fi
    fi

    # Initialize - Group and Users
    local bin_nologin id_un id_u id_g id_gn passwd_fd group_fd
    if ! bin_nologin="$(which nologin)"; then
        printErr "couldnt resolve nologin binary"
        exit 1
    fi
    if ! id_un="$(id -un)" || ! id_u="$(id -u)" || ! id_g="$(id -g)" || ! id_gn="$(id -gn)"; then
        printErr "failed to resolve user identity"
        exit 1
    fi
    if [[ "$HOME$id_un$id_gn$bin_nologin" == *[:$'\n']* ]]; then
        printErr "account fields must not contain ':' or newlines"
        exit 1
    fi
    exec {passwd_fd}<<< "root:x:0:0:System administrator:/root:$bin_nologin
$id_un:x:$id_u:$id_g::$HOME:$bin_nologin"
    exec {group_fd}<<< "root:x:0:
$id_gn:x:$id_g:"

    local ffs_root="$context_path/fs-root"
    if [[ "$HOME" != /* || "$HOME" == / || "$(realpath -ms -- "$HOME")" != "$HOME" ]]; then
        printErr "HOME must be an absolute, normalized non-root path"
        exit 1
    fi
    dirPathCreate "$ffs_root/$HOME" || exit 1 # can create the home dir and root dir in oneshot

    # Initialize bwrap
    local -a args_for_bwrap=(             \
        --unshare-all                     \
        --clearenv                        \
        --die-with-parent                 \
        --chdir "$PWD"                    \
        --setenv NYX_SBX_ID "$context_id" \
    );

    # BEGIN CLANKER: validate fixed runtime mount sources
    assertNoStoreOverlap /nix /etc/resolv.conf /etc/ssl /etc/static/ssl || exit 1
    # END CLANKER: validate fixed runtime mount sources

    # Setup root and fs
    args_for_bwrap+=(                             \
        --bind "$ffs_root" "/"                    \
        --ro-bind "/nix" "/nix"                   \
        --dev /dev                                \
        --proc /proc                              \
        --tmpfs /run                              \
        --tmpfs /tmp                              \
        --ro-bind-data "$group_fd" "/etc/group"   \
        --ro-bind-data "$passwd_fd" "/etc/passwd" \
        --ro-bind "/bin/sh" "/bin/sh"             \
        --ro-bind "/usr/bin/env" "/usr/bin/env"   \
    );

    # Setup network
    args_for_bwrap+=(                               \
        --share-net                                 \
        --ro-bind /etc/resolv.conf /etc/resolv.conf \
        --ro-bind /etc/ssl /etc/ssl                 \
        --ro-bind /etc/static/ssl /etc/static/ssl   \
    );

    # Setup env
    args_for_bwrap+=(                                                    \
        --setenv USER "${USER:-}"                                        \
        --setenv HOME "${HOME:-}"                                        \
        --setenv SHELL "${SHELL:-}"                                      \
        --setenv TERM "${TERM:-}"                                        \
        --setenv COLORTERM "${COLORTERM:-}"                              \
        --setenv LANG "${LANG:-}"                                        \
        --setenv LC_ALL "${LC_ALL:-}"                                    \
        --setenv LC_CTYPE "${LC_CTYPE:-}"                                \
        --setenv NIX_CONFIG "experimental-features = nix-command flakes" \
    );

    # Setup paths
    local -a known_paths=(                   \
        "/run/wrappers/bin"                  \
        "$HOME/.nix-profile/bin"             \
        "/nix/profile/bin"                   \
        "$HOME/.local/state/nix/profile/bin" \
        "/etc/profiles/per-user/$USER/bin"   \
        "/nix/var/nix/profiles/default/bin"  \
        "/run/current-system/sw/bin"         \
    );
    local path resolved_path sandboxed_path=
    for path in "${known_paths[@]}"; do
        sandboxed_path="${sandboxed_path:+$sandboxed_path:}$path"
        if resolved_path="$(realpath -e -- "$path" 2>/dev/null)"; then
            assertNoStoreOverlap "$resolved_path" || exit 1
            validateHomeMountDestination "$context_path" "$path" || exit 1
            args_for_bwrap+=(--ro-bind-try "$resolved_path" "$path")
        fi
    done
    args_for_bwrap+=(--setenv PATH "$sandboxed_path")

    # BEGIN CLANKER: registered context mounts and covers
    appendContextBwrapArgs "$context_path" args_for_bwrap "${develop_fragment:+$PWD}" || exit 1
    # END CLANKER: registered context mounts and covers

    # Hide the context link within the sandbox
    # Q: why `tmpfs` instead of `ro-bind` ?
    # A: because the previous `.devshellshook` implementation that stored some extra context
    # info in the same `$PWD` caused nix evaluation with `path:.` to copy that folder into
    # the nix store. this just outright prevents it.
    [[ -e "$PWD/$ctxlink_marker_name" ]] && args_for_bwrap+=(--tmpfs "$PWD/$ctxlink_marker_name");

    # BEGIN CLANKER: expose the project's shared config directory
    local share_path="$PWD/$ctxlink_marker_name/share"
    if [[ -e "$share_path" || -L "$share_path" ]]; then
        if [[ -L "$share_path" || ! -d "$share_path" || ! -r "$share_path" || ! -x "$share_path" ]]; then
            printErr "shared config must be a readable, non-symlink directory: $share_path"
            exit 1
        fi
        args_for_bwrap+=(--ro-bind "$share_path" "$share_path")
    fi
    # END CLANKER: expose the project's shared config directory

    # BEGIN CLANKER: expose the project's dev hook
    # A tracked project file: hiding it makes git inside the sandbox report it
    # as deleted, so bind it read-only in every mode. nix-develop sources it.
    local dev_hook="$PWD/$ctxlink_marker_name/dev-hook.sh"
    if [[ -e "$dev_hook" || -L "$dev_hook" ]]; then
        if [[ -L "$dev_hook" || ! -f "$dev_hook" || ! -r "$dev_hook" ]]; then
            printErr "dev hook must be a readable, non-symlink file: $dev_hook"
            exit 1
        fi
        args_for_bwrap+=(--ro-bind "$dev_hook" "$dev_hook")
    fi
    # END CLANKER: expose the project's dev hook

    # BEGIN CLANKER: shell or devshell entry command
    local -a entry_command=("$SHELL" "${shell_args[@]}")
    if [[ -n "$develop_fragment" ]]; then
        # BEGIN CLANKER: build and expose the devshell startup script
        # One script, sourced inside the sandbox: the Nix environment (which
        # runs the flake shellHook and sets SHELL to bash), then the host's
        # SHELL, fragment and shell args as quoted literals, then it sources
        # the read-only project hook, so the hook sees the restored values.
        local startup startup_fd
        prepareDevEnvironment "$context_path" "$develop_fragment" startup || exit 1
        # NIX_FRAGMENT expands in the sandbox, after the flake's shellHook.
        # shellcheck disable=SC2016
        printf -v startup '%s\nexport SHELL=%q\n[[ -n "${NIX_FRAGMENT:-}" ]] || export NIX_FRAGMENT=%q\nset --' \
            "$startup" "$SHELL" "$develop_fragment"
        (( ${#shell_args[@]} > 0 )) && printf -v startup '%s%s' "$startup" "$(printf ' %q' "${shell_args[@]}")"
        # Validated and bound above; the hook's own path keeps its errors legible.
        [[ -f "$dev_hook" ]] && printf -v startup '%s\nsource %q' "$startup" "$dev_hook"
        # A private descriptor avoids shared startup files racing between
        # simultaneous entries and keeps context metadata outside the sandbox.
        exec {startup_fd}<<< "$startup"
        args_for_bwrap+=(--ro-bind-data "$startup_fd" /run/nyx-dev-environment)
        # END CLANKER: build and expose the devshell startup script

        # BEGIN CLANKER: in-sandbox devshell startup stub
        # The startup fragment expands only after entering the sandbox.
        # shellcheck disable=SC2016
        entry_command=("$BASH" --noprofile --norc -c '
            readonly -a sbx_shell_args=("$@")
            if [[ ! -f "$PWD/flake.nix" ]]; then
                echo "[err] flake.nix is not visible in the sandbox; register the project with madd" >&2
                exit 1
            fi
            source /run/nyx-dev-environment || exit $?
            exec "$SHELL" "${sbx_shell_args[@]}"
        ' "$prog_name nix-develop" "${shell_args[@]}")
        # END CLANKER: in-sandbox devshell startup stub
    fi
    # END CLANKER: shell or devshell entry command

    # Start bwrap
    if ! printf '%q ' exec bwrap "${args_for_bwrap[@]}" -- "${entry_command[@]}" > "$context_path/enter"; then
        printErr "failed to create enter script"
        exit 1
    fi

    # shellcheck disable=SC1091
    source "$context_path/enter"
}

# Dispatch with the original arguments, including the mode name.
case "${1:-enter}" in
    init) modeOf_init "$@" ;;
    enter|--|nix-develop|nd) modeOf_enter "$@" ;;
    madd) modeOf_madd "$@" ;;
    # Clanker implemented: mcover dispatch
    mcover) modeOf_mcover "$@" ;;
    gc) modeOf_gc "$@" ;;
    *) printErr "unknown command: $1. see \`$prog_name help\`."; exit 1 ;;
esac
