#!/usr/bin/env bash

# todo:
# * decide if user is a boundry since we just assume the one who created the context is the only user
# * safely mount nix socket

set -o pipefail

ctxlink_marker_name=".nyx-sbx"

usage() {
    echo \
"--------------------------------------------------------------------------------
sbx-shell [...args] <mode> [...mode args]
--------------------------------------------------------------------------------
<mode>:
    enter [id,?] (default)
        enter a sandbox. id is required when no ctxlink exists.
        use '?' (quoted) to generate an id from the working-directory path.
        omit id to reuse an existing ctxlink, or provide its matching id.
    madd [id,?] <r,rw,o> [dir]
        adds a [path] to be mounted when entering the sandbox as either a
        <r> read only, <rw> readwrite, or to use an <o> overlay. sandbox
        id must be provided and '?' is available to auto generate a
        deterministic id.
    nix-develop [devshell shard]
        helper mode that similarly behaves to the devshell sandboxing mechanism
        scripts. uses the \$PWD's folder name as <id>, adds \$PWD as a <rw>
        mount, enters a devshell shard while enforcing host \$SHELL and post
        executing any available \`.devshellshook.sh\` and \`.devshellspkgs.ls\`
        ! todo !
    gc
        garbage collect stale backlinks and unreferenced contexts. preserves
        contexts with missing backlink directories or inspection errors.
        returns nonzero if cleanup is
        incomplete.

        the ctxlink (\$PWD/$ctxlink_marker_name) is the authoritative reference
        to a context. backlinks (context/refs/<directory-id>) point to working
        directories so gc can discover their ctxlinks. enter
        repairs a missing backlink when the ctxlink still points
        to that context.
    help
        print this." >&2
}
[[ "${1:-}" == "help" ]] && { usage; exit 0; };

printErr() {
    printf '\033[37m[\033[91merr\033[37m]\033[0m %s\n' "$1" >&2
}

printWarn() {
    printf '\033[37m[\033[93mwarn\033[37m]\033[0m %s\n' "$1" >&2
}

printLog() {
    printf '\033[37m[log]\033[0m %s\n' "$1" >&2
}

mkHash() {
    printf '%s\n' "$1" | md5sum | cut -d' ' -f1
}

mkDirectoryId() {
    mkHash "$PWD"
}

# Check traversal before treating a failed existence check as a missing path.
# Paths passed here must be absolute and normalized.
canInspectPath() {
    local _path="$1" _parent
    _parent="${_path%/*}"
    [[ -z "$_parent" ]] && _parent=/
    if [[ "$_parent" != / ]]; then
        canInspectPath "$_parent" || return 1
    fi
    if [[ -d "$_parent" ]]; then
        [[ -x "$_parent" ]]
    else
        [[ ! -e "$_parent" && ! -L "$_parent" ]]
    fi
}

# Errors that have already been reported and just need the signal to be processed.
# Use for collecting errors.
has_reported_err=0;
assertHasReportedErr() {
    if [[ $has_reported_err == 1 ]]; then
        exit 1
    fi
}

# Assert programs
for _prog in realpath mkdir rm bwrap which md5sum cut ln nologin id; do
    if ! command -v "$_prog" &> /dev/null; then
        has_reported_err=1
        printErr "missing required program '$_prog' is not available."
    fi
done
unset _prog

# Assert envs
for _name in HOME SHELL PWD USER PATH; do
    if [[ ! -v "$_name" ]]; then
        has_reported_err=1
        printErr "env '$_name' is not set"
        continue
    fi

    _value="${!_name}"
    if [[ -z "$_value" ]]; then
        has_reported_err=1
        printErr "env '$_name' is set but empty"
        continue
    fi
done
unset _name _value

assertHasReportedErr

# Initialize - Context store
[[ -z "${NYX_SBX_SHELL_DIR:-}" ]] && printWarn "NYX_SBX_SHELL_DIR is not set. Defaulting to \$HOME/.nyx/sbx-shell"
NYX_SBX_SHELL_DIR="${NYX_SBX_SHELL_DIR:-"$HOME/.nyx/sbx-shell"}"
if ! mkdir -p -- "$NYX_SBX_SHELL_DIR"; then
    printErr "couldn't create directory: $NYX_SBX_SHELL_DIR"
    exit 1
fi
if ! NYX_SBX_SHELL_DIR="$(realpath -e -- "$NYX_SBX_SHELL_DIR")"; then
    printErr "couldn't resolve sandbox store directory"
    exit 1
fi
if [[ "$NYX_SBX_SHELL_DIR" == / ]]; then
    printErr "the sandbox store must not be the filesystem root"
    exit 1
fi

# gc mode
[[ "${1:-}" == "gc" ]] && {
    shopt -s nullglob dotglob
    _gc_status=0
    if [[ ! -r "$NYX_SBX_SHELL_DIR" || ! -x "$NYX_SBX_SHELL_DIR" ]]; then
        printErr "cannot inspect sandbox store: $NYX_SBX_SHELL_DIR"
        exit 1
    fi
    for _context_path in "$NYX_SBX_SHELL_DIR"/*; do
        if [[ -L "$_context_path" || ! -d "$_context_path" || ! -x "$_context_path" ]]; then
            printWarn "not an inspectable context directory: $_context_path; preserving"
            _gc_status=1
            continue
        fi

        # Keep the on-disk name refs for compatibility with existing contexts.
        _backlinks_dir="$_context_path/refs"
        if [[ -L "$_backlinks_dir" || ! -d "$_backlinks_dir" || ! -r "$_backlinks_dir" || ! -x "$_backlinks_dir" ]]; then
            printWarn "$_context_path has no inspectable, non-symlink backlink directory; preserving (remove incomplete contexts manually)"
            _gc_status=1
            continue
        fi

        _live_ctxlink_count=0
        _has_uncertain_backlinks=0
        for _backlink_path in "$_backlinks_dir"/*; do
            [[ ! -L "$_backlink_path" ]] && {
                if ! rm -- "$_backlink_path"; then
                    printErr "failed to remove $_backlink_path. please remove it as it is not a symlink. skipping."
                    _has_uncertain_backlinks=1
                    _gc_status=1
                    continue;
                fi
                printWarn "non-symlink file inside backlink directory was found and removed: $_backlink_path"
                continue;
            };

            if ! _directory_path="$(realpath -m -- "$_backlink_path")" || ! canInspectPath "$_directory_path"; then
                printErr "cannot inspect backlink '$_backlink_path'; preserving context"
                _has_uncertain_backlinks=1
                _gc_status=1
                continue
            fi

            if [[ ! -e "$_directory_path" && ! -L "$_directory_path" ]]; then
                printLog "stale backlink (missing working directory): $_backlink_path -> $_directory_path"
                if ! rm -- "$_backlink_path"; then
                    printErr "couldn't remove stale backlink: $_backlink_path"
                    _has_uncertain_backlinks=1
                    _gc_status=1
                fi
                continue
            fi

            if ! _directory_path="$(realpath -e -- "$_backlink_path")" || [[ ! -d "$_directory_path" || ! -x "$_directory_path" ]]; then
                printErr "backlink '$_backlink_path' does not point to an inspectable working directory; preserving context"
                _has_uncertain_backlinks=1
                _gc_status=1
                continue
            fi

            _ctxlink_path="$_directory_path/$ctxlink_marker_name"
            if [[ ! -e "$_ctxlink_path" && ! -L "$_ctxlink_path" ]]; then
                printLog "stale backlink (missing ctxlink): $_backlink_path -> $_directory_path"
                if ! rm -- "$_backlink_path"; then
                    printErr "couldn't remove stale backlink '$_backlink_path'. please remove it yourself or try again... skipping..."
                    _has_uncertain_backlinks=1
                    _gc_status=1
                fi
                continue
            fi

            if [[ ! -L "$_ctxlink_path" ]]; then
                printErr "ctxlink '$_ctxlink_path' is not a symlink; preserving context"
                _has_uncertain_backlinks=1
                _gc_status=1
                continue
            fi

            if ! _linked_context_path="$(realpath -m -- "$_ctxlink_path")" || ! canInspectPath "$_linked_context_path" || [[ -L "$_linked_context_path" ]]; then
                printErr "couldn't inspect ctxlink '$_ctxlink_path'; preserving context"
                _has_uncertain_backlinks=1
                _gc_status=1
                continue
            fi

            if [[ "$_linked_context_path" != "$_context_path" ]]; then
                printLog "stale backlink (ctxlink points to another context): $_backlink_path -> $_directory_path ~> $_linked_context_path"
                if ! rm -- "$_backlink_path"; then
                    printErr "couldn't remove stale backlink '$_backlink_path'. please remove it yourself or try again... skipping..."
                    _has_uncertain_backlinks=1
                    _gc_status=1
                fi
                continue
            fi

            printLog "live backlink: $_backlink_path"
            ((_live_ctxlink_count += 1))
        done

        printLog "$_context_path has $_live_ctxlink_count live ctxlink(s)"
        if (( _has_uncertain_backlinks != 0 )); then
            printWarn "preserving $_context_path because its live ctxlink count is unreliable"
            continue
        fi
        if (( _live_ctxlink_count == 0 )); then
            if ! rm -rf -- "$_context_path"; then
                printErr "failed to remove unreferenced context: $_context_path"
                _gc_status=1
                continue
            fi
        fi
    done 
    exit "$_gc_status"
};

# madd mode
[[ "${1:-}" == "madd" ]] && {
    [[ -z "${2:-}" ]] && { printErr "no id provided"; exit 1; }

    if ! PWD="$(pwd -P)"; then
        printErr "couldn't resolve working directory"
        exit 1
    fi
    context_id="$2"
    if [[ "$context_id" == '?' ]]; then
        if ! context_id="$(mkDirectoryId)"; then
            printErr "can't resolve working-directory id"
            exit 1
        fi
        printLog "using generated context id: $context_id"
    fi
    if [[ -z "$context_id" || "$context_id" == . || "$context_id" == .. || "$context_id" == */* ]]; then
        printErr "context id must be a single directory name other than '.' or '..'"
        exit 1
    fi
    _mount_mode_raw="${3:-}"
    case "$_mount_mode_raw" in
        r|ro) _mount_mode="ro" ;;
        rw) _mount_mode="rw" ;;
        o) _mount_mode="o" ;;
        *) printErr "invalid mount mode provided; expected one of: r, rw, o"; exit 1 ;;
    esac

    _mount_path="${4:-$PWD}"
    if ! _mount_path="$(realpath -e -- "$_mount_path")"; then
        printErr "invalid path provided: $_mount_path"
        exit 1
    fi
    if [[ ! -d "$_mount_path" ]]; then
        printErr "mount path is not a directory: $_mount_path"
        exit 1
    fi

    context_path="$NYX_SBX_SHELL_DIR/$context_id"
    if [[ -L "$context_path" || ( -e "$context_path" && ! -d "$context_path" ) ]]; then
        printErr "resolved context located at '$context_path' exists but is not a non-symlink directory"
        exit 1
    fi

    if ! mkdir -p "$context_path"; then
        printErr "failed to create context directory at '$context_path'"
        exit 1
    fi

    _ctx_mount_final_store_path="$context_path/mount/$_mount_mode"
    if ! mkdir -p "$_ctx_mount_final_store_path"; then
        printErr "failed to create mount context store path: $_ctx_mount_final_store_path"
        exit 1
    fi

    if ! _mount_path_id="$(mkHash "$_mount_path")"; then
        printErr "couldn't create id for mount path $_mount_path"
        exit 1
    fi

    if ! ln -sfnT "$_mount_path" "$_ctx_mount_final_store_path/$_mount_path_id"; then
        printErr "failed to register mount path '$_mount_path' for sandbox context '$context_id'"
        exit 1
    fi

    printLog "registered $_mount_mode mount '$_mount_path' in context '$context_id'"
    exit 0
};

# enter mode
[[ "${1:-enter}" != "enter" ]] && {
    printErr "unknown command: ${1:-}"
    exit 1
};

if ! PWD="$(pwd -P)"; then
    printErr "couldn't resolve working directory"
    exit 1
fi
context_id=
if (( $# >= 2 )); then
    context_id="$2"
    if [[ "$context_id" == '?' ]]; then
        if ! context_id="$(mkDirectoryId)"; then
            printErr "can't resolve working-directory id"
            exit 1
        fi
        printLog "using generated context id: $context_id"
    fi
    if [[ -z "$context_id" || "$context_id" == . || "$context_id" == .. || "$context_id" == */* ]]; then
        printErr "context id must be a single directory name other than '.' or '..'"
        exit 1
    fi
fi

# Initialize - Ctxlink and context
context_path=
_ctxlink_path="$PWD/$ctxlink_marker_name"
if [[ -L "$_ctxlink_path" ]]; then # Resolve the existing ctxlink.
    if ! context_path="$(realpath "$_ctxlink_path")"; then
        printErr "failed to resolve context from ctxlink"
        exit 1
    fi

    # if id was intentionally provided check if its correct
    if (( $# >= 2 )); then
        if [[ "$NYX_SBX_SHELL_DIR/$context_id" != "$context_path" ]]; then
            printErr "provided context id '$context_id' does not match ctxlink target '$context_path'"
            exit 1
        fi
    fi
elif [[ -e "$_ctxlink_path" ]]; then # The ctxlink must be a symlink.
    printErr "ctxlink exists at '$_ctxlink_path' but is not a symlink. in the off chance this is intentional... do something about it."
    exit 1
else
    # Register this working directory with an existing or new context.
    if [[ -z "$context_id" ]]; then
        printErr "context id is required when no ctxlink exists. use \`enter ?\` to auto generate one."
        exit 1
    fi
    context_path="$NYX_SBX_SHELL_DIR/$context_id"

    if [[ -L "$context_path" || ( -e "$context_path" && ! -d "$context_path" ) ]]; then
        printErr "resolved context located at '$context_path' exists but is not a non-symlink directory"
        exit 1
    fi

    if ! mkdir -p "$context_path"; then
        printErr "failed to create context directory at '$context_path'"
        exit 1
    fi

    if ! ln -sfnT "$context_path" "$_ctxlink_path"; then
        printErr "failed to create ctxlink at '$_ctxlink_path'"
        exit 1
    fi
fi

[[ ! -d "$context_path" ]] && {
    printErr "invalid context '$context_path' resolved from ctxlink '$_ctxlink_path'. possibly stale, please remove the context link."
    exit 1
};

[[ "${context_path%/*}" != "$NYX_SBX_SHELL_DIR" ]] && {
    printErr "resolved context ($context_path) isnt located inside NYX_SBX_SHELL_DIR ($NYX_SBX_SHELL_DIR)"
    exit 1
};
unset _ctxlink_path
context_id="${context_path##*/}"

# Initialize - Context backlink to the working directory
# Keep the on-disk name refs for compatibility with existing contexts.
_backlinks_dir="$context_path/refs"
if [[ -L "$_backlinks_dir" || ( -e "$_backlinks_dir" && ! -d "$_backlinks_dir" ) ]]; then
    printErr "backlink directory must be a non-symlink directory: $_backlinks_dir"
    exit 1
fi
if ! _directory_id="$(mkDirectoryId)"; then
    printErr "can't resolve working-directory id"
    exit 1
fi
_backlink_path="$_backlinks_dir/$_directory_id"
if [[ ! -L "$_backlink_path" ]]; then
    if ! mkdir -p "$_backlinks_dir"; then
        printErr "failed to create backlink directory for context"
        exit 1
    fi
    if ! ln -sfnT "$PWD" "$_backlink_path"; then
        printErr "failed to create a backlink for the context"
        exit 1
    fi
    printWarn "context had no backlink to the working directory. added at $_backlink_path"
else
    # Ensure the existing backlink points to the current working directory.
    if ! _directory_path="$(realpath "$_backlink_path")"; then
        printErr "failed to resolve backlink for context"
        exit 1
    fi
    [[ "$_directory_path" != "$PWD" ]] && {
        printErr "the context backlink does not point to the current working directory"
        exit 1;
    };
    unset _directory_path
fi
unset _backlink_path _directory_id _backlinks_dir

# Initialize - Group and Users
passwd_at="$context_path/passwd"
if [[ ! -f "$passwd_at" ]]; then
    printWarn "sandbox context does not have a passwd file. generating."
    if ! _bin_nologin="$(which nologin)"; then
        printErr "couldnt resolve nologin binary"
        exit 1
    fi

    if ! _id_un="$(id -un)"; then
        printErr "failed to resolve user name"
        exit 1
    fi

    if ! _id_u="$(id -u)"; then
        printErr "failed to resolve user id"
        exit 1
    fi

    if ! _id_g="$(id -g)"; then
        printErr "failed to resolve user group"
        exit 1
    fi

    if ! printf "root:x:0:0:System administrator:/root:%s\n%s:x:%s:%s::%s:%s" "$_bin_nologin" "$_id_un" "$_id_u" "$_id_g" "$HOME" "$_bin_nologin" > "$passwd_at"; then
        printErr "failed to create passwd file"
        exit 1
    fi
    unset _id_g _id_u _id_un _bin_nologin
fi

group_at="$context_path/group"
if [[ ! -f "$group_at" ]]; then
    printWarn "sandbox context does not have a group file. generating."

    if ! _id_gn="$(id -gn)"; then
        printErr "failed to resolve user group name"
        exit 1
    fi

    if ! _id_g="$(id -g)"; then
        printErr "failed to resolve user group"
        exit 1
    fi

    if ! printf "root:x:0:\n%s:x:%s:" "$_id_gn" "$_id_g" > "$group_at"; then
        printErr "failed to create group file"
        exit 1
    fi
    unset _id_g _id_gn
fi

ffs_root="$context_path/fs-root" # fake filesystem root -- note to self: i didnt create the root dir separately since we can just create the entire required path with the code below
if [[ -z "${HOME:-}" ]] || ! mkdir -p -- "$ffs_root/$HOME"; then
    printErr "couldn't create fake root and home directory for context"
fi

# Initialize bwrap
args_for_bwrap=(                      \
    --unshare-all                     \
    --clearenv                        \
    --die-with-parent                 \
    --chdir "$PWD"                    \
    --setenv NYX_SBX_ID "$context_id" \
);

# Setup root and fs
args_for_bwrap+=(                                                           \
    --bind "$ffs_root" "/"                                                  \
    --ro-bind "/nix" "/nix"                                                 \
    --dev /dev                                                              \
    --proc /proc                                                            \
    --tmpfs /tmp                                                            \
    --ro-bind "$group_at" "/etc/group"                                      \
    --ro-bind "$passwd_at" "/etc/passwd"                                    \
    --ro-bind "/run/current-system/sw" "/run/current-system/sw"             \
    --ro-bind "/etc/profiles/per-user/$USER" "/etc/profiles/per-user/$USER" \
);

# Setup env
args_for_bwrap+=( \
    --setenv PATH "$PATH"
    --setenv USER "$USER"
    --setenv HOME "$HOME"
    --setenv SHELL "$SHELL"
);

args_for_bwrap+=(--ro-bind "$PWD/$ctxlink_marker_name" "$PWD/$ctxlink_marker_name"); # ensure that the ctx link is not modifiable todo: only do this if mounted

# Bind mount registered paths and verify that path doesnt mount context store

# Start bwrap
if ! printf '%s' "exec bwrap ${args_for_bwrap[*]} -- $SHELL" > "$context_path/enter.sh"; then
    printErr "failed to create enter script"
    exit 1
fi

# shellcheck disable=SC1091
source "$context_path/enter.sh"
