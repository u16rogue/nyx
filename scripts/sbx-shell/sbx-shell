#!/usr/bin/env bash

set -o pipefail

usage() {
    echo \
"--------------------------------------------------------------------------------
sbx-shell [...args] <mode> [...mode args]
--------------------------------------------------------------------------------
[mode]:
    enter [id] (default)
        enter a sandbox. id is required when no ctxlink exists.
        use '?' (quoted) to generate an id from the working-directory path.
        omit id to reuse an existing ctxlink, or provide its matching id.
    gc
        garbage collect stale backlinks and unreferenced contexts. preserves
        contexts with missing backlink directories or inspection errors.
        returns nonzero if cleanup is
        incomplete.

        the ctxlink (\$PWD/.nyx-sbx) is the authoritative reference
        to a context. backlinks (context/refs/<directory-id>) point to working
        directories so gc can discover their ctxlinks. enter
        repairs a missing backlink when the ctxlink still points
        to that context.
    help
        print this." >&2
}
[[ "${1:-}" == "help" ]] && { usage; exit 0; };

printErr() {
    printf '\033[37m[\033[91merr\033[37m]\033[0m %s\n' "$1" >&2
}

printWarn() {
    printf '\033[37m[\033[93mwarn\033[37m]\033[0m %s\n' "$1" >&2
}

printLog() {
    printf '\033[37m[log]\033[0m %s\n' "$1" >&2
}

mkDirectoryId() {
    printf '%s\n' "$PWD" | md5sum | cut -d' ' -f1
}

# Check traversal before treating a failed existence check as a missing path.
# Paths passed here must be absolute and normalized.
canInspectPath() {
    local path="$1" parent
    parent="${path%/*}"
    [[ -z "$parent" ]] && parent=/
    if [[ "$parent" != / ]]; then
        canInspectPath "$parent" || return 1
    fi
    if [[ -d "$parent" ]]; then
        [[ -x "$parent" ]]
    else
        [[ ! -e "$parent" && ! -L "$parent" ]]
    fi
}

# Errors that have already been reported and just need the signal to be processed.
# Use for collecting errors.
has_reported_err=0;
assertHasReportedErr() {
    if [[ $has_reported_err == 1 ]]; then
        exit 1
    fi
}

# Assert programs
for prog in realpath mkdir rm bwrap which md5sum cut ln nologin id; do
    if ! command -v "$prog" &> /dev/null; then
        has_reported_err=1
        printErr "missing required program '$prog' is not available."
    fi
done
unset prog

# Assert envs
for name in HOME SHELL PWD; do
    if [[ ! -v "$name" ]]; then
        has_reported_err=1
        printErr "env '$name' is not set"
        continue
    fi

    value="${!name}"
    if [[ -z "$value" ]]; then
        has_reported_err=1
        printErr "env '$name' is set but empty"
        continue
    fi
done
unset name value

assertHasReportedErr

# Initialize - Context store
[[ -z "${NYX_SBX_SHELL_DIR:-}" ]] && printWarn "NYX_SBX_SHELL_DIR is not set. Defaulting to \$HOME/.nyx/sbx-shell"
NYX_SBX_SHELL_DIR="${NYX_SBX_SHELL_DIR:-"$HOME/.nyx/sbx-shell"}"
if ! mkdir -p -- "$NYX_SBX_SHELL_DIR"; then
    printErr "couldn't create directory: $NYX_SBX_SHELL_DIR"
    exit 1
fi
if ! NYX_SBX_SHELL_DIR="$(realpath -e -- "$NYX_SBX_SHELL_DIR")"; then
    printErr "couldn't resolve sandbox store directory"
    exit 1
fi
if [[ "$NYX_SBX_SHELL_DIR" == / ]]; then
    printErr "the sandbox store must not be the filesystem root"
    exit 1
fi

# gc mode
[[ "${1:-}" == "gc" ]] && {
    shopt -s nullglob dotglob
    gc_status=0
    if [[ ! -r "$NYX_SBX_SHELL_DIR" || ! -x "$NYX_SBX_SHELL_DIR" ]]; then
        printErr "cannot inspect sandbox store: $NYX_SBX_SHELL_DIR"
        exit 1
    fi
    for context_path in "$NYX_SBX_SHELL_DIR"/*; do
        if [[ -L "$context_path" || ! -d "$context_path" || ! -x "$context_path" ]]; then
            printWarn "not an inspectable context directory: $context_path; preserving"
            gc_status=1
            continue
        fi

        # Keep the on-disk name refs for compatibility with existing contexts.
        backlinks_dir="$context_path/refs"
        if [[ -L "$backlinks_dir" || ! -d "$backlinks_dir" || ! -r "$backlinks_dir" || ! -x "$backlinks_dir" ]]; then
            printWarn "$context_path has no inspectable, non-symlink backlink directory; preserving (remove incomplete contexts manually)"
            gc_status=1
            continue
        fi

        live_ctxlink_count=0
        has_uncertain_backlinks=0
        for backlink_path in "$backlinks_dir"/*; do
            [[ ! -L "$backlink_path" ]] && {
                if ! rm -- "$backlink_path"; then
                    printErr "failed to remove $backlink_path. please remove it as it is not a symlink. skipping."
                    has_uncertain_backlinks=1
                    gc_status=1
                    continue;
                fi
                printWarn "non-symlink file inside backlink directory was found and removed: $backlink_path"
                continue;
            };

            if ! directory_path="$(realpath -m -- "$backlink_path")" || ! canInspectPath "$directory_path"; then
                printErr "cannot inspect backlink '$backlink_path'; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            if [[ ! -e "$directory_path" && ! -L "$directory_path" ]]; then
                printLog "stale backlink (missing working directory): $backlink_path -> $directory_path"
                if ! rm -- "$backlink_path"; then
                    printErr "couldn't remove stale backlink: $backlink_path"
                    has_uncertain_backlinks=1
                    gc_status=1
                fi
                continue
            fi

            if ! directory_path="$(realpath -e -- "$backlink_path")" || [[ ! -d "$directory_path" || ! -x "$directory_path" ]]; then
                printErr "backlink '$backlink_path' does not point to an inspectable working directory; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            ctxlink_path="$directory_path/.nyx-sbx"
            if [[ ! -e "$ctxlink_path" && ! -L "$ctxlink_path" ]]; then
                printLog "stale backlink (missing ctxlink): $backlink_path -> $directory_path"
                if ! rm -- "$backlink_path"; then
                    printErr "couldn't remove stale backlink '$backlink_path'. please remove it yourself or try again... skipping..."
                    has_uncertain_backlinks=1
                    gc_status=1
                fi
                continue
            fi

            if [[ ! -L "$ctxlink_path" ]]; then
                printErr "ctxlink '$ctxlink_path' is not a symlink; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            if ! linked_context_path="$(realpath -m -- "$ctxlink_path")" || ! canInspectPath "$linked_context_path" || [[ -L "$linked_context_path" ]]; then
                printErr "couldn't inspect ctxlink '$ctxlink_path'; preserving context"
                has_uncertain_backlinks=1
                gc_status=1
                continue
            fi

            if [[ "$linked_context_path" != "$context_path" ]]; then
                printLog "stale backlink (ctxlink points to another context): $backlink_path -> $directory_path ~> $linked_context_path"
                if ! rm -- "$backlink_path"; then
                    printErr "couldn't remove stale backlink '$backlink_path'. please remove it yourself or try again... skipping..."
                    has_uncertain_backlinks=1
                    gc_status=1
                fi
                continue
            fi

            printLog "live backlink: $backlink_path"
            ((live_ctxlink_count += 1))
        done

        printLog "$context_path has $live_ctxlink_count live ctxlink(s)"
        if (( has_uncertain_backlinks != 0 )); then
            printWarn "preserving $context_path because its live ctxlink count is unreliable"
            continue
        fi
        if (( live_ctxlink_count == 0 )); then
            if ! rm -rf -- "$context_path"; then
                printErr "failed to remove unreferenced context: $context_path"
                gc_status=1
                continue
            fi
        fi
    done 
    exit "$gc_status"
};

# Enter mode
[[ "${1:-enter}" != "enter" ]] && {
    printErr "unknown command: ${1:-}"
    exit 1
};

# Initialize - Ctxlink and context
if ! PWD="$(pwd -P)"; then
    printErr "couldn't resolve working directory"
    exit 1
fi
context_path=
ctxlink_path="$PWD/.nyx-sbx"
if [[ -L "$ctxlink_path" ]]; then # Resolve the existing ctxlink.
    if ! context_path="$(realpath "$ctxlink_path")"; then
        printErr "failed to resolve context from ctxlink"
        exit 1
    fi

    # if id was intentionally provided check if its correct
    if (( $# >= 2 )); then
        context_id="$2"
        if [[ "$context_id" == '?' ]]; then
            if ! context_id="$(mkDirectoryId)"; then
                printErr "failed to generate a context id"
                exit 1
            fi
        fi
        if [[ -z "$context_id" || "$context_id" == . || "$context_id" == .. || "$context_id" == */* ]]; then
            printErr "context id must be a single directory name other than '.' or '..'"
            exit 1
        fi
        if [[ "$NYX_SBX_SHELL_DIR/$context_id" != "$context_path" ]]; then
            printErr "provided context id '$context_id' does not match ctxlink target '$context_path'"
            exit 1
        fi
        unset context_id
    fi
elif [[ -e "$ctxlink_path" ]]; then # The ctxlink must be a symlink.
    printErr "ctxlink exists at '$ctxlink_path' but is not a symlink. in the off chance this is intentional... do something about it."
    exit 1
else
    # Register this working directory with an existing or new context.
    if [[ -z "${2:-}" ]]; then
        printErr "context id is required when no ctxlink exists. use \`enter ?\` to auto generate one."
        exit 1
    fi
    context_id="$2"
    if [[ "$context_id" == '?' ]]; then
        if ! context_id="$(mkDirectoryId)"; then
            printErr "failed to generate a context id"
            exit 1
        fi
        printLog "using generated context id: $context_id"
    fi

    if [[ -z "$context_id" || "$context_id" == . || "$context_id" == .. || "$context_id" == */* ]]; then
        printErr "context id must be a single directory name other than '.' or '..'"
        exit 1
    fi

    context_path="$NYX_SBX_SHELL_DIR/$context_id"

    if [[ -L "$context_path" || ( -e "$context_path" && ! -d "$context_path" ) ]]; then
        printErr "resolved context located at '$context_path' exists but is not a non-symlink directory"
        exit 1
    fi

    if ! mkdir -p "$context_path"; then
        printErr "failed to create context directory at '$context_path'"
        exit 1
    fi

    if ! ln -sfnT "$context_path" "$ctxlink_path"; then
        printErr "failed to create ctxlink at '$ctxlink_path'"
        exit 1
    fi
    unset context_id
fi
unset ctxlink_path

[[ ! -d "$context_path" ]] && {
    printErr "invalid context '$context_path' resolved from ctxlink '$ctxlink_path'. possibly stale, please remove the context link."
    exit 1
};

[[ "${context_path%/*}" != "$NYX_SBX_SHELL_DIR" ]] && {
    printErr "resolved context ($context_path) isnt located inside NYX_SBX_SHELL_DIR ($NYX_SBX_SHELL_DIR)"
    exit 1
};

# Initialize - Context backlink to the working directory
# Keep the on-disk name refs for compatibility with existing contexts.
backlinks_dir="$context_path/refs"
if [[ -L "$backlinks_dir" || ( -e "$backlinks_dir" && ! -d "$backlinks_dir" ) ]]; then
    printErr "backlink directory must be a non-symlink directory: $backlinks_dir"
    exit 1
fi
if ! directory_id="$(mkDirectoryId)"; then
    printErr "can't resolve working-directory id"
    exit 1
fi
backlink_path="$backlinks_dir/$directory_id"
if [[ ! -L "$backlink_path" ]]; then
    if ! mkdir -p "$backlinks_dir"; then
        printErr "failed to create backlink directory for context"
        exit 1
    fi
    if ! ln -sfnT "$PWD" "$backlink_path"; then
        printErr "failed to create a backlink for the context"
        exit 1
    fi
    printWarn "context had no backlink to the working directory. added at $backlink_path"
else
    # Ensure the existing backlink points to the current working directory.
    if ! directory_path="$(realpath "$backlink_path")"; then
        printErr "failed to resolve backlink for context"
        exit 1
    fi
    [[ "$directory_path" != "$PWD" ]] && {
        printErr "the context backlink does not point to the current working directory"
        exit 1;
    };
    unset directory_path
fi
unset backlink_path directory_id backlinks_dir

# Initialize - Group and Users
passwd_at="$context_path/passwd"
if [[ ! -f "$passwd_at" ]]; then
    printWarn "sandbox context does not have a passwd file. generating."
    if ! bin_nologin="$(which nologin)"; then
        printErr "couldnt resolve nologin binary"
        exit 1
    fi

    if ! id_un="$(id -un)"; then
        printErr "failed to resolve user name"
        exit 1
    fi

    if ! id_u="$(id -u)"; then
        printErr "failed to resolve user id"
        exit 1
    fi

    if ! id_g="$(id -g)"; then
        printErr "failed to resolve user group"
        exit 1
    fi

    if ! printf "root:x:0:0:System administrator:/root:%s\n%s:x:%s:%s::%s:%s" "$bin_nologin" "$id_un" "$id_u" "$id_g" "$HOME" "$bin_nologin" > "$passwd_at"; then
        printErr "failed to create passwd file"
        exit 1
    fi
    unset id_g id_u id_un bin_nologin
fi
unset passwd_at

group_at="$context_path/group"
if [[ ! -f "$group_at" ]]; then
    printWarn "sandbox context does not have a group file. generating."

    if ! id_gn="$(id -gn)"; then
        printErr "failed to resolve user group name"
        exit 1
    fi

    if ! id_g="$(id -g)"; then
        printErr "failed to resolve user group"
        exit 1
    fi

    if ! printf "root:x:0:\n%s:x:%s:" "$id_gn" "$id_g" > "$group_at"; then
        printErr "failed to create group file"
        exit 1
    fi
    unset id_g id_gn
fi
unset group_at

# Initialize - Hostname
# Build - Env
