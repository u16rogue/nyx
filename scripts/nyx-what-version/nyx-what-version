#!/usr/bin/env bash

# The rev is resolved from `nyx-auto-upgrade`'s state and the latest release since the
# system itself doesn't embed it (that would change every host's outPath on every commit).

host="$(< /proc/sys/kernel/hostname)"
current="$(readlink -f /run/current-system)"
rev=""

if [[ -r /var/lib/nyx-auto-upgrade/attempted ]]; then
    read -r attempted_rev attempted_out < /var/lib/nyx-auto-upgrade/attempted || true
    if [[ "${attempted_out:-}" == "$current" ]]; then
        rev="$attempted_rev"
    fi
fi

latest_rev=""
if manifest="$(curl -fsSL --max-time 15 "https://github.com/u16rogue/nyx/releases/latest/download/hosts.json")"; then
    latest_out="$(jq -r --arg host "$host" '.hosts[$host].outPath // empty' <<< "$manifest")"
    latest_rev="$(jq -r --arg host "$host" '.hosts[$host].rev // empty' <<< "$manifest")"
    if [[ -z "$rev" && -n "$latest_out" && "$latest_out" == "$current" ]]; then
        rev="$latest_rev"
    fi
fi

echo "host:   $host"
echo "system: $current"
echo "rev:    ${rev:-unknown (not a released system)}"
if [[ -z "$latest_rev" ]]; then
    echo "latest: unavailable"
elif [[ "$rev" == "$latest_rev" ]]; then
    echo "latest: $latest_rev (up to date)"
else
    echo "latest: $latest_rev (not running it)"
fi
