#!/usr/bin/env bash

# THIS WAS WRITTEN BY A CLANKER

set -euo pipefail

# Updates flake.lock and keeps the template locks on the same nixpkgs, so the
# result passes `assert_templates`.
#
# Usage: update_lock [input...]    (no inputs: update all of them)
# Exits 0 when the locks changed, 10 when everything was already up to date.

PROJECT_DIR="$(realpath "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/..")"
cd "$PROJECT_DIR"

locks=(flake.lock templates/*/flake.lock)
before="$(sha256sum "${locks[@]}")"

nix flake update "$@"
bash _nyx/sync_template_nixpkgs

if [[ "$(sha256sum "${locks[@]}")" == "$before" ]]; then
    echo "[info] locks already up to date"
    exit 10
fi
echo "[info] locks updated"
