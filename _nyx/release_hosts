#!/usr/bin/env bash

# THIS WAS WRITTEN BY A CLANKER

set -euo pipefail

# Publishes `hosts.json` as a commit on a branch of a git repository whenever any
# host's evaluated system changes. Hosts importing the `auto-upgrade` nixos module
# poll it and only rebuild when their entry differs from /run/current-system.
#
# The release repository is separate from this one so nothing mirroring this
# repository (eg. a Forgejo push mirror, which prunes refs) can remove releases.
#
# A host's `outPath` changes exactly when something that ends up in its system
# changes (host, module, user, override, flake.lock), so no path filters are
# needed to decide relevance.
#
# hosts.json:
#   { "version": 1, "rev": "<commit>", "hosts": { "<host>": { "outPath": "...", "rev": "<commit that last changed it>" } } }
#
# Usage: NYX_RELEASE_REPO=<git url> [NYX_RELEASE_BRANCH=main] release_hosts <commit sha>    (needs `git`, `nix`, `jq`)
#        NYX_DRY_RUN=1 release_hosts <commit sha>    to only print the result (compared against NYX_RELEASE_REPO when set)

PROJECT_DIR="$(realpath "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/..")"
cd "$PROJECT_DIR"

rev="${1:?missing commit sha}"
[[ "$rev" =~ ^[0-9a-f]{40}$ ]] || { echo "[err] invalid commit sha '$rev'" >&2; exit 1; }

dry_run="${NYX_DRY_RUN:-0}"
release_repo="${NYX_RELEASE_REPO:-}"
release_branch="${NYX_RELEASE_BRANCH:-main}"
[[ "$dry_run" == 1 || -n "$release_repo" ]] || { echo "[err] NYX_RELEASE_REPO is not set" >&2; exit 1; }
export GIT_TERMINAL_PROMPT=0

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT
release="$work/release"

echo "[info] evaluating host systems at $rev"
nix eval --json .#nixosConfigurations \
    --apply 'builtins.mapAttrs (_: c: c.config.system.build.toplevel.outPath)' \
    > "$work/current.json"

echo '{ "hosts": {} }' > "$work/empty.json"
previous="$work/empty.json"
if [[ -n "$release_repo" ]]; then
    status=0
    git ls-remote --exit-code --heads "$release_repo" "$release_branch" > /dev/null || status=$?
    if [[ "$status" -eq 0 ]]; then
        git clone --quiet --depth=1 --branch "$release_branch" "$release_repo" "$release"
        if [[ -f "$release/hosts.json" ]]; then
            previous="$release/hosts.json"
        else
            echo "[info] $release_branch has no hosts.json yet, treating every host as changed"
        fi
    elif [[ "$status" -eq 2 ]]; then
        echo "[info] $release_branch does not exist yet, treating every host as changed"
        git init --quiet --initial-branch "$release_branch" "$release"
        git -C "$release" remote add origin "$release_repo"
    else
        echo "[err] could not reach $release_repo" >&2
        exit 1
    fi
fi

# Unchanged hosts keep the rev that last changed them.
jq -n --arg rev "$rev" --slurpfile current "$work/current.json" --slurpfile previous "$previous" '
    ($previous[0].hosts // {}) as $prev
    | {
        version: 1,
        rev: $rev,
        hosts: ($current[0] | with_entries(
            .value as $out
            | .value = (if $prev[.key].outPath == $out then $prev[.key] else { outPath: $out, rev: $rev } end)
        ))
    }
' > "$work/hosts.json"

mapfile -t changed < <(jq -rn --slurpfile current "$work/current.json" --slurpfile previous "$previous" \
    '($previous[0].hosts // {}) as $prev | $current[0] | to_entries[] | select($prev[.key].outPath != .value) | .key')
mapfile -t removed < <(jq -rn --slurpfile current "$work/current.json" --slurpfile previous "$previous" \
    '($previous[0].hosts // {} | keys) - ($current[0] | keys) | .[]')

cat "$work/hosts.json"

if [[ "${#changed[@]}" -eq 0 && "${#removed[@]}" -eq 0 ]]; then
    echo "[info] no host system changed, nothing to release"
    exit 0
fi

notes="Changed hosts:"
for host in "${changed[@]}"; do notes+=$'\n'"* \`$host\`"; done
if [[ "${#removed[@]}" -gt 0 ]]; then
    notes+=$'\n\n'"Removed hosts:"
    for host in "${removed[@]}"; do notes+=$'\n'"* \`$host\`"; done
fi
echo "$notes"

if [[ "$dry_run" == 1 ]]; then
    echo "[info] dry run, not releasing"
    exit 0
fi

cp "$work/hosts.json" "$release/hosts.json"
git -C "$release" add hosts.json
git -C "$release" \
    -c user.name="${NYX_RELEASE_AUTHOR_NAME:-nyx release_hosts}" \
    -c user.email="${NYX_RELEASE_AUTHOR_EMAIL:-release_hosts@nyx.invalid}" \
    commit --quiet -m "hosts ${rev:0:7}" -m "$notes" -m "Source: $rev"
# Not forced: a concurrent release makes this fail instead of being overwritten.
git -C "$release" push --quiet origin "HEAD:refs/heads/$release_branch"
echo "[info] released ${rev:0:7} to $release_repo ($release_branch)"
