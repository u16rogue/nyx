if [[ -z "$flake_spec" && -z "$offline_bundle" && "$build_image" == false && -f /etc/nyxos-install/manifest.json ]]; then
    offline_bundle=/etc/nyxos-install
fi
if [[ -n "$offline_bundle" ]]; then
    [[ -z "$flake_spec" && "$build_image" == false ]] || die '--offline-bundle cannot be combined with --flake or --build-image'
else
    [[ "$flake_spec" == *#* ]] || die 'specify --flake FLAKE#HOST explicitly'
    flake=${flake_spec%#*} host=${flake_spec##*#}
    [[ -n "$flake" && "$host" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || die 'invalid flake or host name'
fi
if [[ "$build_image" == true ]]; then
    [[ -z "$key_input" && "$root" == /mnt && ${#install_args[@]} == 0 ]] || die '--build-image does not accept installation options or private keys'
else
    [[ "$out_link" == ./result && "$image_dry_run" == false ]] || die '--out-link and --dry-run require --build-image'
    ((EUID == 0)) || die 'run as root from the installer environment'
fi
self=$(realpath -- "${BASH_SOURCE[0]}")
here=$(dirname -- "$self")
ensure_dependencies
if [[ -z "$offline_bundle" ]]; then
    info "Snapshotting $flake and evaluating $host"
    source=$(nix flake archive --json --no-write-lock-file "${nix_args[@]}" "$flake" | jq -er .path)
    args="{ flake = builtins.getFlake $(jq -Rn --arg s "$source" '$s'); hostName = $(jq -Rn --arg s "$host" '$s'); }"
fi
