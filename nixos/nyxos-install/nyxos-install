    info "Building the prebuilt offline installer ISO for $host"
    if [[ "$image_dry_run" == true ]]; then nix_args+=(--dry-run); fi
    nix build --file "$here/image.nix" --arg flake "builtins.getFlake $(jq -Rn --arg s "$source" '$s')" \
        --argstr hostName "$host" iso --out-link "$out_link" "${nix_args[@]}"
    if [[ "$image_dry_run" == true ]]; then
        info 'Image build plan checked; no ISO was written'
    else
        info "ISO available under $out_link/iso/; boot it, prepare the disks, then run sudo nyxos-install"
    fi
    return
fi
root=$(realpath -e -- "$root")
[[ "$root" != / && -d "$root" ]] || die 'target root must be an existing directory other than /'
[[ "$root" != *[$'\n\t ']* ]] || die 'target root cannot contain whitespace'
mountpoint -q -- "$root" || die 'target root must already be a mountpoint'
[[ $(findmnt -nro FSTYPE -M "$root") == tmpfs ]] || die 'target root must be tmpfs'

# Refuse symlink traversal in paths written outside a chroot. Absolute symlinks
# in the installed system must never accidentally resolve into the live system.
