die() { printf 'nyxos-install: %s\n' "$*" >&2; exit 1; }
info() { printf 'nyxos-install: %s\n' "$*" >&2; }
usage() {
    cat <<'EOF'
nyxos-install --flake FLAKE#HOST [--root /mnt] [--host-key FILE]
              [--no-bootloader] [--no-channel-copy] [--show-trace] [-v|--verbose]
nyxos-install --build-image --flake FLAKE#HOST [--out-link ./result] [--dry-run]
nyxos-install [--offline-bundle DIR] [--root /mnt] [--host-key FILE]

Written by a clanker. Installs a registered Nyx host using nixos-install.
Run this script directly; missing dependencies trigger a pinned nix shell.
--build-image creates a bootable host-specific offline installer ISO (no root
needed). On that ISO, nyxos-install automatically uses its prebuilt bundle.
--dry-run checks the image build plan without downloading/building its closure.
First partition, format, unlock and mount the target root, /persist and /boot
(for example using disko). This command never formats disks.
Restores the encrypted Nyx host key interactively, or verifies --host-key FILE.
An existing matching persistent key is reused. Root authentication stays locked.
Only the options listed above are accepted; --system and alternate stores would
bypass the selected host's bootstrap checks and are deliberately unsupported.
EOF
}

ensure_dependencies() {
    local cmd missing=false
    for cmd in nix nixos-install nixos-enter jq rage ssh-keygen sha256sum realpath findmnt mount mountpoint stat install mktemp systemd-tmpfiles flock; do
        command -v "$cmd" >/dev/null || missing=true
    done
    [[ "$missing" == true ]] || return 0
    [[ -z "$offline_bundle" ]] || die 'offline image is missing required tools; refusing to fetch dependencies'
    [[ ${NYXOS_INSTALL_SHELL:-0} != 1 ]] || die 'dependencies are still missing after entering nix shell'
    command -v nix >/dev/null || die 'Nix is required to bootstrap the script dependencies'
    info "Entering nix shell with dependencies pinned by this checkout's flake.lock"
    # No shell interpolation of Nix strings: --file supplies the expression,
    # whose default pkgs argument uses the repository lock file directly.
    exec nix shell --impure --file "$here/dependencies.nix" \
        --command env NYXOS_INSTALL_SHELL=1 bash "$self" "${original_args[@]}"
}

load_offline_bundle() {
    [[ -f "$offline_bundle/manifest.json" && -L "$offline_bundle/system" ]] || die 'invalid offline bundle: expected manifest.json and system'
    cp -- "$offline_bundle/manifest.json" "$work/manifest.json"
    metadata=$work/manifest.json
    jq -e '.version == 1 and (.hostName | type == "string") and (.users | length > 0)' "$metadata" >/dev/null || die 'unsupported or incomplete offline manifest'
    host=$(jq -er .hostName "$metadata")
    system=$(jq -er .toplevel "$metadata")
    [[ "$system" == /nix/store/* && "$system" == "$(readlink -f -- "$offline_bundle/system")" && -x "$system/activate" ]] || die 'offline bundle system is missing or differs from its manifest'
    # Disable network substitution and remote builders for every child, including
    # nixos-install's nix-env call. The source is the ISO's registered local store.
    export NIX_CONFIG="${NIX_CONFIG:-}"$'\nsubstituters =\nbuilders =\nconnect-timeout = 1\n'
    install_args+=(--no-channel-copy --option substituters '' --option builders '')
    nix --offline --store auto --option substituters '' path-info --recursive "$system" > "$work/closure"
    info "Using the prebuilt offline system for $host"
}

copy_offline_system() {
    nix --offline --option substituters '' --option builders '' copy --from auto --to "$root" --no-check-sigs "$system"
}
verify_key() {
    local key=$1 digest public expected type body rest
    digest=$(sha256sum -- "$key"); digest=${digest%% *}
    [[ "$digest" == "$(jq -r .keys.prv.sha256 "$metadata")" ]] || die 'private key SHA-256 differs from Nyx registration'
    public=$(ssh-keygen -y -P '' -f "$key") || die 'host key must be an unencrypted OpenSSH private key'
    read -r type body rest <<< "$public"; public="$type $body"
    expected=$(jq -r .keys.pub "$metadata")
    read -r type body rest <<< "$expected"
    [[ "$type" == ssh-ed25519 && "$public" == "$type $body" ]] || die 'private key does not match the registered ED25519 public key'
}

safe_path() {
    local path=$1 current=$root part
    local -a parts
    [[ "$path" == /* && "$path" != *'/../'* && "$path" != */.. ]] || die "unsafe target path: $path"
    IFS=/ read -r -a parts <<< "$path"
    for part in "${parts[@]}"; do
        [[ -n "$part" ]] || continue
        current+=/$part
        [[ ! -L "$current" ]] || die "unexpected symlink: $current"
    done
}

bind_state() {
    local from=$1 to=$2
    if mountpoint -q -- "$to"; then
        [[ $(stat -c '%d:%i' -- "$from") == "$(stat -c '%d:%i' -- "$to")" ]] || die "$to is mounted from the wrong source"
    else
        if [[ -d "$to" ]]; then
            [[ -z $(ls -A -- "$to") ]] || die "$to is nonempty; refusing to hide installation data"
        else
            [[ ! -s "$to" ]] || die "$to contains unpreserved state"
        fi
        mount --bind "$from" "$to"
    fi
}

main() {
root=/mnt flake_spec='' key_input='' work='' offline_bundle='' build_image=false out_link=./result image_dry_run=false
original_args=("$@")
install_args=() nix_args=()
while (($#)); do
    case "$1" in
        --flake|--root|--host-key|--offline-bundle|--out-link)
