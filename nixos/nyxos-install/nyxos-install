    expected_type=$(jq -er --arg p "$path" '.filesystems[$p].fsType' "$metadata")
    [[ $(findmnt -nro FSTYPE -M "$root$path") == "$expected_type" ]] || die "$path filesystem type does not match configuration"
    actual_device=$(findmnt -nro SOURCE -M "$root$path")
