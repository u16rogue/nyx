chmod 0600 "$existing"
if [[ ! -e "$public_path" ]]; then jq -r .keys.pub "$metadata" > "$public_path"; fi
chown 0:0 "$public_path"
chmod 0644 "$public_path"
machine_id=$root/persist/etc/machine-id
if [[ ! -e "$machine_id" ]]; then
    tr -d '-' < /proc/sys/kernel/random/uuid > "$machine_id"
fi
[[ -f "$machine_id" && $(< "$machine_id") =~ ^[0-9a-f]{32}$ && $(< "$machine_id") != 00000000000000000000000000000000 ]] || die 'invalid persistent machine-id'
chmod 0444 "$machine_id"
chown 0:0 "$machine_id"

bind_state "$root/persist/nix" "$root/nix"
bind_state "$root/persist/var/lib/nixos" "$root/var/lib/nixos"
[[ -e "$root/etc/machine-id" ]] || touch "$root/etc/machine-id"
bind_state "$machine_id" "$root/etc/machine-id"
if [[ -n "$offline_bundle" ]]; then
    info 'Copying the prebuilt closure from the ISO to the persistent target store'
