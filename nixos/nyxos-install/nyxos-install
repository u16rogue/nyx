else
    info 'Building the asserted system closure in the persistent target store'
    nix build --store "$root" --extra-substituters 'auto?trusted=1' --no-write-lock-file "${nix_args[@]}" --out-link "$work/system" "$source#nixosConfigurations.\"$host\".config.system.build.toplevel"
