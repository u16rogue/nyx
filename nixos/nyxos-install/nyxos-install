            case "$1" in
                --flake) [[ -z "$flake_spec" ]] || die 'duplicate --flake'; flake_spec=$2 ;;
                --root) root=$2 ;;
                --host-key) key_input=$2 ;;
                --offline-bundle) offline_bundle=$2 ;;
                --out-link) out_link=$2 ;;
            esac
            shift 2 ;;
        --no-bootloader|--no-channel-copy) install_args+=("$1"); shift ;;
        --build-image) build_image=true; shift ;;
        --dry-run) image_dry_run=true; shift ;;
        --show-trace) nix_args+=("$1"); shift ;;
        -v|--verbose) nix_args+=(--verbose); shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $1 (see --help)" ;;
    esac
done
