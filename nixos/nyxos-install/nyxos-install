else
    nix eval --json "${nix_args[@]}" --file "$here/manifest.nix" --apply "make: make $args" > "$work/manifest.json"
    metadata=$work/manifest.json
fi
[[ "$(uname -m)-linux" == "$(jq -r .platform "$metadata")" ]] || die 'run from an installer matching the target platform'

check_mount() {
