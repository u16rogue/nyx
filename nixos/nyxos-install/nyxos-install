    unset password
    rm -- "$work/password"
done < <(jq -c '.users[]' "$metadata")

info 'Bootstrapping persistent identity and installation state'
install -d -m 0755 "$root/persist/nix" "$root/nix" "$root/persist/etc/ssh" "$root/etc/ssh" "$root/persist/var/lib/nixos" "$root/var/lib/nixos"
if [[ ! -e "$existing" ]]; then
    install -m 0600 "$work/key" "$existing"
fi
