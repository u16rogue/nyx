theme = Catppuccin Mocha
# Pin the pre-1.4.0 Catppuccin Mocha colors; ghostty 1.4.0's bundled theme update washed out the bright palette.
palette = 7=#a6adc8
palette = 9=#f37799
palette = 10=#89d88b
palette = 11=#ebd391
palette = 12=#74a8fc
palette = 13=#f2aede
palette = 14=#6bd7ca
palette = 15=#bac2de
selection-background = #585b70
selection-foreground = #cdd6f4
background-opacity = 0.9
font-size = 11
alpha-blending = linear
freetype-load-flags = no-hinting
font-codepoint-map = U+E000-U+E00A,U+EA60-U+EBEB,U+E0A0-U+E0C8,U+E0CA,U+E0CC-U+E0D7,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6B7,U+E700-U+E8EF,U+ED00-U+EFC1,U+F000-U+F2FF,U+F300-U+F381,U+F400-U+F533,U+F0001-U+F1AF0=ComicShannsMono Nerd Font
font-family = "ComicShannsMono Nerd Font Mono"
font-style = "Regular"
